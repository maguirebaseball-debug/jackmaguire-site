# Mailchimp footer signup form
# Get the form action URL from Mailchimp's embedded signup form code.
PUBLIC_MAILCHIMP_SUBSCRIBE_URL=https://YOUR_DC.list-manage.com/subscribe/post?u=YOUR_AUDIENCE_HASH&id=YOUR_FORM_ID
# In Mailchimp's form code, this is the numeric value of the hidden "tags" field.
PUBLIC_MAILCHIMP_FOOTER_TAG_ID=YOUR_NUMERIC_TAG_ID

# Your AI Audit secure checkout destinations
PUBLIC_AI_SNAPSHOT_CHECKOUT_URL=https://buy.stripe.com/YOUR_SNAPSHOT_LINK
PUBLIC_AI_MINI_AUDIT_CHECKOUT_URL=https://buy.stripe.com/YOUR_MINI_AUDIT_LINK
PUBLIC_AI_FULL_AUDIT_CHECKOUT_URL=https://buy.stripe.com/YOUR_FULL_AUDIT_LINK

# Optional Meta Conversions API test code for validating server events in Events Manager.
META_CAPI_TEST_EVENT_CODE=TEST00000
STRIPE_AI_AUDIT_WEBHOOK_SECRET=whsec_replace_me
