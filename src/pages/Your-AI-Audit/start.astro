---
import BaseHead from '../../components/BaseHead.astro';

const title = 'Start Your One-Page AI Workflow Recommendation';
const description = 'Complete the eight-question intake for your paid one-page AI workflow recommendation.';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<meta name="robots" content="noindex, nofollow, noarchive" />
	</head>
	<body>
		<main class="intake-shell">
			<header class="intake-header">
				<a href="/" class="brand" aria-label="Jack Maguire home"><span>JM</span> Your AI Audit</a>
				<p id="paid-plan-label">Verifying $59 payment</p>
			</header>

			<section class="intro" aria-labelledby="intake-title">
				<p class="eyebrow" id="intake-eyebrow">Checking payment</p>
				<h1 id="intake-title">Tell me about one computer task you repeat.</h1>
				<p id="intake-intro-copy">After your $59 payment is verified, answer eight questions using rough estimates. This takes about five minutes. I personally review the completed intake and email your one-page AI workflow recommendation by the end of the next business day.</p>
				<div class="privacy-note"><strong>Describe the workflow at a high level.</strong> Do not include passwords, API keys, files, customer records, health information, financial account details, or other sensitive personal information. None of those are needed for the recommendation.</div>
			</section>

			<div id="verification-status" class="order-warning" role="status">
				<p class="eyebrow">Checking payment</p>
				<h2>Verifying your $59 order.</h2>
				<p>This normally takes a few seconds.</p>
			</div>

			<div id="rejected-order" class="order-warning" hidden>
				<p class="eyebrow">Order not verified</p>
				<h2>I could not verify an eligible $59 payment.</h2>
				<p>Open this page from the button shown after Stripe confirms payment. If you paid and still see this message, email <a href="mailto:maguirebaseball@gmail.com?subject=AI%20workflow%20recommendation%20payment%20verification">maguirebaseball@gmail.com</a> with the email on your Stripe receipt.</p>
				<p><a class="text-link" href="/Your-AI-Audit/">Return to the offer</a></p>
			</div>

			<div id="pending-manual-order" class="order-warning pending-warning" hidden>
				<p class="eyebrow">Manual payment check</p>
				<h2>Your order needs a quick manual review.</h2>
				<p>You can submit the intake now. I will verify the $59 payment before preparing the recommendation. The delivery window begins after the payment is confirmed and the completed intake is received.</p>
			</div>

			<section id="form-card" class="form-card" aria-label="One-page AI workflow recommendation intake" hidden>
				<div class="progress-wrap" aria-label="Form progress">
					<div class="progress-meta"><span id="progress-label">Step 1 of 4</span><strong id="progress-percent">25%</strong></div>
					<div class="progress-track"><span id="progress-bar"></span></div>
				</div>

				<form id="snapshot-intake" novalidate>
					<input type="hidden" name="plan" value="One-page AI workflow recommendation" />
					<input id="session-id" type="hidden" name="stripe_checkout_session_id" value="" />
					<input id="utm-source" type="hidden" name="utm_source" value="" />
					<input id="utm-medium" type="hidden" name="utm_medium" value="" />
					<input id="utm-campaign" type="hidden" name="utm_campaign" value="" />
					<input id="utm-content" type="hidden" name="utm_content" value="" />
					<input id="utm-term" type="hidden" name="utm_term" value="" />
					<input type="checkbox" name="botcheck" class="botcheck" tabindex="-1" autocomplete="off" />

					<div class="form-step is-active" data-step="1">
						<fieldset>
							<legend><span>01</span> What does your week involve, and where does this task fit?</legend>
							<p class="help">One or two sentences is enough. Example: I manage a busy household and spend Sunday evening sorting appointments, email, and receipts.</p>
							<textarea name="q1_weekly_context" rows="4" required></textarea>
							<p class="field-error" aria-live="polite"></p>
						</fieldset>

						<fieldset>
							<legend><span>02</span> Which recurring computer task do you most want off your plate?</legend>
							<div class="radio-grid">
								{['Inbox sorting and replies','Meeting notes and action items','Spreadsheet updates or reporting','Scheduling and reminders','Recurring research or summaries','Drafting routine messages or documents','Personal or household admin','Expense or receipt sorting','Data entry or moving information between tools','Something else'].map((option) => (
									<label><input type="radio" name="q2_workflow" value={option} required /> <span>{option}</span></label>
								))}
							</div>
							<label id="workflow-other-wrap" class="conditional" hidden>What workflow?<input id="workflow-other" type="text" name="q2_workflow_other" /></label>
							<p class="field-error" aria-live="polite"></p>
						</fieldset>
					</div>

					<div class="form-step" data-step="2" hidden>
						<fieldset>
							<legend><span>03</span> Walk me through what happens today.</legend>
							<p class="help">Start with what triggers the task, then list the main steps until it is finished. A rough description is fine.</p>
							<textarea name="q3_current_process" rows="7" required></textarea>
							<p class="field-error" aria-live="polite"></p>
						</fieldset>

						<fieldset>
							<legend><span>04</span> About how many times does this happen in a normal week?</legend>
							<p class="help">Use a whole number from 1 to 500. If it happens monthly, divide the monthly total by four.</p>
							<input type="number" name="q4_weekly_frequency" min="1" max="500" step="1" inputmode="numeric" required />
							<p class="field-error" aria-live="polite"></p>
						</fieldset>
					</div>

					<div class="form-step" data-step="3" hidden>
						<fieldset>
							<legend><span>05</span> About how many minutes does one occurrence take?</legend>
							<p class="help">Include time spent finding information, switching tools, checking the work, and fixing errors.</p>
							<input type="number" name="q5_minutes_per_occurrence" min="1" max="480" step="1" inputmode="numeric" required />
							<p class="field-error" aria-live="polite"></p>
						</fieldset>

						<fieldset>
							<legend><span>06</span> What tools do you use during this workflow?</legend>
							<p class="help">Examples: Gmail, Outlook, Google Sheets, Excel, HubSpot, QuickBooks, Zoom, or none.</p>
							<textarea name="q6_current_tools" rows="4" required></textarea>
							<p class="field-error" aria-live="polite"></p>
						</fieldset>
					</div>

					<div class="form-step" data-step="4" hidden>
						<fieldset data-checkbox-group="q7_outcomes">
							<legend><span>07</span> What would a useful improvement look like?</legend>
							<p class="help">Select every outcome that matters.</p>
							<div class="check-grid">
								{['Spend less time doing it','Respond faster','Miss fewer follow-ups or deadlines','Reduce manual copying or data entry','Make the output more consistent','Make it easier to delegate','Get a clearer report or summary','Something else'].map((option) => (
									<label><input type="checkbox" name="q7_outcomes" value={option} /> <span>{option}</span></label>
								))}
							</div>
							<label id="outcome-other-wrap" class="conditional" hidden>What outcome matters?<input id="outcome-other" type="text" name="q7_outcome_other" /></label>
							<p class="field-error" aria-live="polite"></p>
						</fieldset>

						<fieldset data-checkbox-group="q8_constraints">
							<legend><span>08</span> What constraints must the recommendation respect?</legend>
							<p class="help">Select every constraint that applies.</p>
							<div class="check-grid">
								{['I do not want to change my current core software','The task involves sensitive personal or client information','I need a no-code setup','I want to keep new software under $25 per month','I want to keep new software under $60 per month','Someone else must be able to maintain it','I have no major constraints','Something else'].map((option) => (
									<label><input type="checkbox" name="q8_constraints" value={option} /> <span>{option}</span></label>
								))}
							</div>
							<label class="conditional always-visible">Anything else I should avoid or account for?<textarea name="q8_constraint_notes" rows="3"></textarea></label>
							<p class="field-error" aria-live="polite"></p>
						</fieldset>

						<label class="confirmation"><input type="checkbox" name="projection_acknowledgement" value="Agreed" required /> <span>I understand that this purchase is a one-page recommendation and setup plan, not implementation. The 30-minute savings figure is a projection based on my estimates, and the refund guarantee applies when Jack cannot support that projection, not to results after implementation.</span></label>
						<p id="confirmation-error" class="field-error" aria-live="polite"></p>
					</div>

					<div class="form-actions">
						<button id="back-button" class="button secondary" type="button" hidden>Back</button>
						<button id="next-button" class="button" type="button">Continue</button>
						<button id="submit-button" class="button" type="submit" hidden>Submit for my recommendation</button>
					</div>
					<p id="form-status" class="form-status" role="status" aria-live="polite" hidden></p>
				</form>
			</section>

			<section id="success-card" class="success-card" hidden>
				<p class="eyebrow">Intake complete</p>
				<h2>Your recommendation is underway.</h2>
				<p>I have your completed intake. I will email your one-page AI workflow recommendation by the end of the next business day.</p>
				<ul>
					<li>The recurring workflow you submitted</li>
					<li>Its current weekly time cost</li>
					<li>One personally selected AI or automation recommendation</li>
					<li>Projected weekly savings, setup burden, software cost, and first test</li>
				</ul>
				<p class="guarantee">If the completed intake does not support one practical change projected to save at least 30 minutes each week, I will issue a full $59 refund. The recommendation is a setup plan, not installation, and actual results depend on implementation.</p>
			</section>

			<section id="pending-success-card" class="success-card" hidden>
				<p class="eyebrow">Intake received</p>
				<h2>Your answers are waiting for payment review.</h2>
				<p>I received the intake, but the $59 payment still needs manual verification. I will confirm the order using the Stripe receipt email before preparing the one-page recommendation.</p>
				<p class="guarantee">The next-business-day delivery window begins after the payment is confirmed and the completed intake is received. A pending manual submission is not counted as a verified completed intake.</p>
			</section>

			<footer class="intake-footer">
				<a href="/privacy-policy/">Privacy policy</a>
				<span>Questions? maguirebaseball [at] gmail [dot] com</span>
			</footer>
		</main>

		<script>
			const attributionStorageKey = 'jm_ai_audit_attribution_v2';
			const gaClientKey = 'jm_ga4_audit_client';
			const gaSessionKey = 'jm_ga4_audit_session';
			const form = document.getElementById('snapshot-intake');
			const formCard = document.getElementById('form-card');
			const successCard = document.getElementById('success-card');
			const pendingSuccessCard = document.getElementById('pending-success-card');
			const verificationStatus = document.getElementById('verification-status');
			const rejectedOrder = document.getElementById('rejected-order');
			const pendingManualOrder = document.getElementById('pending-manual-order');
			const sessionInput = document.getElementById('session-id');
			const steps = Array.from(document.querySelectorAll('.form-step'));
			const nextButton = document.getElementById('next-button');
			const backButton = document.getElementById('back-button');
			const submitButton = document.getElementById('submit-button');
			const progressLabel = document.getElementById('progress-label');
			const progressPercent = document.getElementById('progress-percent');
			const progressBar = document.getElementById('progress-bar');
			const formStatus = document.getElementById('form-status');
			const paidPlanLabel = document.getElementById('paid-plan-label');
			const intakeEyebrow = document.getElementById('intake-eyebrow');
			const params = new URLSearchParams(window.location.search);
			const checkoutSessionId = (params.get('session_id') || '').trim();
			const eventSessionKey = checkoutSessionId.replace(/[^A-Za-z0-9_-]/g, '_').slice(0, 140) || 'missing';
			const eventIds = {
				started: `audit_intake_started_${eventSessionKey}`,
				halfway: `audit_intake_halfway_${eventSessionKey}`,
				completed: `audit_intake_completed_${eventSessionKey}`,
				pending: `audit_intake_pending_manual_${eventSessionKey}`,
			};
			const eventStorageKeys = {
				started: `jm_${eventIds.started}`,
				halfway: `jm_${eventIds.halfway}`,
				completed: `jm_${eventIds.completed}`,
				pending: `jm_${eventIds.pending}`,
			};
			let currentStep = 0;
			let orderState = 'checking';
			let startedTracked = sessionStorage.getItem(eventStorageKeys.started) === '1';
			let halfwayTracked = sessionStorage.getItem(eventStorageKeys.halfway) === '1';

			function storedAttribution() {
				try {
					return JSON.parse(sessionStorage.getItem(attributionStorageKey) || '{}');
				} catch {
					return {};
				}
			}

			function stableGaIdentity() {
				if (window.jmGa4Identity?.getSync) {
					const identity = window.jmGa4Identity.getSync();
					return { clientId: identity.clientId, analyticsSessionId: identity.sessionId };
				}
				let clientId = sessionStorage.getItem(gaClientKey) || '';
				let analyticsSessionId = sessionStorage.getItem(gaSessionKey) || '';
				if (!clientId) {
					const gaCookie = document.cookie.match(/(?:^|; )_ga=GA\d+\.\d+\.(\d+\.\d+)/)?.[1];
					clientId = gaCookie || `${Math.floor(Math.random() * 1_000_000_000)}.${Math.floor(Date.now() / 1000)}`;
					sessionStorage.setItem(gaClientKey, clientId);
				}
				if (!analyticsSessionId) {
					analyticsSessionId = String(Math.floor(Date.now() / 1000));
					sessionStorage.setItem(gaSessionKey, analyticsSessionId);
				}
				return { clientId, analyticsSessionId };
			}

			async function resolvedGaIdentity() {
				if (window.jmGa4Identity?.resolve) {
					const identity = await window.jmGa4Identity.resolve();
					return { clientId: identity.clientId, analyticsSessionId: identity.sessionId };
				}
				return stableGaIdentity();
			}

			function trackCustom(name, eventId) {
				if (typeof window.fbq === 'function') {
					window.fbq('trackCustom', name, { content_ids: ['ai_bottleneck_snapshot'], content_name: 'One-Task AI Plan' }, { eventID: eventId });
				}
			}

			async function trackAuditAnalytics(name, parameters = {}) {
				const debugMode = params.get('ga_debug') === '1';
				const { clientId, analyticsSessionId } = await resolvedGaIdentity();
				const stored = storedAttribution();
				const source = params.get('utm_source') || stored.utm_source || '';
				const medium = params.get('utm_medium') || stored.utm_medium || '';
				const campaign = params.get('utm_campaign') || stored.campaign || '';
				const content = params.get('utm_content') || stored.ad_name || '';
				const term = params.get('utm_term') || stored.placement || '';
				return fetch('/api/ga4-audit-event/', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({
						event_name: name,
						params: {
							content_group: 'ai_audit',
							campaign,
							campaign_id: params.get('utm_id') || stored.campaign_id || '',
							source,
							medium,
							content,
							term,
							ad_name: content,
							adset_id: params.get('adset_id') || stored.adset_id || '',
							ad_id: params.get('ad_id') || stored.ad_id || '',
							placement: term,
							site_source_name: params.get('site_source_name') || stored.site_source_name || '',
							landing_session_id: stored.landing_session_id || '',
							first_landing_at: stored.first_landing_at || '',
							page_location: window.location.href,
							page_referrer: document.referrer,
							...parameters,
						},
						client_id: clientId,
						session_id: analyticsSessionId,
						debug_mode: debugMode,
					}),
					keepalive: true,
				}).catch(() => {});
			}

			function normalizeState(result) {
				const raw = String(result?.state || result?.status || '').toLowerCase().replace(/-/g, '_');
				if (result?.verified === true || ['verified', 'paid', 'approved'].includes(raw)) return 'verified';
				if (result?.pending_manual === true || ['pending_manual', 'manual_review', 'pending'].includes(raw)) return 'pending_manual';
				return 'rejected';
			}

			async function callIntakeApi(body) {
				const response = await fetch('/api/ai-audit-intake/', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
					body: JSON.stringify(body),
				});
				const result = await response.json().catch(() => ({}));
				return { response, result };
			}

			function renderOrderState(nextState, message = '') {
				orderState = nextState;
				if (verificationStatus instanceof HTMLElement) verificationStatus.hidden = nextState !== 'checking';
				if (rejectedOrder instanceof HTMLElement) rejectedOrder.hidden = nextState !== 'rejected';
				if (pendingManualOrder instanceof HTMLElement) pendingManualOrder.hidden = nextState !== 'pending_manual';
				if (formCard instanceof HTMLElement) formCard.hidden = !['verified', 'pending_manual'].includes(nextState);
				if (successCard instanceof HTMLElement) successCard.hidden = true;
				if (pendingSuccessCard instanceof HTMLElement) pendingSuccessCard.hidden = true;

				if (nextState === 'verified') {
					if (paidPlanLabel) paidPlanLabel.textContent = 'Paid recommendation intake';
					if (intakeEyebrow) intakeEyebrow.textContent = 'Payment verified';
					showStep(0, false);
				} else if (nextState === 'pending_manual') {
					if (paidPlanLabel) paidPlanLabel.textContent = 'Payment review pending';
					if (intakeEyebrow) intakeEyebrow.textContent = 'Manual payment check';
					showStep(0, false);
				} else if (nextState === 'rejected') {
					if (paidPlanLabel) paidPlanLabel.textContent = 'Order not verified';
					if (intakeEyebrow) intakeEyebrow.textContent = 'Order verification needed';
					if (message && rejectedOrder instanceof HTMLElement) {
						const paragraph = rejectedOrder.querySelector('p:not(.eyebrow)');
						if (paragraph) paragraph.textContent = message;
					}
				}
			}

			function showStep(index, scroll = true) {
				currentStep = index;
				steps.forEach((step, stepIndex) => {
					step.hidden = stepIndex !== index;
					step.classList.toggle('is-active', stepIndex === index);
				});
				const percent = Math.round(((index + 1) / steps.length) * 100);
				if (progressLabel) progressLabel.textContent = `Step ${index + 1} of ${steps.length}`;
				if (progressPercent) progressPercent.textContent = `${percent}%`;
				if (progressBar instanceof HTMLElement) progressBar.style.width = `${percent}%`;
				if (backButton instanceof HTMLButtonElement) backButton.hidden = index === 0;
				if (nextButton instanceof HTMLButtonElement) nextButton.hidden = index === steps.length - 1;
				if (submitButton instanceof HTMLButtonElement) submitButton.hidden = index !== steps.length - 1;
				if (index >= 2 && !halfwayTracked) {
					halfwayTracked = true;
					sessionStorage.setItem(eventStorageKeys.halfway, '1');
					trackCustom('AuditIntakeHalfway', eventIds.halfway);
					trackAuditAnalytics('ai_audit_intake_halfway', { event_id: eventIds.halfway, step_number: index + 1, verification_state: orderState });
				}
				if (scroll) window.scrollTo({ top: 0, behavior: 'smooth' });
			}

			function setFieldError(fieldset, message) {
				const error = fieldset?.querySelector('.field-error');
				if (error instanceof HTMLElement) error.textContent = message;
			}

			function validateStep(index) {
				const step = steps[index];
				if (!(step instanceof HTMLElement)) return false;
				let valid = true;
				step.querySelectorAll('fieldset').forEach((fieldset) => setFieldError(fieldset, ''));

				step.querySelectorAll('input[required], textarea[required]').forEach((field) => {
					if (!(field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement)) return;
					if (field.type === 'radio') return;
					if (!field.checkValidity()) {
						valid = false;
						const fieldset = field.closest('fieldset');
						const message = field.type === 'number'
							? 'Enter a whole number within the range shown above.'
							: 'Add an answer before continuing.';
						setFieldError(fieldset, message);
					}
				});

				step.querySelectorAll('input[type="radio"][required]').forEach((radio) => {
					if (!(radio instanceof HTMLInputElement)) return;
					const checked = step.querySelector(`input[name="${radio.name}"]:checked`);
					if (!checked) {
						valid = false;
						setFieldError(radio.closest('fieldset'), 'Choose one workflow before continuing.');
					}
				});

				step.querySelectorAll('[data-checkbox-group]').forEach((fieldset) => {
					const name = fieldset.getAttribute('data-checkbox-group');
					if (name && !fieldset.querySelector(`input[name="${name}"]:checked`)) {
						valid = false;
						setFieldError(fieldset, 'Choose at least one option.');
					}
				});

				const acknowledgement = step.querySelector('input[name="projection_acknowledgement"]');
				const confirmationError = document.getElementById('confirmation-error');
				if (acknowledgement instanceof HTMLInputElement && !acknowledgement.checked) {
					valid = false;
					if (confirmationError) confirmationError.textContent = 'Confirm the projection terms before sending your answers.';
				} else if (confirmationError) confirmationError.textContent = '';

				if (!valid) step.querySelector('input:invalid, textarea:invalid, .field-error:not(:empty)')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
				return valid;
			}

			function collectIntake() {
				if (!(form instanceof HTMLFormElement)) return {};
				const intake = {};
				for (const [key, value] of new FormData(form).entries()) {
					const cleanValue = typeof value === 'string' ? value : value.name;
					if (Object.prototype.hasOwnProperty.call(intake, key)) {
						intake[key] = Array.isArray(intake[key]) ? [...intake[key], cleanValue] : [intake[key], cleanValue];
					} else {
						intake[key] = cleanValue;
					}
				}
				return intake;
			}

			async function verifyOrder() {
				if (!checkoutSessionId) {
					renderOrderState('rejected', 'The Stripe payment reference is missing. Open this page from the button shown after payment, or email me with the email on your Stripe receipt.');
					return;
				}

				try {
					const { response, result } = await callIntakeApi({ action: 'verify', session_id: checkoutSessionId, tier: 'snapshot' });
					const state = normalizeState(result);
					if (!response.ok && state === 'rejected') {
						renderOrderState('rejected', result.message || 'I could not verify an eligible $59 payment. If you paid, email me with the email on your Stripe receipt.');
						return;
					}
					renderOrderState(state, result.message || '');
					if (state === 'verified') {
						trackAuditAnalytics('ai_audit_checkout_returned', { tier: 'snapshot', checkout_session_present: true, verification_state: state });
					}
				} catch {
					renderOrderState('rejected', 'Payment verification is temporarily unavailable. Refresh this page in a moment, or email me with the email on your Stripe receipt.');
				}
			}

			if (form instanceof HTMLFormElement && sessionInput instanceof HTMLInputElement) {
				sessionInput.value = checkoutSessionId;
				const landingAttribution = storedAttribution();
				const storedUtm = {
					source: landingAttribution.utm_source || '',
					medium: landingAttribution.utm_medium || '',
					campaign: landingAttribution.campaign || '',
					content: landingAttribution.ad_name || '',
					term: landingAttribution.placement || '',
				};
				['source', 'medium', 'campaign', 'content', 'term'].forEach((key) => {
					const input = document.getElementById(`utm-${key}`);
					if (input instanceof HTMLInputElement) input.value = params.get(`utm_${key}`) || storedUtm[key] || '';
				});

				form.addEventListener('input', () => {
					if (!startedTracked && ['verified', 'pending_manual'].includes(orderState)) {
						startedTracked = true;
						sessionStorage.setItem(eventStorageKeys.started, '1');
						trackCustom('AuditIntakeStarted', eventIds.started);
						trackAuditAnalytics('ai_audit_intake_started', { event_id: eventIds.started, tier: 'snapshot', verification_state: orderState });
					}
				});

				nextButton?.addEventListener('click', () => {
					if (validateStep(currentStep)) showStep(Math.min(currentStep + 1, steps.length - 1));
				});
				backButton?.addEventListener('click', () => showStep(Math.max(currentStep - 1, 0)));

				form.querySelectorAll('input[name="q2_workflow"]').forEach((input) => {
					input.addEventListener('change', () => {
						const other = form.querySelector('input[name="q2_workflow"]:checked')?.getAttribute('value') === 'Something else';
						const wrap = document.getElementById('workflow-other-wrap');
						const field = document.getElementById('workflow-other');
						if (wrap instanceof HTMLElement) wrap.hidden = !other;
						if (field instanceof HTMLInputElement) field.required = other;
					});
				});

				form.querySelectorAll('input[name="q7_outcomes"]').forEach((input) => {
					input.addEventListener('change', () => {
						const other = Boolean(form.querySelector('input[name="q7_outcomes"][value="Something else"]:checked'));
						const wrap = document.getElementById('outcome-other-wrap');
						const field = document.getElementById('outcome-other');
						if (wrap instanceof HTMLElement) wrap.hidden = !other;
						if (field instanceof HTMLInputElement) field.required = other;
					});
				});

				form.addEventListener('submit', async (event) => {
					event.preventDefault();
					if (!['verified', 'pending_manual'].includes(orderState)) return;
					if (!validateStep(currentStep)) return;
					if (formStatus instanceof HTMLElement) formStatus.hidden = true;
					if (submitButton instanceof HTMLButtonElement) {
						submitButton.disabled = true;
						submitButton.textContent = 'Sending your answers...';
					}

					try {
						const attribution = storedAttribution();
						const { response, result } = await callIntakeApi({
							action: 'submit',
							session_id: checkoutSessionId,
							tier: 'snapshot',
							verification_state: orderState,
							intake: collectIntake(),
							attribution,
						});
						const submittedState = normalizeState(result);
						if (submittedState === 'rejected') {
							if (['invalid_intake', 'intake_delivery_failed'].includes(result.reason)) {
								throw new Error(result.message || 'One or more answers could not be validated. Review the form and try again.');
							}
							renderOrderState('rejected', result.message || 'The $59 payment could not be verified, so the intake was not marked complete. Email me with the email on your Stripe receipt.');
							window.scrollTo({ top: 0, behavior: 'smooth' });
							return;
						}
						if (!response.ok || result.success === false) throw new Error(result.message || 'Submission failed');
						if (formCard instanceof HTMLElement) formCard.hidden = true;
						if (pendingManualOrder instanceof HTMLElement) pendingManualOrder.hidden = true;

						if (submittedState === 'verified') {
							if (sessionStorage.getItem(eventStorageKeys.completed) !== '1') {
								sessionStorage.setItem(eventStorageKeys.completed, '1');
								trackCustom('AuditIntakeCompleted', eventIds.completed);
							}
							if (successCard instanceof HTMLElement) successCard.hidden = false;
						} else if (submittedState === 'pending_manual') {
							if (sessionStorage.getItem(eventStorageKeys.pending) !== '1') {
								sessionStorage.setItem(eventStorageKeys.pending, '1');
								trackCustom('AuditIntakePendingManual', eventIds.pending);
								trackAuditAnalytics('ai_audit_intake_pending_manual', { event_id: eventIds.pending, tier: 'snapshot', verification_state: 'pending_manual' });
							}
							if (pendingSuccessCard instanceof HTMLElement) pendingSuccessCard.hidden = false;
						}
						window.scrollTo({ top: 0, behavior: 'smooth' });
					} catch (error) {
						if (formStatus instanceof HTMLElement) {
							formStatus.textContent = error instanceof Error && error.message
								? error.message
								: 'Your answers did not send. Try again, or email maguirebaseball@gmail.com.';
							formStatus.hidden = false;
						}
						if (submitButton instanceof HTMLButtonElement) {
							submitButton.disabled = false;
							submitButton.textContent = 'Submit for my recommendation';
						}
					}
				});

				verifyOrder();
			}
		</script>
	</body>
</html>

