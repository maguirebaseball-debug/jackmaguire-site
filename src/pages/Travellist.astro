Netherlands|Randstad
Greece|Athens
`.trim();

const rows = rawRows.split('\n').map((line) => {
	const [country, region] = line.split('|');
	return { country, region };
});

const countries = [...new Set(rows.map((row) => row.country))].sort((a, b) => a.localeCompare(b));
const regionCount = rows.length;
const continentGroups = [
	{
		name: 'Europe',
		image: '/images/travel/regions/europe.png',
		alt: 'NomadMania map view of Europe',
		countries: ['Albania', 'Austria', 'Belarus', 'Belgium', 'Czechia', 'Denmark', 'Estonia', 'Finland', 'France', 'Germany', 'Greece', 'Hungary', 'Ireland', 'Italy', 'Latvia', 'Lithuania', 'Netherlands', 'Norway', 'Poland', 'Portugal', 'Romania', 'Russia', 'Serbia', 'Slovakia', 'Slovenia', 'Spain', 'Sweden', 'Switzerland', 'Ukraine', 'United Kingdom'],
	},
	{
		name: 'North America',
		image: '/images/travel/regions/north-america.png',
		alt: 'NomadMania map view of North America',
		countries: ['Canada', 'Dominican Republic', 'Guatemala', 'Mexico', 'United States'],
	},
	{
		name: 'South America',
		image: '/images/travel/regions/south-america.png',
		alt: 'NomadMania map view of South America',
		countries: ['Argentina', 'Brazil', 'Colombia', 'Ecuador'],
	},
	{
		name: 'Asia',
		image: '/images/travel/regions/asia.png',
		alt: 'NomadMania map view of Asia',
		countries: ['China', 'Japan'],
	},
].map((continent) => ({
	...continent,
	countries: continent.countries.filter((country) => countries.includes(country)),
}));
const countryWiki: Record<string, string> = {
	'Czechia': 'Czechia',
	'United Kingdom': 'United Kingdom',
	'United States': 'United States',
};

function wiki(title: string) {
	return `https://en.wikipedia.org/wiki/${encodeURIComponent(title.replace(/ /g, '_'))}`;
}

function countryUrl(country: string) {
	return wiki(countryWiki[country] ?? country);
}

function regionUrl(country: string, region: string) {
	const regionTitles: Record<string, string> = {
		'Albania|Coastal': 'Albania',
		'Albania|Northeastern': 'Albania',
		'Austria|South - Carinthia and Styria': 'Austria',
		'Belgium|Flanders': 'Flanders',
		'Belarus|Central and Northeast': 'Belarus',
		'Brazil|São Paulo Greater City': 'São Paulo',
		'Canada|Ontario East': 'Ontario',
		'Canada|Ontario Peninsula': 'Ontario',
		'Canada|Quebec East': 'Quebec',
		'Canada|Quebec West': 'Quebec',
		'China|Shaanxi - Central': 'Shaanxi',
		'Colombia|Antioquia and Eje Cafetero': 'Colombia',
		'Czechia|Central Bohemia and Prague': 'Central Bohemian Region',
		'Denmark|Hovedstaden, Sjælland': 'Denmark',
		'Dominican Republic|Eastern': 'Dominican Republic',
		'Ecuador|Andes North': 'Ecuador',
		'Ecuador|Coastal Ecuador': 'Ecuador',
		'Estonia|Coastal': 'Estonia',
		'Finland|Southern': 'Finland',
		'Germany|Bavaria Northern': 'Bavaria',
		'Germany|Bavaria Southern': 'Bavaria',
		'Guatemala|Highlands': 'Guatemala',
		'Guatemala|Pacific Coast': 'Guatemala',
		'Hungary|Central - Budapest and Pest County': 'Hungary',
		'Ireland|Connacht and Ulster': 'Ireland',
		'Japan|Kansai - Greater Osaka': 'Kansai region',
		'Japan|Kantō - Greater Tokyo': 'Kantō region',
		'Latvia|North - Riga and Vidzeme': 'Latvia',
		'Lithuania|South - Dzūkija and Suvalkija': 'Lithuania',
		'Netherlands|South - Zeeland, Limburg, North Brabant': 'Netherlands',
		'Norway|Eastern': 'Eastern Norway',
		'Poland|Silesia, Lower Silesia, Opole': 'Poland',
		'Portugal|Central': 'Centro Region',
		'Portugal|Lisbon and Vale do Tejo': 'Portugal',
		'Serbia|Belgrade, West': 'Belgrade',
		'Slovakia|Western Slovakia': 'Western Slovakia',
		'Slovenia|Western': 'Slovenia',
		'Spain|Catalonia Eastern': 'Catalonia',
		'Sweden|Stockholm and Mälardalen': 'Sweden',
		'Ukraine|Central': 'Central Ukraine',
		'United Kingdom|England - Greater London': 'Greater London',
		'United Kingdom|England - Thames Valley and Hampshire': 'England',
		'United States|Arizona North': 'Arizona',
		'United States|Arizona South': 'Arizona',
		'United States|California Extreme North': 'California',
		'United States|California North': 'California',
		'United States|California South': 'California',
		'United States|Colorado East': 'Colorado',
		'United States|Florida Central/South': 'Florida',
		'United States|Florida Keys': 'Florida',
		'United States|Florida North': 'Florida',
		'United States|Georgia North': 'Georgia (U.S. state)',
		'United States|Georgia South': 'Georgia (U.S. state)',
		'United States|Hawaii - Big Island': 'Hawaii Island',
		'United States|Hawaii - Oahu, Maui, Kauai': 'Hawaii',
		'United States|Illinois Northeast': 'Illinois',
		'United States|Illinois West/South': 'Illinois',
		'United States|Michigan Lower Peninsula': 'Michigan',
		'United States|New York - New York City and Long Island': 'New York (state)',
		'United States|New York East': 'New York (state)',
		'United States|New York West': 'New York (state)',
		'United States|Nevada South': 'Nevada',
		'United States|Ohio North': 'Ohio',
		'United States|Ohio South': 'Ohio',
		'United States|Pennsylvania East': 'Pennsylvania',
		'United States|Pennsylvania West': 'Pennsylvania',
		'United States|Texas Northeast': 'Texas',
		'United States|Texas Southeast': 'Texas',
		'United States|Washington DC': 'Washington, D.C.',
		'United States|West Virginia': 'West Virginia',
	};
	// Unmapped NomadMania labels can be informal or too granular for Wikipedia.
	// The country article is the verified containing parent and stays useful.
	const title = regionTitles[`${country}|${region}`] ?? countryWiki[country] ?? country;
	return wiki(title);
}
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${title} | Jack Maguire`} description={description} articlePublished={pubDate} />
	</head>
	<body>
		<Header />
		<main class="travel-page">
			<header class="page-intro">
				<p class="kicker">A personal atlas</p>
				<h1>{title}</h1>
				<p class="lede">Places I’ve visited, kept as a working list rather than a bucket list. Browse by continent, country, or search the {regionCount} entries drawn from my NomadMania list.</p>
				<div class="stats" aria-label="Travel list statistics">
					<span><strong>{regionCount}</strong> regional entries</span>
				</div>
			</header>

			<section class="controls" aria-label="Travel list controls">
				<label for="region-search">Find a region</label>
				<input id="region-search" type="search" placeholder="Search regions or countries" autocomplete="off" />
				<label for="country-filter" class="sr-only">Filter by country</label>
				<select id="country-filter">
					<option value="all">All countries</option>
					{countries.map((country) => <option value={country}>{country}</option>)}
				</select>
				<p id="result-count" class="result-count" aria-live="polite">Showing all {countries.length} countries</p>
			</section>

			<section class="country-list" aria-label="Visited places">
				{continentGroups.map((continent) => (
					<section class="continent-section" data-continent={continent.name}>
						<div class="continent-heading">
							<div>
								<p class="continent-kicker">Continental view</p>
								<h2>{continent.name}</h2>
							</div>
							<span>{continent.countries.length} {continent.countries.length === 1 ? 'country' : 'countries'}</span>
						</div>
						<figure class="continent-map">
							<img src={continent.image} alt={continent.alt} loading="lazy" decoding="async" />
							<figcaption>Map view captured from <a href="https://nomadmania.com/regions/">NomadMania’s Regions page</a>.</figcaption>
						</figure>
						<div class="continent-countries">
							{continent.countries.map((country) => {
								const countryRows = rows.filter((row) => row.country === country);
								return (
									<article class="country-section" data-country={country} data-search={`${country} ${countryRows.map((row) => row.region).join(' ')}`.toLowerCase()}>
										<div class="country-heading">
											<h3><a href={countryUrl(country)}>{country}</a></h3>
											<span>{countryRows.length} {countryRows.length === 1 ? 'region' : 'regions'}</span>
										</div>
										<div class="region-list">
											{countryRows.map((row) => (
												<div class="region-row" data-row-search={row.region.toLowerCase()}>
													<div class="region-name"><a href={regionUrl(row.country, row.region)}>{row.region}</a></div>
												</div>
											))}
										</div>
									</article>
								);
							})}
						</div>
					</section>
				))}
			</section>
			<p id="no-results" class="no-results" hidden>No regions match that search.</p>
			<p class="source-note">Map captures are from <a href="https://nomadmania.com/regions/">NomadMania’s Regions page</a>. Country and regional names link to their English Wikipedia entries. A single-city NomadMania region keeps its city name; multi-city regions stay at the regional level.</p>
		</main>
		<Footer />
		<script>
			const search = document.querySelector('#region-search');
			const filter = document.querySelector('#country-filter');
			const sections = [...document.querySelectorAll('.country-section')];
			const continentSections = [...document.querySelectorAll('.continent-section')];
			const resultCount = document.querySelector('#result-count');
			const noResults = document.querySelector('#no-results');
			function updateList() {
				const query = search.value.trim().toLowerCase();
				const selectedCountry = filter.value;
				let visible = 0;
				sections.forEach((section) => {
					const matchesCountry = selectedCountry === 'all' || section.dataset.country === selectedCountry;
					const matchesSearch = !query || section.dataset.search.includes(query);
					const show = matchesCountry && matchesSearch;
					section.hidden = !show;
					if (show) visible += 1;
				});
				continentSections.forEach((continent) => {
					continent.hidden = !continent.querySelector('.country-section:not([hidden])');
				});
				resultCount.textContent = visible === sections.length ? `Showing all ${visible} countries` : `Showing ${visible} ${visible === 1 ? 'country' : 'countries'}`;
				noResults.hidden = visible !== 0;
			}
			search.addEventListener('input', updateList);
			filter.addEventListener('change', updateList);
		</script>
	</body>
</html>

<style>
	.travel-page {
		max-width: 920px;
	}
	.page-intro {
		max-width: 45rem;
		padding: 2.75rem 0 2.25rem;
