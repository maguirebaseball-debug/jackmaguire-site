---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

const title = 'Travel list';
const description = 'A record of places Jack Maguire has visited, organized by country and region.';
const pubDate = 'August 10, 2026';
const category = 'Travel';

// This is intentionally a regional record. City names are not displayed or used as data.
const rawRows = `
Albania|Southern Albania
Albania|Tirana County
Austria|Greater Vienna
Austria|South - Carinthia and Styria
Belgium|Flanders
Canada|Ontario East
Canada|Ontario Peninsula
Canada|Quebec East
Canada|Quebec West
China|Beijing Municipality
China|Chongqing Municipality
China|Hong Kong
China|Shaanxi
China|Shanghai Municipality
Czechia|Central Bohemia and Prague
Czechia|Moravia
Dominican Republic|Santo Domingo
Ecuador|Guayas
Ecuador|Manabí
Ecuador|Tungurahua
Germany|Bavaria
Germany|Berlin
Germany|Hesse
Greece|Attica
Greece|Ionian Islands
Guatemala|Highlands
Ireland|Connacht and Ulster
Ireland|Munster
Ireland|Leinster
Italy|Lazio
Italy|Tuscany
Italy|Umbria
Italy|Veneto
Japan|Kansai
Japan|Kantō
Mexico|Ciudad de México
Mexico|Quintana Roo
Mexico|Yucatán
Netherlands|Randstad
Netherlands|South - Zeeland, Limburg, North Brabant
Poland|Lesser Poland
Poland|Mazovia and Łódź
Poland|Pomerania
Poland|Silesia, Lower Silesia, Opole
Portugal|Central
Portugal|Lisbon and Vale do Tejo
Russia|Saint Petersburg Federal City
Slovakia|Bratislava
Slovenia|Western
Spain|Basque Country
Spain|Castilla-La Mancha
Spain|Catalonia Eastern
Spain|Extremadura
Spain|Madrid
Sweden|Stockholm and Mälaren
Switzerland|Romandie
United Kingdom|Cheshire
United Kingdom|England - Greater London
United Kingdom|England Thames Valley and Hampshire
United Kingdom|Northern Ireland
United States|Alabama
United States|Arizona
United States|Arkansas
United States|California
United States|Colorado
United States|Connecticut
United States|Delaware
United States|Florida
United States|Georgia
United States|Hawaii
United States|Illinois
United States|Indiana
United States|Kansas
United States|Kentucky
United States|Louisiana
United States|Maine
United States|Maryland
United States|Massachusetts
United States|Michigan
United States|Minnesota
United States|Mississippi
United States|Missouri
United States|Nebraska
United States|Nevada
United States|New Hampshire
United States|New Jersey
United States|New York
United States|North Carolina
United States|North Dakota
United States|Ohio
United States|Oklahoma
United States|Oregon
United States|Pennsylvania
United States|Rhode Island
United States|Tennessee
United States|Texas
United States|Utah
United States|Vermont
United States|Virginia
United States|Washington
United States|West Virginia
United States|Wisconsin
United States|Wyoming
`.trim();

const rows = rawRows.split('\n').map((line) => {
	const [country, region] = line.split('|');
	return { country, region };
});

const countries = [...new Set(rows.map((row) => row.country))];
const regionCount = rows.length;
const countryWiki: Record<string, string> = {
	'Czechia': 'Czechia',
	'United Kingdom': 'United Kingdom',
	'United States': 'United States',
};

function wiki(title: string) {
	return `https://en.wikipedia.org/wiki/${encodeURIComponent(title.replace(/ /g, '_'))}`;
}

function countryUrl(country: string) {
	return wiki(countryWiki[country] ?? country);
}

function regionUrl(region: string) {
	const regionTitles: Record<string, string> = {
		'South - Carinthia and Styria': 'Styria',
		'South - Zeeland, Limburg, North Brabant': 'North Brabant',
		'England - Greater London': 'London',
		'England Thames Valley and Hampshire': 'Hampshire',
		'Central Bohemia and Prague': 'Central Bohemian Region',
		'Connacht and Ulster': 'Connacht',
		'Kansai': 'Kansai region',
		'Kantō': 'Kantō region',
		'Western': 'Slovenia',
		'Stockholm and Mälaren': 'Mälaren Valley',
	};
	const title = regionTitles[region] ?? region;
	return wiki(title);
}
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${title} | Jack Maguire`} description={description} articlePublished={pubDate} />
	</head>
	<body>
		<Header />
		<main class="travel-page">
			<header class="page-intro">
				<p class="kicker">A personal atlas</p>
				<h1>{title}</h1>
				<p class="lede">Places I’ve visited, kept as a working list rather than a bucket list. Browse by country, or search for a region.</p>
				<div class="stats" aria-label="Travel list statistics">
					<span><strong>{regionCount}</strong> regional entries</span>
				</div>
			</header>

			<section class="controls" aria-label="Travel list controls">
				<label for="region-search">Find a region</label>
				<input id="region-search" type="search" placeholder="Search regions or countries" autocomplete="off" />
				<label for="country-filter" class="sr-only">Filter by country</label>
				<select id="country-filter">
					<option value="all">All countries</option>
					{countries.map((country) => <option value={country}>{country}</option>)}
				</select>
				<p id="result-count" class="result-count" aria-live="polite">Showing all {countries.length} countries</p>
			</section>

			<section class="country-list" aria-label="Visited places">
				{countries.map((country) => {
					const countryRows = rows.filter((row) => row.country === country);
					return (
						<article class="country-section" data-country={country} data-search={`${country} ${countryRows.map((row) => row.region).join(' ')}`.toLowerCase()}>
							<div class="country-heading">
								<h2><a href={countryUrl(country)}>{country}</a></h2>
								<span>{countryRows.length} {countryRows.length === 1 ? 'region' : 'regions'}</span>
							</div>
							<div class="region-list">
								{countryRows.map((row) => (
									<div class="region-row" data-row-search={row.region.toLowerCase()}>
										<div class="region-name"><a href={regionUrl(row.region)}>{row.region}</a></div>
									</div>
								))}
							</div>
						</article>
					);
				})}
			</section>
			<p id="no-results" class="no-results" hidden>No regions match that search.</p>
			<p class="source-note">Country and regional names link to their English Wikipedia entries. City names are intentionally omitted.</p>
		</main>
		<Footer />
		<script>
			const search = document.querySelector('#region-search');
			const filter = document.querySelector('#country-filter');
			const sections = [...document.querySelectorAll('.country-section')];
			const resultCount = document.querySelector('#result-count');
			const noResults = document.querySelector('#no-results');
			function updateList() {
				const query = search.value.trim().toLowerCase();
				const selectedCountry = filter.value;
				let visible = 0;
				sections.forEach((section) => {
					const matchesCountry = selectedCountry === 'all' || section.dataset.country === selectedCountry;
					const matchesSearch = !query || section.dataset.search.includes(query);
					const show = matchesCountry && matchesSearch;
					section.hidden = !show;
					if (show) visible += 1;
				});
				resultCount.textContent = visible === sections.length ? `Showing all ${visible} countries` : `Showing ${visible} ${visible === 1 ? 'country' : 'countries'}`;
				noResults.hidden = visible !== 0;
			}
			search.addEventListener('input', updateList);
			filter.addEventListener('change', updateList);
		</script>
	</body>
</html>

<style>
	.travel-page {
		max-width: 920px;
	}
	.page-intro {
		max-width: 45rem;
		padding: 2.75rem 0 2.25rem;
	}
	.kicker {
		margin: 0 0 0.6rem;
		font-family: var(--font-ui), sans-serif;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--accent-dark);
	}
	.page-intro h1 {
		font-size: clamp(2.4rem, 8vw, 5rem);
		letter-spacing: -0.05em;
		margin: 0 0 0.65rem;
	}
	.lede {
		max-width: 37rem;
		margin: 0;
		font-size: clamp(1.05rem, 2vw, 1.25rem);
		line-height: 1.5;
		color: rgb(var(--gray-dark));
	}
	.stats {
		display: flex;
		flex-wrap: wrap;
		gap: 1.5rem;
		margin-top: 1.5rem;
		font-family: var(--font-ui), sans-serif;
		font-size: 0.75rem;
		letter-spacing: 0.03em;
		text-transform: uppercase;
		color: rgb(var(--gray));
	}
	.stats strong {
		color: var(--accent-dark);
		font-size: 1.15rem;
		margin-right: 0.3rem;
	}
	.controls {
		display: grid;
		grid-template-columns: 1fr 13rem;
		gap: 0.65rem 0.85rem;
		align-items: center;
		padding: 1rem 0;
		margin-bottom: 2.2rem;
		border-top: 1px solid rgba(85, 107, 47, 0.3);
		border-bottom: 1px solid rgba(var(--gray-light), 0.9);
	}
	.controls label {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
	}
	.controls input,
	.controls select {
		box-sizing: border-box;
		min-height: 2.85rem;
		border: 1px solid rgba(var(--gray), 0.38);
		border-radius: 0;
		background: rgba(255, 255, 255, 0.45);
		padding: 0.65rem 0.75rem;
		font: inherit;
		color: rgb(var(--black));
	}
	.controls input:focus,
	.controls select:focus {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
	.result-count {
		grid-column: 1 / -1;
		margin: 0;
		font-size: 0.8rem;
		color: rgb(var(--gray));
	}
	.country-section {
		margin-bottom: 2.6rem;
	}
	.country-heading {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
		border-bottom: 2px solid var(--accent);
		padding-bottom: 0.45rem;
	}
	.country-heading h2 {
		margin: 0;
		font-size: 1.45rem;
		letter-spacing: -0.02em;
	}
	.country-heading h2 a {
		color: rgb(var(--black));
		text-decoration: none;
	}
	.country-heading h2 a:hover {
		color: var(--accent);
	}
	.country-heading > span {
		font-family: var(--font-ui), sans-serif;
		font-size: 0.7rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: rgb(var(--gray));
		white-space: nowrap;
	}
	.region-row {
		display: grid;
		grid-template-columns: 1fr;
		padding: 0.8rem 0;
		border-bottom: 1px solid rgba(var(--gray-light), 0.8);
		font-size: 0.94rem;
	}
	.region-name {
		font-family: var(--font-ui), sans-serif;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: rgb(var(--gray));
	}
	.region-name a {
		color: inherit;
	}
	.no-results {
		padding: 2rem 0;
		font-size: 1.1rem;
	}
	.source-note {
		margin: 3rem 0 1rem;
		border-top: 1px solid rgba(var(--gray-light), 0.9);
		padding-top: 1rem;
		font-size: 0.8rem;
		color: rgb(var(--gray));
	}
	@media (max-width: 650px) {
		.page-intro {
			padding-top: 1.75rem;
		}
		.controls {
			grid-template-columns: 1fr;
		}
		.region-row {
			grid-template-columns: 1fr;
			gap: 0.25rem;
		}
		.country-heading {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.25rem;
		}
	}
</style>
