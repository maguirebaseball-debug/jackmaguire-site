		margin: 0 0 0.25rem;
		font-family: var(--font-ui), sans-serif;
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--accent-dark);
	}
	.continent-map {
		margin: 0 0 2rem;
		border: 1px solid rgba(var(--gray-light), 0.95);
		background: rgb(var(--gray-light));
	}
