---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = 'The parts of Never Split the Difference that are actually useful';
const description = 'The negotiation ideas readers keep coming back to in 18 screened long-form reviews and summaries of Chris Voss’s Never Split the Difference.';
const canonical = 'https://jackmaguire.org/never-split-the-difference';

const insights = [
  ['Name the feeling', 17, 'This is probably the book’s most useful idea. Notice the feeling in the room and say it out loud. You do not have to agree with someone to show that you understand what is bothering them.', 'Ask yourself what this person is trying to protect.', '💛'],
  ['Ask how and what', 16, 'These questions make the other person think through the problem with you. They bring the limits into the open without turning the conversation into a fight.', '“How am I supposed to do that?” puts the constraint on the table.', '❓'],
  ['Repeat the important words', 15, 'Repeat the last few words that matter and then let the silence sit there. People often keep talking, and the useful detail usually comes next.', 'The point is less rapport than information.', '🪞'],
  ['Make no feel safe', 13, 'People are usually more honest when they know they can say no. Giving someone that little bit of control can make the rest of the conversation much less guarded.', 'A safe no can lead to a more honest yes.', '🛑'],
  ['Get to that’s right', 12, 'Agreement is easy to fake. A good summary is harder. Try to describe the other person’s situation so accurately that they recognize it immediately.', 'You are looking for recognition, not compliance.', '🤝'],
  ['Look for the hidden fact', 11, 'The thing that changes the deal might be a private deadline, an internal rule, a fear, or someone else who is not in the room.', 'Keep asking after the obvious answer arrives.', '🔎'],
  ['Say the awkward part first', 10, 'If you already know what the other person is worried about, say it before they have to. The hard part gets easier once it is out in the open.', 'A conversation gets sturdier once the awkward thing has a name.', '😬'],
  ['Slow down', 9, 'Your voice can sound pressuring before your words do. Slow down enough that your urgency does not become someone else’s problem.', 'You are part of the atmosphere.', '🐢'],
  ['Do not split the difference', 9, 'A midpoint can look fair and still leave everyone with the original problem. Ask what the number is actually supposed to solve.', 'Fairness is a frame, not a number.', '⚖️'],
  ['Check the deal three ways', 8, 'Ask for confirmation in a couple of different ways. This catches the polite agreement that never became a real commitment.', 'A deal is still abstract until the other person can explain it back.', '✅'],
  ['Plan your concessions', 7, 'A planned series of smaller offers keeps you from improvising your way past your own limit.', 'Preparation makes restraint easier.', '📉'],
  ['Set the frame early', 7, 'The first serious number changes what people consider reasonable, especially when nobody knows the exact value yet.', 'The frame arrives before the arithmetic.', '🖼️'],
  ['Question the deadline', 6, 'A deadline may be real, invented, or just useful pressure. Test it before letting it make the decision for you.', 'Urgency deserves a question first.', '⏰'],
  ['Use styles as rough clues', 5, 'The book’s style categories can help you notice patterns. They stop being useful when you start treating them like diagnoses.', 'A style model is a lens, not a label.', '🕶️'],
  ['Prepare the one sheet', 5, 'Write down the goal, the limit, the likely objections, and the questions you want to ask. It is much easier than trying to invent all of that while you are nervous.', 'The conversation starts before the conversation.', '📝'],
  ['Keep the ethics visible', 4, 'These tools can help someone speak honestly, or they can push someone toward a choice they do not want. The difference is whether they still have a real way out.', 'Technique without judgment is pressure with better vocabulary.', '🧭'],
];

const sources = [
  ['SuperSummary', 'https://www.supersummary.com/never-split-the-difference/summary/'],
  ['Hasty Reader', 'https://hastyreader.com/never-split-the-difference-book-summary/'],
  ['Mark Whelan', 'https://www.markmwhelan.com/never-split-the-difference-book-review/'],
  ['Center for Understanding in Conflict', 'https://understandinginconflict.org/never-split-the-difference-by-chris-voss-and-tahl-raz/'],
];

const faceSvg = (glyph: string) => `<svg viewBox="0 0 144 144" role="img" aria-label="${glyph} marker"><circle cx="72" cy="72" r="65" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="72" cy="72" r="57" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="3 5"/><path d="M72 12v14M72 118v14M12 72h14M118 72h14M29.6 29.6l9.9 9.9M104.5 104.5l9.9 9.9M114.4 29.6l-9.9 9.9M39.5 104.5l-9.9 9.9" stroke="currentColor" stroke-width="2"/><circle cx="72" cy="72" r="37" fill="none" stroke="currentColor" stroke-width="3"/><text x="72" y="84" text-anchor="middle">${glyph}</text></svg>`;
---

<BaseHead {title} {description} canonical={canonical} />
<Header />
<main class="research-page">
  <div class="navline"><span>FIELD NOTES / NEGOTIATION</span><span>18 QUALIFYING SOURCES</span></div>
  <section class="mast">
    <div>
      <h1>The parts of <i>Never Split the Difference</i> that are actually useful</h1>
      <p class="lede">I went through the longer reviews to see which ideas people kept bringing up. Here they are, from most common to least.</p>
    </div>
    <div class="stamp">18<small>screened<br />sources</small></div>
  </section>

  <section class="intro"><p>I screened 18 long-form reviews and summaries, removing duplicates and short pages. So that is the denominator. The counts show how often a source called an idea useful. They do not prove that it works every time.</p></section>

  <section class="grid" aria-label="Ranked negotiation insights">
    {insights.map(([name, count, body, thought, glyph], index) => (
      <article class="insight" style={`--rank:${index}`}>
        <div class="face" set:html={faceSvg(glyph as string)}></div>
        <div class="copy">
          <div class="top"><h2>{name}</h2><strong>{count}<small>/18</small></strong></div>
          <div class="bar" aria-hidden="true"><span style={`width:${(Number(count) / 18) * 100}%`}></span></div>
          <p>{body}</p>
          <blockquote>{thought}</blockquote>
        </div>
      </article>
    ))}
  </section>

  <section class="sources">
    <h2>The pattern</h2>
    <p>The ideas near the top all help you learn something. Name the feeling. Ask about the constraint. Repeat the important words. Keep listening after the first explanation.</p>
    <p>I grouped together ideas that are basically doing the same job. Tactical empathy, emotional labeling, and making the other person feel heard count as one family here.</p>
    <h2 class="source-title">A few of the source pages</h2>
    <ul>{sources.map(([name, url]) => <li><a href={url} rel="noopener noreferrer">{name}</a></li>)}</ul>
  </section>
</main>
<Footer />

<style>
  @import url('https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600&family=Space+Mono:wght@400;700&display=swap');
  :global(body){background:#f5f5ef;color:#11152b}
  .research-page{max-width:1180px;margin:0 auto;padding:clamp(24px,6vw,80px) clamp(16px,4vw,56px) 56px;font-family:'Space Mono',monospace}
  .navline{display:flex;justify-content:space-between;border-bottom:1px solid #11152b;padding-bottom:16px;margin-bottom:44px;font-size:11px;letter-spacing:.05em;color:#5d637a}
  .mast{display:grid;grid-template-columns:1fr auto;gap:30px;align-items:end;border-bottom:1px solid #d8dbe6;padding-bottom:30px}
  h1,h2,.lede,.intro{font-family:'Bricolage Grotesque',sans-serif}
  h1{font-size:clamp(42px,6.3vw,84px);font-weight:400;line-height:.95;letter-spacing:-.045em;max-width:850px;margin:0}
  .lede{font-size:clamp(20px,2.1vw,28px);line-height:1.2;max-width:750px;margin:30px 0 0}
  .stamp{display:grid;place-items:center;text-align:center;width:128px;height:128px;border:2px solid #11152b;border-radius:50%;background:#ceff3e;font-size:40px;font-weight:700;line-height:.9;transform:rotate(7deg)}
  .stamp small{font-size:10px;line-height:1.25;text-transform:uppercase;letter-spacing:.08em}
  .intro{max-width:700px;font-size:18px;line-height:1.35;margin:30px 0 52px}
  .grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
  .insight{background:#fffef9;border:1px solid #d8dbe6;padding:18px;display:grid;grid-template-columns:150px 1fr;gap:14px;min-height:245px;animation:rise .55s both;animation-delay:calc(var(--rank) * 35ms)}
  .face{width:144px;height:144px;color:#5965ff}.face :global(svg){width:144px;height:144px}.face :global(text){font:700 29px 'Apple Color Emoji','Segoe UI Emoji','Noto Color Emoji',sans-serif}
  .top{display:flex;justify-content:space-between;gap:12px;align-items:start}.top h2{font-size:22px;line-height:1.02;font-weight:400;margin:0}.top strong{color:#5965ff;font-size:18px;white-space:nowrap}.top small{font-size:10px;color:#5d637a;font-weight:400}
  .bar{height:5px;background:#e5e7ef;margin:14px 0 12px}.bar span{display:block;height:100%;background:#5965ff}
  .copy p{font-family:Verdana,Tahoma,sans-serif;font-size:14px;line-height:1.42;color:#3b425b;margin:0 0 12px}.copy blockquote{font-family:'Bricolage Grotesque',sans-serif;font-size:16px;line-height:1.25;border-left:1px solid #5965ff;padding:0 0 0 10px;margin:0;color:#11152b}
  .sources{border-top:1px solid #d8dbe6;margin-top:64px;padding-top:26px;max-width:760px}.sources h2{font-size:30px;font-weight:400;margin:0 0 14px}.sources p{font-family:Verdana,Tahoma,sans-serif;font-size:15px;line-height:1.5;color:#3b425b}.source-title{margin-top:34px!important}.sources ul{display:flex;flex-wrap:wrap;gap:8px 20px;padding:0;list-style:none;font-size:12px}.sources a{color:#11152b;text-decoration:underline;text-underline-offset:3px}
  @keyframes rise{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
  @media(max-width:900px){.insight{grid-template-columns:100px 1fr}.face,.face :global(svg){width:96px;height:96px}.face :global(text){font-size:22px}}
  @media(max-width:760px){.navline{gap:16px;line-height:1.35}.mast{grid-template-columns:1fr}.stamp{width:92px;height:92px;font-size:30px;margin-top:8px}.grid{grid-template-columns:1fr}.insight{min-height:0}.intro{margin-bottom:34px}}
  @media(max-width:500px){.navline{font-size:9px;margin-bottom:30px}.mast{padding-bottom:22px}.mast h1{font-size:clamp(39px,12vw,58px);line-height:.98}.lede{font-size:21px;line-height:1.18;margin-top:20px}.intro{font-size:17px;line-height:1.38;margin:24px 0 30px}.insight{grid-template-columns:1fr;padding:16px;gap:4px}.face{margin-bottom:4px}.top{gap:8px}.top h2{font-size:20px;line-height:1.05}.top strong{font-size:16px}.copy p{font-size:15px;line-height:1.42;margin-bottom:12px}.copy blockquote{font-size:17px;line-height:1.22}.sources{margin-top:46px;padding-top:22px}.sources h2{font-size:28px}.sources p{font-size:15px}.sources ul{display:block;line-height:2.2}}
  @media(prefers-reduced-motion:reduce){.insight{animation:none}}
</style>
