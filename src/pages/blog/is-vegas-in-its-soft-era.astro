        border-bottom: 1px solid var(--vegas-line);
        border-left: 5px solid var(--vegas-pink);
        font-family: var(--font-heading);
        font-size: clamp(1.35rem, 2.5vw, 1.85rem);
        line-height: 1.35;
      }

