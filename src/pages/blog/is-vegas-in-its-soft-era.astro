      .signal-row {
        display: grid;
        grid-template-columns: minmax(160px, 240px) 1fr 74px;
        gap: 0.85rem;
        align-items: center;
        min-height: 2rem;
      }

      .signal-row[hidden] {
        display: none;
      }

      .signal-name {
        font-size: 0.83rem;
        line-height: 1.2;
      }

      .bar-track {
        position: relative;
        height: 0.8rem;
        background: #eee9df;
      }

      .bar {
        height: 100%;
        min-width: 2px;
        width: min(calc(var(--value) * 0.36%), 100%);
