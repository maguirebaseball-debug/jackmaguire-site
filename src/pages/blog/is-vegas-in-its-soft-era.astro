        }

        .content-grid {
          gap: 2.5rem;
        }

        .side-rail {
          position: static;
        }

        .scorecard {
          display: grid;
          grid-template-columns: repeat(2, 1fr);
        }

        .scorecard-title {
          grid-column: 1 / -1;
        }

        .score:nth-last-child(2) {
