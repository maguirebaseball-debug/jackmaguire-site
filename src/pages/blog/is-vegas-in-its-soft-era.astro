      .prose ul,
      .prose ol {
        max-width: 680px;
      }

      .prose p {
        margin: 0 0 1.25rem;
        font-family: Charter, 'Bitstream Charter', 'Sitka Text', Cambria, 'Times New Roman', Times, serif;
        font-size: 1.12rem;
        line-height: 1.68;
      }

      .prose h2 {
        margin: 3.2rem 0 1rem;
        font-size: clamp(1.75rem, 3vw, 2.45rem);
        letter-spacing: -0.025em;
      }

      .prose h2:first-of-type {
        margin-top: 0;
      }

      .prose h3 {
        margin: 2.2rem 0 0.75rem;
        font-size: 1.25rem;
        color: var(--vegas-blue);
      }

      .pullquote {
        margin: 2.25rem 0;
        padding: 1.4rem 0 1.4rem 1.35rem;
