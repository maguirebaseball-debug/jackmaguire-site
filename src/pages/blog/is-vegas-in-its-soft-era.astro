---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import ReadingProgressBar from '../../components/ReadingProgressBar.astro';
import { PERSON_ID } from '../../consts';

const title = "Is Vegas in Its Soft Era?";
const description = "A 125-term Google Trends audit finds coffee, spas, fitness, and sober events rising without a broad decline in Las Vegas clubs or drinking.";
const pubDate = "Aug 3, 2026";
const category = "Travel";
const dateObj = new Date("2026-08-03T12:00:00Z");

const signals = [
  { label: 'Best coffee Las Vegas', value: 261, group: 'soft', qualifier: 'strong, lower base' },
  { label: 'Las Vegas nightlife', value: 245, group: 'party', qualifier: 'strong, lower base' },
  { label: 'Las Vegas cocktails', value: 81, group: 'party', qualifier: 'reliable' },
  { label: 'Vegas day party', value: 58, group: 'party', qualifier: 'reliable' },
  { label: 'Las Vegas hiking', value: 58, group: 'soft', qualifier: 'reliable' },
  { label: 'Las Vegas Pilates', value: 37, group: 'soft', qualifier: 'reliable' },
  { label: 'Las Vegas bars', value: 33, group: 'party', qualifier: 'reliable' },
  { label: 'Gluten free Las Vegas', value: 30, group: 'soft', qualifier: 'reliable' },
  { label: 'XS Las Vegas', value: 25, group: 'party', qualifier: 'reliable' },
  { label: 'Las Vegas happy hour', value: 24, group: 'party', qualifier: 'reliable' },
  { label: 'Las Vegas massage', value: 24, group: 'soft', qualifier: 'reliable' },
  { label: 'OMNIA Las Vegas', value: 24, group: 'party', qualifier: 'reliable' },
  { label: 'Vegan Las Vegas', value: 21, group: 'soft', qualifier: 'reliable' },
  { label: 'Wynn Las Vegas spa', value: 16, group: 'soft', qualifier: 'reliable' },
  { label: 'Las Vegas hotels', value: 12, group: 'control', qualifier: 'tourism control' },
  { label: 'Zouk Las Vegas', value: -8, group: 'party', qualifier: 'reliable' },
];

const searchGroups = [
  ['Major clubs', 'XS, OMNIA, Marquee, LIV, Zouk'],
  ['Dayclubs', 'Encore Beach Club, TAO Beach, Wet Republic, Palm Tree Beach Club, Ayu'],
  ['Party intent', 'nightlife, best clubs, party packages, day parties, afterparties'],
  ['Alcohol', 'cocktails, bars, happy hour, breweries, wine bars'],
  ['Boozy activities', 'pub crawls, pool-party tickets, bottle-service prices, bottomless mimosas, drinking games'],
  ['Low and no alcohol', 'mocktails, nonalcoholic Vegas, alcohol-free Vegas, sober activities, sober nightlife'],
  ['Wellness', 'retreats, wellness hotels, wellness weekends, self-care, holistic Vegas'],
  ['Yoga formats', 'classes, rooftop yoga, poolside yoga, retreats, festivals'],
  ['Recovery', 'recovery spas, IV therapy, hydration, massage, saunas'],
  ['Contrast therapy', 'cold plunges, cryotherapy, infrared saunas, breathwork, sound healing'],
  ['Fitness', 'fitness classes, Pilates, run clubs, spin, hiking'],
  ['Coffee', 'best coffee, specialty coffee, coffee parties, coffee festivals, coffee DJs'],
  ['Healthy drinks', 'matcha cafes, juice cleanses, smoothie bars, tea houses, kombucha'],
  ['Healthy food', 'healthy brunch, vegan, plant-based, organic, gluten-free'],
  ['Daytime social life', 'morning events, daytime events, early parties, sober dance parties, daytime raves'],
  ['Soft-clubbing language', 'soft clubbing, wellness raves, yoga raves, sober raves, conscious dance'],
  ['Alternative social life', 'sound-bath events, ecstatic dance, dance meditation, community wellness, wellness social clubs'],
  ['Resort spas', 'Wynn, Caesars Palace, Cosmopolitan, Fontainebleau, Resorts World'],
  ['Venue wellness', 'AREA15 wellness, AREA15 yoga, OMNIA yoga, Marquee yoga, XS yoga'],
  ['Tourism controls', 'things to do, vacations, hotels, restaurants, events'],
];
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} articlePublished="2026-08-03" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: title,
      description,
      url: Astro.url.href,
      mainEntityOfPage: { '@type': 'WebPage', '@id': Astro.url.href },
      image: new URL('/og-default.png', Astro.site).toString(),
      author: { '@id': PERSON_ID },
      publisher: { '@id': PERSON_ID },
      datePublished: '2026-08-03',
      dateModified: '2026-08-03',
    })} />
    <style>
      :root {
        --vegas-ink: #171528;
        --vegas-cream: #fff9ec;
        --vegas-pink: #eb3f67;
        --vegas-pink-dark: #a91f43;
        --vegas-blue: #214d9a;
        --vegas-mint: #8dc8ad;
        --vegas-lime: #d9e781;
        --vegas-line: rgba(23, 21, 40, 0.18);
      }

      body {
        background: #f2ecdf;
        color: var(--vegas-ink);
      }

      main {
        max-width: none;
        padding: 0;
      }

      .article {
        overflow: hidden;
      }

      .hero {
        position: relative;
        background:
          linear-gradient(125deg, rgba(235, 63, 103, 0.14), transparent 45%),
          repeating-linear-gradient(90deg, transparent 0 39px, rgba(23, 21, 40, 0.035) 39px 40px),
          var(--vegas-cream);
        border-bottom: 1px solid var(--vegas-line);
      }

      .hero-inner,
      .content-grid,
      .wide-section,
      .article-footer {
        width: min(1180px, calc(100% - 2rem));
        margin: 0 auto;
      }

      .hero-inner {
        padding: clamp(3rem, 8vw, 7rem) 0 3.25rem;
      }

      .eyebrow {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        margin: 0 0 1.25rem;
        font-family: var(--font-ui);
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.13em;
        text-transform: uppercase;
      }

      .eyebrow::before {
        content: '';
        width: 2.25rem;
        height: 3px;
        background: var(--vegas-pink);
      }

      h1 {
        max-width: 980px;
        margin: 0;
        font-size: clamp(3.2rem, 10vw, 8.4rem);
        line-height: 0.9;
        letter-spacing: -0.065em;
        text-wrap: balance;
      }

      h1 .soft {
        color: var(--vegas-pink);
        font-family: 'Caveat', cursive;
        font-weight: 500;
        letter-spacing: -0.03em;
      }

      .hero-bottom {
        display: grid;
        grid-template-columns: minmax(0, 1.6fr) minmax(250px, 0.7fr);
        gap: 2.5rem;
        align-items: end;
        margin-top: 2.25rem;
      }

      .dek {
        max-width: 720px;
        margin: 0;
        font-size: clamp(1.15rem, 2vw, 1.45rem);
        line-height: 1.55;
        color: rgba(23, 21, 40, 0.82);
      }

      .meta {
        margin: 0;
        padding-top: 0.75rem;
        border-top: 1px solid var(--vegas-line);
        font-family: var(--font-ui);
        font-size: 0.78rem;
        line-height: 1.55;
        color: rgba(23, 21, 40, 0.62);
      }

      .verdict-strip {
        background: var(--vegas-ink);
        color: #fff;
      }

      .verdict-strip .wide-section {
        display: grid;
        grid-template-columns: 190px 1fr;
        gap: 2rem;
        padding-top: 1.5rem;
        padding-bottom: 1.6rem;
      }

      .verdict-label {
        margin: 0;
        color: var(--vegas-lime);
        font-family: var(--font-ui);
        font-size: 0.72rem;
        font-weight: 700;
