        padding: 4rem 0;
        background: #fff;
        border-top: 1px solid var(--vegas-line);
        border-bottom: 1px solid var(--vegas-line);
      }

      .section-kicker {
        margin: 0 0 0.5rem;
        font-family: var(--font-ui);
        color: var(--vegas-pink-dark);
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

