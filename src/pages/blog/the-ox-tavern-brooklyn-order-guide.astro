---
import PlainStandaloneBlog from '../../layouts/PlainStandaloneBlog.astro';

const title = "What to order at The Ox Tavern in Brooklyn";
const description = "A three-dish order for two people at The Ox Tavern in Ditmas Park, with the few modifications that are worth asking for.";
const pubDate = "August 20, 2026";
---

<PlainStandaloneBlog
	title={title}
	description={description}
	pubDate={pubDate}
	datePublished="2026-08-20"
>
	<p>
		For two people, order:
	</p>

	<ol>
		<li>Crispy Brussels sprouts, with the chipotle mayo on the side.</li>
		<li>Good Ol' Boy burger, medium rare and cut in half, with the fries extra crispy.</li>
		<li>Quesabirria tacos with the consommé.</li>
	</ol>

	<p>
		Ask for a side of chimichurri if it is available. Dip the fries in the consommé, then the
		chimichurri. The food total is about $51 before tax and tip.
	</p>
</PlainStandaloneBlog>
