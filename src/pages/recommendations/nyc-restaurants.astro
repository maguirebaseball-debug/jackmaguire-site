---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import restaurants from '../../data/nyc-low-review-restaurants.json';

const pageTitle = `NYC restaurants with high ratings and low review counts | ${SITE_TITLE}`;
const pageDescription = 'A small Google Maps list of New York restaurants with high ratings and relatively few reviews.';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
	</head>
	<body>
		<Header />
		<main class="geo-page">
			<h1>My NYC Fall 2026 picks (research purposes only)</h1>
			<p class="quick-note">every couple months, I spend time researching New York restaurants, trying to find places that have a really low review count and still look pretty good, with a rating over 4.5 on Google. That's just my theory for what makes for a spot that has blown up on social media yet also has drawn enough interest that it's probably pretty good. It's definitely not a perfect system.</p>

			<div class="table-wrap">
				<table>
					<thead>
						<tr>
							<th>Restaurant</th>
							<th>Cuisine</th>
							<th>Neighborhood</th>
							<th>Borough</th>
							<th>Google</th>
							<th>Website</th>
						</tr>
					</thead>
					<tbody>
						{restaurants.map((restaurant) => (
							<tr>
								<td><a href={restaurant.mapsUrl} target="_blank" rel="noopener">{restaurant.name}</a></td>
								<td>{restaurant.cuisine}</td>
								<td>{restaurant.neighborhood}</td>
								<td>{restaurant.borough}</td>
								<td>{restaurant.rating.toFixed(1)} stars, {restaurant.reviewCount.toLocaleString()} reviews</td>
								<td>
									<a href={restaurant.website || restaurant.mapsUrl} target="_blank" rel="noopener">
										{restaurant.website ? 'Website' : 'Google Maps'}
									</a>
								</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
			<p class="maps-list-link"><a href="https://maps.app.goo.gl/yHTNWZyytMBcuEd59" target="_blank" rel="noopener">see this list on google maps</a></p>
		</main>
		<Footer />
	</body>
</html>

<style>
	:global(body) {
		background: #c0c0c0;
	}
	.geo-page {
		max-width: 1120px;
		margin: 1.5rem auto 3rem;
		padding: 1.25rem;
		background: #ffffff;
		border: 4px ridge #666666;
		color: #000000;
		font-family: "Times New Roman", Times, serif;
	}
	.geo-page h1 {
		margin: 0 0 1rem;
		color: #000080;
		font-size: 2rem;
		text-align: center;
		text-shadow: 2px 2px #ffff00;
	}
	.quick-note {
		margin: 0 0 1.5rem;
		padding: 1rem;
		border: 2px dashed #ff0000;
		background: #ffffcc;
		font-size: 1.05rem;
		line-height: 1.45;
	}
	.table-wrap {
		overflow-x: auto;
	}
	.maps-list-link {
		margin: 1.5rem 0 0;
	}
	table {
		width: 100%;
		border-collapse: collapse;
		font-size: 1rem;
	}
	th {
		padding: 0.6rem;
		border: 2px outset #dddddd;
		background: #000080;
		color: #ffffff;
		text-align: left;
	}
	td {
		padding: 0.6rem;
		border: 1px solid #000000;
		vertical-align: top;
	}
	tr:nth-child(even) {
		background: #e6e6ff;
	}
	a {
		color: #0000ee;
	}
	a:visited {
		color: #800080;
	}
	@media (max-width: 720px) {
		.geo-page {
			margin: 0.5rem;
			padding: 0.75rem;
		}
		.geo-page h1 {
			font-size: 1.6rem;
		}
		table {
			font-size: 0.9rem;
		}
		th,
		td {
			padding: 0.45rem;
		}
	}
</style>
