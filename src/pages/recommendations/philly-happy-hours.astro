---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Philadelphia Happy Hours 2026: Booze and Appetizer Deals | ${SITE_TITLE}`} description={description} />
		<script type="application/ld+json" set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'ItemList',
			name: 'Philadelphia happy hours 2026',
			description,
			itemListElement: deals.map((deal, index) => ({
				'@type': 'ListItem', position: index + 1, name: deal.venue,
			})),
		})} />
		<style>
			:global(html) { background: #fff; }
			:global(body) {
				background: #fff;
				color: #111;
				font-family: Arial, Helvetica, sans-serif;
				font-size: 16px;
				line-height: 1.45;
				margin: 0;
			}
			main {
				box-sizing: border-box;
				max-width: 1500px;
				margin: 0 auto;
				padding: 32px 24px 56px;
			}
			h1, h2 { font-family: Arial, Helvetica, sans-serif; font-weight: 400; color: #111; }
			h1 { font-size: 30px; margin: 0 0 10px; }
			h2 { font-size: 22px; margin: 36px 0 10px; }
			.intro, .last-checked, .seasonal { max-width: 900px; }
			.intro { margin: 0 0 8px; }
			.last-checked { color: #444; font-size: 14px; margin: 0 0 28px; }
			.table-wrap { overflow-x: auto; margin: 0 0 28px; }
			table { border-collapse: collapse; min-width: 1180px; width: 100%; }
			th, td { border: 1px solid #999; padding: 10px; text-align: left; vertical-align: top; }
			th { background: #f4f4f4; font-weight: 700; }
			.venue { min-width: 150px; }
			.hours { min-width: 145px; }
			.drinks { min-width: 220px; }
			.food { min-width: 260px; }
			.stipulations { min-width: 230px; }
			.cell-text { margin: 0; white-space: pre-line; }
			.address { color: #444; font-size: 14px; margin-top: 6px; }
			.links { margin-top: 8px; white-space: nowrap; }
			.links a { margin-right: 8px; }
			.photo { margin: 10px 0 0; width: 150px; }
			.photo img { display: block; height: auto; max-width: 150px; }
			.photo figcaption { color: #444; font-size: 12px; margin-top: 3px; }
			.seasonal { border-top: 1px solid #999; border-bottom: 1px solid #999; padding: 12px 0; }
			.seasonal p { margin: 0 0 8px; }
			.seasonal p:last-child { margin-bottom: 0; }
			@media (max-width: 600px) {
				main { padding: 24px 12px 40px; }
				h1 { font-size: 26px; }
				.table-wrap { overflow: visible; }
				table { min-width: 0; width: 100%; }
				thead { display: none; }
				tbody, tr, td { display: block; }
				tbody tr { border: 1px solid #999; margin: 0 0 16px; }
				td { border: 0; border-bottom: 1px solid #ccc; padding: 9px 10px; }
				td:last-child { border-bottom: 0; }
				td::before {
					content: attr(data-label);
					display: block;
					font-weight: 700;
					margin-bottom: 3px;
				}
				td.venue::before { display: none; }
				.links { white-space: normal; }
				.photo, .photo img { max-width: 100%; }
			}
		</style>
	</head>
	<body>
		<main>
			<h1>Philadelphia happy hours in 2026</h1>
			<p class="intro">Drink and appetizer deals, organized by neighborhood. Prices and hours were checked September 3, 2026. Every venue row below has a Google Maps listing that did not show a permanent or temporary closure notice when checked.</p>
			<p class="last-checked">Deals can change without notice. Open the venue menu before leaving, especially for seasonal menus, patio-only service, and the rows marked for confirmation.</p>

			{neighborhoods.map((neighborhood) => (
				<section aria-labelledby={`${neighborhood.toLowerCase().replace(/[^a-z0-9]+/g, '-')}-heading`}>
					<h2 id={`${neighborhood.toLowerCase().replace(/[^a-z0-9]+/g, '-')}-heading`}>{neighborhood}</h2>
					<div class="table-wrap">
						<table>
							<thead>
								<tr>
									<th class="venue">Venue</th>
									<th class="hours">Deal hours</th>
									<th class="drinks">Booze and prices</th>
									<th class="food">Appetizers and food prices</th>
									<th class="stipulations">Stipulations</th>
									<th>Links and photo</th>
								</tr>
							</thead>
							<tbody>
								{deals.filter((deal) => deal.neighborhood === neighborhood).map((deal) => (
									<tr>
										<td class="venue" data-label="Venue">
											<strong>{deal.venue}</strong>
											<div class="address">{deal.address}</div>
										</td>
										<td data-label="Deal hours"><p class="cell-text">{deal.hours}</p></td>
										<td data-label="Booze and prices"><p class="cell-text">{deal.drinks}</p></td>
										<td data-label="Appetizers and food prices"><p class="cell-text">{deal.food}</p></td>
										<td data-label="Stipulations"><p class="cell-text">{deal.stipulations}</p></td>
										<td data-label="Links and photo">
											<div class="links"><a href={deal.website}>Venue</a><a href={mapsUrl(deal.query)}>Google Maps</a></div>
											{deal.photo && (
												<figure class="photo">
													<img src={deal.photo} alt={`Exterior storefront of ${deal.venue}`} loading="lazy" />
													<figcaption><a href={deal.photoSource}>Venue exterior photo</a></figcaption>
												</figure>
											)}
										</td>
									</tr>
								))}
							</tbody>
						</table>
					</div>
				</section>
			))}

			<h2>Seasonal program</h2>
			<div class="seasonal">
				<p><a href="https://fishtowndistrict.com/events/fishtown-taps/">Fishtown TAPS</a> runs every Tuesday from 5-7pm through September 29, 2026. The program lists $5 beer, $6 wine, $7 cocktails, and appetizer specials at participating stops. Individual stops and specials can change, so use the program page for the current crawl.</p>
				<p>The program is separate from the regular venue deals above. It is a good way to combine Fishtown stops such as LMNO, Frankford Hall, Barcade, The International, and Lloyd when they are participating.</p>
			</div>
		</main>
	</body>
</html>
