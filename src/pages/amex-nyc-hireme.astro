---
const title = 'Jack Maguire for Amex Business Social Execution';
const description = 'A private candidacy page for Jack Maguire and the American Express Senior Analyst, Social Execution and Channel Management role in New York.';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex" />
		<meta name="googlebot" content="noindex, nofollow, noarchive, nosnippet, noimageindex" />
		<meta name="bingbot" content="noindex, nofollow, noarchive, nosnippet, noimageindex" />
		<meta name="referrer" content="no-referrer" />
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<link rel="canonical" href="https://jackmaguire.org/amex-nyc-hireme/" />
	</head>
	<body>
		<main>
			<section class="hero" aria-labelledby="page-title">
				<div class="hero-copy">
					<p class="kicker">Private note for American Express Business</p>
					<h1 id="page-title">A social channel operator for Amex Business priorities.</h1>
					<p class="deck">
						I am Jack Maguire, a New York social media and digital marketing leader with
						12+ years across channel execution, approvals, community, agency workflows,
						and reporting. This page maps my experience to the Senior Analyst, Social
						Execution and Channel Management role.
					</p>
					<div class="quick-proof" aria-label="Career proof points">
						<div><strong>12+</strong><span>years in social and digital marketing</span></div>
						<div><strong>$30M+</strong><span>managed social media spend</span></div>
						<div><strong>30x</strong><span>brand social presence growth</span></div>
						<div><strong>600+</strong><span>business owners advised on social strategy</span></div>
					</div>
				</div>
				<aside class="hero-card" aria-label="Candidate summary">
					<img src="/images/about/jack-professional-portrait.jpg" alt="Jack Maguire in New York City" width="732" height="790" />
					<div class="candidate-card">
						<p>Jack Maguire</p>
						<span>New York, New York</span>
						<a href="mailto:jpmaguire2@gmail.com">jpmaguire2@gmail.com</a>
						<a href="https://www.linkedin.com/in/jackmaguire-paidsocial-nyc/">LinkedIn profile</a>
					</div>
				</aside>
			</section>

			<section class="fit-strip" aria-label="Role fit areas">
				<span>Publishing workflows</span>
				<span>Feed curation</span>
				<span>Community management</span>
				<span>Approval governance</span>
				<span>Agency coordination</span>
				<span>Performance insights</span>
			</section>

			<section class="section-grid" aria-labelledby="why-title">
				<div class="section-label">01 / Why this maps</div>
				<div>
					<h2 id="why-title">The job is really about dependable social execution inside a large system.</h2>
					<p>
						That is the overlap. I have managed social channels directly, advised large
						business networks on organic and paid social, coordinated national agency
						workflows, and operated inside regulated approval systems where brand,
						compliance, timing, and business outcomes all mattered.
					</p>
					<div class="map-grid">
						<article>
							<h3>Organic channel grounding</h3>
							<p>Ascension and Visiting Angels supply the direct organic social experience: Facebook, Instagram, community engagement, brand voice, editorial priorities, and business-owner education.</p>
						</article>
						<article>
							<h3>Enterprise operating rhythm</h3>
							<p>National Debt Relief supplies the cross-functional operating muscle: approvals, governance, compliance, reporting, creative feedback, and matrixed launch support.</p>
						</article>
						<article>
							<h3>Agency and campaign execution</h3>
							<p>Good Apple supplies the national agency execution layer: weekly creative rotations, pacing, influencer work, stakeholder reporting, and team coordination across 17,000 retail locations.</p>
						</article>
					</div>
				</div>
			</section>

			<section class="section-grid blue-block" aria-labelledby="role-title">
				<div class="section-label">02 / Role requirements</div>
				<div>
					<h2 id="role-title">What I would bring to Amex Business social.</h2>
					<div class="requirements">
						<div>
							<span>Channel management</span>
							<p>Facebook, Instagram, LinkedIn, TikTok, YouTube, Hootsuite, Sprout Social, Sprinklr, and Meta Business Suite experience.</p>
						</div>
						<div>
							<span>Content pacing and approvals</span>
							<p>Creative rotations, campaign launch coordination, social media playbooks, governance, escalation policies, and compliance review workflows.</p>
						</div>
						<div>
							<span>Cross-functional work</span>
							<p>Experience with Creative, Brand, Sales, lifecycle, Analytics, Engineering, Finance, legal, compliance, agencies, and platform partners.</p>
						</div>
						<div>
							<span>Reporting and optimization</span>
							<p>BI dashboards, KPI frameworks, audience behavior analysis, performance recommendations, competitive monitoring, and trend translation.</p>
						</div>
					</div>
				</div>
			</section>

			<section class="section-grid" aria-labelledby="proof-title">
				<div class="section-label">03 / Evidence</div>
				<div>
					<h2 id="proof-title">A few relevant career receipts.</h2>
					<div class="timeline">
						<article>
							<p>2023 to 2026</p>
							<h3>National Debt Relief</h3>
							<span>Social Media Marketing Director</span>
							<ul>
								<li>Coordinated campaign execution across Creative, Brand, Sales, lifecycle, Analytics, Engineering, Finance, agencies, legal, and compliance.</li>
								<li>Created playbooks, governance, and escalation policies for clearer social execution standards.</li>
								<li>Built reporting systems that translated performance data into audience, content, and channel recommendations.</li>
							</ul>
						</article>
						<article>
							<p>2021 to 2022</p>
							<h3>Good Apple</h3>
							<span>Lead Senior Paid Social Media Marketing Strategist, Dollar General</span>
							<ul>
								<li>Led three social managers supporting Dollar General and pOpshelf across 17,000 retail locations.</li>
								<li>Managed weekly creative rotations, influencer campaigns, agency workflows, pacing, and stakeholder reporting.</li>
							</ul>
						</article>
						<article>
							<p>2019 to 2021</p>
							<h3>Visiting Angels</h3>
							<span>Lead Paid Social Media Marketing Strategist</span>
							<ul>
								<li>Advised 600+ business owners on paid and organic social strategy across a 500+ office franchise network.</li>
								<li>Managed national Facebook and Instagram social campaigns serving local-market priorities.</li>
							</ul>
						</article>
						<article>
							<p>2014 to 2019</p>
							<h3>Ascension</h3>
							<span>Lead Paid Social Media Marketing Manager</span>
							<ul>
								<li>Managed Facebook and Instagram pages, community engagement, brand voice, social listening, and publishing priorities.</li>
								<li>Grew social presence 30x and used content performance data to recommend channel improvements.</li>
							</ul>
						</article>
					</div>
				</div>
			</section>

			<section class="closing" aria-labelledby="closing-title">
				<p class="kicker">Bottom line</p>
				<h2 id="closing-title">I can keep the social machine moving without losing the business context.</h2>
				<p>
					The role needs someone organized enough to manage publishing, reviews, partners,
					and timelines, but analytical enough to turn performance signals into better
					channel choices. That is the exact overlap I would bring to Amex Business.
				</p>
				<a href="mailto:jpmaguire2@gmail.com">Contact Jack</a>
			</section>
		</main>
	</body>
</html>

<style>
	:root {
		--amex-blue: #006fcf;
		--amex-deep: #00175a;
		--amex-ink: #111827;
		--amex-muted: #5d6677;
		--amex-line: #d7e3f4;
		--amex-pale: #f4f8ff;
		--amex-paper: #ffffff;
	}

	* {
		box-sizing: border-box;
	}

	body {
		margin: 0;
		background: var(--amex-paper);
		color: var(--amex-ink);
		font-family: "Benton Sans", "Helvetica Neue", Arial, sans-serif;
		line-height: 1.5;
	}

	a {
		color: var(--amex-blue);
		text-underline-offset: 0.18em;
	}

	main {
		width: min(1180px, calc(100% - 32px));
		margin: 0 auto;
		padding: 28px 0 64px;
	}

	.hero {
		min-height: 92vh;
		display: grid;
		grid-template-columns: minmax(0, 1.35fr) minmax(300px, 0.75fr);
		gap: clamp(32px, 6vw, 78px);
		align-items: center;
		border-bottom: 1px solid var(--amex-line);
	}

	.kicker,
	.section-label,
	.fit-strip,
	.candidate-card span,
	.timeline article > p,
	.requirements span {
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-size: 0.72rem;
		font-weight: 700;
	}

	.kicker,
	.section-label,
	.timeline article > p {
		color: var(--amex-blue);
	}

	h1,
	h2,
	h3,
	p {
		margin-top: 0;
	}

	h1 {
		max-width: 850px;
		margin-bottom: 24px;
		color: var(--amex-deep);
		font-size: clamp(3.1rem, 7.4vw, 7rem);
		line-height: 0.94;
		letter-spacing: 0;
	}

	h2 {
		max-width: 830px;
		margin-bottom: 20px;
		color: var(--amex-deep);
		font-size: clamp(2rem, 4.8vw, 4.4rem);
		line-height: 1;
		letter-spacing: 0;
	}

	h3 {
		color: var(--amex-deep);
		font-size: 1.05rem;
		line-height: 1.2;
	}

	.deck {
		max-width: 720px;
		color: var(--amex-muted);
		font-size: clamp(1.1rem, 1.8vw, 1.35rem);
	}

	.quick-proof {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1px;
		margin-top: 36px;
		background: var(--amex-line);
		border: 1px solid var(--amex-line);
	}

	.quick-proof div {
		min-height: 128px;
		padding: 18px;
		background: #fff;
	}

	.quick-proof strong {
		display: block;
		color: var(--amex-blue);
		font-size: clamp(2rem, 4vw, 3.2rem);
		line-height: 1;
	}

	.quick-proof span {
		display: block;
		margin-top: 10px;
		color: var(--amex-muted);
		font-size: 0.85rem;
	}

	.hero-card {
		align-self: center;
		border: 1px solid var(--amex-line);
		background: var(--amex-pale);
		box-shadow: 14px 14px 0 #dbeafe;
	}

	.hero-card img {
		display: block;
		width: 100%;
		aspect-ratio: 1 / 1.05;
		object-fit: cover;
		object-position: center 34%;
	}

	.candidate-card {
		padding: 20px;
		background: var(--amex-deep);
		color: #fff;
	}

	.candidate-card p {
		margin-bottom: 2px;
		font-size: 1.4rem;
		font-weight: 700;
	}

	.candidate-card span,
	.candidate-card a {
		display: block;
		margin-top: 8px;
		color: rgba(255, 255, 255, 0.78);
	}

	.fit-strip {
		display: grid;
		grid-template-columns: repeat(6, 1fr);
		gap: 1px;
		margin: 28px 0;
		background: var(--amex-line);
		border: 1px solid var(--amex-line);
		color: var(--amex-deep);
	}

	.fit-strip span {
		display: grid;
		min-height: 84px;
		place-items: center;
		padding: 12px;
		background: #fff;
		text-align: center;
	}

	.section-grid {
		display: grid;
		grid-template-columns: 180px minmax(0, 1fr);
		gap: clamp(28px, 5vw, 72px);
		padding: 72px 0;
		border-bottom: 1px solid var(--amex-line);
	}

	.section-grid p {
		max-width: 860px;
		color: var(--amex-muted);
		font-size: 1.06rem;
	}

	.map-grid,
	.requirements {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 16px;
		margin-top: 30px;
	}

	.map-grid article,
	.requirements div,
	.timeline article {
		border: 1px solid var(--amex-line);
		background: #fff;
		padding: 20px;
	}

	.map-grid p,
	.requirements p {
		margin-bottom: 0;
		font-size: 0.94rem;
	}

	.blue-block {
		width: calc(100% + 40px);
		margin-left: -20px;
		padding: 72px 20px;
		background: var(--amex-deep);
		color: #fff;
	}

	.blue-block h2,
	.blue-block .section-label,
	.blue-block h3 {
		color: #fff;
	}

	.requirements {
		grid-template-columns: repeat(4, 1fr);
	}

	.requirements div {
		background: rgba(255, 255, 255, 0.08);
		border-color: rgba(255, 255, 255, 0.22);
	}

	.requirements span {
		display: block;
		margin-bottom: 16px;
		color: #a7d8ff;
	}

	.requirements p {
		color: rgba(255, 255, 255, 0.82);
	}

	.timeline {
		display: grid;
		gap: 16px;
	}

	.timeline article {
		display: grid;
		grid-template-columns: 120px 220px minmax(0, 1fr);
		gap: 22px;
	}

	.timeline h3 {
		margin-bottom: 4px;
	}

	.timeline span {
		display: block;
		color: var(--amex-muted);
		font-size: 0.85rem;
	}

	.timeline ul {
		margin: 0;
		padding-left: 18px;
		color: var(--amex-muted);
	}

	.timeline li + li {
		margin-top: 8px;
	}

	.closing {
		margin-top: 42px;
		padding: clamp(30px, 6vw, 72px);
		background: var(--amex-pale);
		border-top: 6px solid var(--amex-blue);
	}

	.closing p {
		max-width: 800px;
		color: var(--amex-muted);
		font-size: 1.08rem;
	}

	.closing a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 44px;
		margin-top: 10px;
		padding: 0 18px;
		background: var(--amex-blue);
		color: #fff;
		text-decoration: none;
		font-weight: 700;
	}

	@media (max-width: 980px) {
		.hero,
		.section-grid {
			grid-template-columns: 1fr;
		}

		.hero {
			min-height: 0;
			padding: 56px 0;
		}

		.hero-card {
			max-width: 420px;
		}

		.quick-proof,
		.fit-strip,
		.map-grid,
		.requirements {
			grid-template-columns: repeat(2, 1fr);
		}

		.timeline article {
			grid-template-columns: 1fr;
			gap: 10px;
		}

		.timeline article > p {
			margin-bottom: 0;
		}

		.timeline span {
			max-width: 100%;
		}

		.timeline ul {
			grid-column: 1;
			padding-left: 20px;
		}
	}

	@media (max-width: 620px) {
		main {
			width: min(100% - 24px, 1180px);
			padding-bottom: 40px;
		}

		h1 {
			font-size: clamp(2.8rem, 15vw, 4.8rem);
		}

		.quick-proof,
		.fit-strip,
		.map-grid,
		.requirements {
			grid-template-columns: 1fr;
		}
	}
</style>
