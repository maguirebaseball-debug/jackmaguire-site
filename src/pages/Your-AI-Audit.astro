---
import BaseHead from '../components/BaseHead.astro';

const snapshotPrice = 59;
const title = `One-Task AI Workflow Plan | $${snapshotPrice}`;
const description = `Describe one repetitive computer task. Get one practical AI workflow plan by the end of the next business day, or a full refund if I cannot support a 30-minute weekly savings projection.`;
const fallbackCheckoutUrl = 'https://buy.stripe.com/aFa14neprdi32gLbdA53O03';

const faqItems = [
	{
		question: 'What exactly am I buying?',
		answer: 'A personally reviewed one-page PDF about one recurring computer task. It shows your current time cost, one selected recommendation, projected savings and software cost, three setup steps, the first test, and the assumptions behind the projection.',
	},
	{
		question: 'Do you install the automation?',
		answer: 'No. You receive the recommendation and setup plan. I do not log into accounts, install software, configure integrations, or build custom software.',
	},
	{
		question: 'Do I need AI or coding experience?',
		answer: 'No. Recommendations are limited to practical no-code or built-in tool options that fit the constraints you provide.',
	},
	{
		question: 'Will I need to buy software?',
		answer: 'Not necessarily. I may recommend a feature in a tool you already use. If a paid tool is justified, the PDF states the estimated monthly cost.',
	},
	{
		question: 'When will it arrive?',
		answer: 'By the end of the next business day after you submit the completed intake. Business days are Monday through Friday, excluding U.S. federal holidays.',
	},
	{
		question: 'How does the refund work?',
		answer: `If I cannot support a practical 30-minute weekly projection from your completed intake, I initiate a full $${snapshotPrice} refund to the original payment method. You do not need to request it. The guarantee covers the recommendation, not results after implementation.`,
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} ogImage="/your-ai-audit-og-v3.png" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
		<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&display=swap" rel="stylesheet" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
		<script type="application/ld+json" set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'Service',
			name: 'One-Task AI Plan',
			description,
			provider: {
				'@type': 'Person',
				'@id': 'https://jackmaguire.org/#jack',
				name: 'Jack Maguire',
				url: 'https://jackmaguire.org/',
			},
			areaServed: 'US',
			offers: {
				'@type': 'Offer',
				name: 'One-Task AI Plan',
				price: String(snapshotPrice),
				priceCurrency: 'USD',
				availability: 'https://schema.org/InStock',
				url: 'https://jackmaguire.org/Your-AI-Audit/',
			},
		})} />
	</head>
	<body>
		<div class="audit-page">
			<header class="topbar">
				<a class="brand" href="/" aria-label="Jack Maguire home">
					<span class="brand-mark" aria-hidden="true">JM</span>
					<span>Your One-Task AI Plan</span>
				</a>
				<a class="topbar-link" href="#what-you-get">See what you get <span>${snapshotPrice}</span></a>
			</header>
			<p id="checkout-cancelled" class="checkout-notice" hidden><strong>Checkout canceled.</strong> You were not charged.</p>

			<main>
				<section class="hero" aria-labelledby="hero-title">
					<div class="hero-copy">
					<p class="eyebrow"><span></span> CASE FILE 001 / PERSONALLY REVIEWED</p>
						<h1 id="hero-title">Stop paying for the same computer task every week.</h1>
						<p class="hero-subhead">Describe one repetitive task that takes 45 minutes or more each week. I will choose one practical AI workflow and send you a one-page plan with your current steps, projected savings, software cost, and first test.</p>
						<p class="hero-qualifier">Pay ${snapshotPrice}, complete a five-minute intake, and get your plan by the end of the next business day after you submit it. If I cannot support a projection of at least 30 minutes saved each week, I initiate a full refund.</p>
						<div class="hero-actions">
							<a class="button button-primary" href={fallbackCheckoutUrl} data-audit-checkout data-cta-location="hero">
								<span class="button-label">Get my one-task plan</span>
								<strong>${snapshotPrice}</strong>
							</a>
							<p><strong>No call or subscription.</strong> This is a recommendation and setup plan, not installation.</p>
						</div>
					</div>

					<aside class="audit-card" aria-label="One-task AI plan deliverable">
						<div class="audit-card-head">
							<span>What arrives</span>
							<span class="status"><i></i> Personally reviewed</span>
						</div>
						<div class="price-lockup">
							<strong>1</strong>
							<span>one-page<br />PDF plan</span>
						</div>
						<ul>
							<li>Current workflow and weekly time</li>
							<li>One selected recommendation</li>
							<li>Savings, setup, and software cost</li>
							<li>The first test to run</li>
						</ul>
						<div class="audit-card-foot">
							<div><span>Prepared by</span><strong>Jack</strong></div>
							<div><span>Price</span><strong>${snapshotPrice}</strong></div>
						</div>
					</aside>
				</section>

				<section id="what-you-get" class="deliverable-section section-shell" aria-labelledby="deliverable-title">
					<div class="section-heading">
						<p class="section-label" data-notation="01">01 / CURRENT TASK</p>
						<h2 id="deliverable-title">One page that tells you whether the change is worth making.</h2>
						<p>You receive one recommendation for one task, with the numbers and first steps needed to make a decision. Installation, account access, and custom software are not included.</p>
					</div>
					<div class="decision-grid">
						<article><span>01</span><strong>Your task now</strong><p>The steps and estimated weekly time in your current workflow.</p></article>
						<article><span>02</span><strong>The workflow to use</strong><p>One practical no-code AI or automation workflow selected for your tools and constraints.</p></article>
						<article><span>03</span><strong>Whether it is worth it</strong><p>Projected savings, one-time setup, ongoing review, and estimated software cost.</p></article>
						<article><span>04</span><strong>What to test first</strong><p>The smallest way to test the recommendation before changing your routine.</p></article>
					</div>
				</section>

				<section class="process-section section-shell" aria-labelledby="process-title">
					<div class="section-heading">
						<p class="section-label" data-notation="02">02 / RECOMMENDATION</p>
						<h2 id="process-title">From payment to plan in three steps.</h2>
						<p>The delivery clock starts after you submit the completed intake, not when checkout ends.</p>
					</div>
					<div class="process-grid">
						<article><span>1</span><strong>Pay ${snapshotPrice}</strong><p>Stripe sends you straight to the eight-question intake.</p></article>
						<article><span>2</span><strong>Describe one task</strong><p>Share the steps, tools, time, desired outcome, and constraints. Rough estimates are fine.</p></article>
						<article><span>3</span><strong>I email the PDF</strong><p>I personally review your answers and send the plan by the end of the next business day after you submit the completed intake.</p></article>
					</div>
					<p class="privacy-strip"><strong>Keep private data out.</strong> Do not provide passwords, API keys, files, customer records, health information, or financial account details. A high-level description is enough.</p>
				</section>

				<section id="example" class="example-section section-shell" aria-labelledby="example-title">
					<div class="section-heading">
						<p class="section-label" data-notation="03">03 / PAYOFF</p>
						<h2 id="example-title">This is the structure you receive.</h2>
						<p>This example uses fictional details and assumptions. Your PDF uses your task, constraints, and estimates.</p>
					</div>

					<article class="snapshot-sheet" aria-label="Illustrative One-Task AI Plan">
						<header>
							<div>
								<p>One-Task AI Plan</p>
								<h3>Sunday inbox and calendar reset</h3>
							</div>
							<span>Illustrative</span>
						</header>
						<div class="snapshot-grid">
							<section>
								<span class="report-number">01</span>
								<p class="report-kicker">Your task now</p>
								<h4>The submitted routine takes 90 minutes every Sunday across email, a calendar, and a handwritten list.</h4>
								<p>15 flagged emails x 4 minutes, plus 30 minutes copying dates and building the week's checklist.</p>
							</section>
							<section class="recommendation-cell">
								<span class="report-number">02</span>
								<p class="report-kicker">One recommendation</p>
								<h4>Use a Gmail label called Sunday Review and a saved five-field AI prompt to extract the action, date, owner, source, and urgency into one draft checklist.</h4>
								<p>Keep calendar edits and final approval manual. Do not send sensitive email content to an unapproved AI account.</p>
							</section>
							<section class="math-cell">
								<span class="report-number">03</span>
								<p class="report-kicker">Projected savings</p>
								<div class="big-math"><strong>55</strong><span>minutes saved<br />per week</span></div>
								<p>90 minutes now minus 35 minutes for review and approval. Estimated added software cost: $0 to $20 per month.</p>
							</section>
							<section>
								<span class="report-number">04</span>
								<p class="report-kicker">Three setup steps</p>
								<h4>Label last week's messages. Save the five-field prompt. Run the draft checklist before using it on the current week.</h4>
								<p>First test: verify extracted dates and owners. Key assumption: the person still spends no more than 35 minutes reviewing the result.</p>
							</section>
						</div>
						<footer>
							<span>What you receive</span>
							<strong>Your PDF uses this same structure and states the assumptions behind the projection.</strong>
						</footer>
					</article>
				</section>

				<section class="diy-section section-shell" aria-labelledby="diy-title">
					<div>
						<p class="section-label" data-notation="04">04 / FIRST TEST</p>
						<h2 id="diy-title">Why not just ask ChatGPT?</h2>
					</div>
					<div class="diy-copy">
						<p>You can. ChatGPT is good at producing options. I narrow those options to one change that fits your task, tools, budget, privacy needs, and setup tolerance, then check whether the projected savings justify the work.</p>
						<p>You pay for the diagnosis and decision, not a list of AI apps. If you already know what to automate, which tool to use, and how to test it, you probably do not need this.</p>
					</div>
				</section>

				<section class="task-examples section-shell" aria-labelledby="task-examples-title">
					<div class="section-heading">
						<p class="section-label" data-notation="01">01 / CURRENT TASK</p>
						<h2 id="task-examples-title">Pick the task you keep losing time to.</h2>
						<p>Good candidates usually take at least 45 minutes a week and follow similar steps each time. Work and personal tasks both count.</p>
					</div>
					<div class="task-chips" aria-label="Suitable task examples">
						<span>Inbox replies</span><span>Meeting notes</span><span>Spreadsheet updates</span><span>Recurring research</span><span>Scheduling and reminders</span><span>Routine documents</span><span>Personal admin</span>
					</div>
					<p class="not-fit"><strong>Not a fit:</strong> physical chores, one-off projects, company-wide audits, custom software, account setup, or workflows that require sensitive records.</p>
				</section>

				<section class="credibility section-shell" aria-labelledby="credibility-title">
					<figure>
						<img src="/images/about/jack-professional-portrait.jpg" alt="Jack Maguire" loading="lazy" width="640" height="800" />
						<figcaption>Jack Maguire, New York City</figcaption>
					</figure>
					<div class="credibility-copy">
						<p class="section-label" data-notation="02">02 / RECOMMENDATION</p>
						<h2 id="credibility-title">One practical answer, not the most impressive tool.</h2>
						<p>I am Jack Maguire. For more than 12 years, I have worked in performance marketing and operations, managed more than $30 million in media spend, and advised more than 600 business owners.</p>
						<p>I personally prepare every recommendation and compare the repeated cost, setup burden, ongoing review, and expected payoff before recommending anything.</p>
						<div class="proof-row" aria-label="Jack Maguire credentials">
							<div><strong>12+</strong><span>years in marketing and operations</span></div>
							<div><strong>$30M+</strong><span>in managed media spend</span></div>
							<div><strong>600+</strong><span>business owners advised</span></div>
						</div>
					</div>
				</section>

				<section class="guarantee-section section-shell" aria-labelledby="guarantee-title">
					<div class="guarantee-card">
						<p class="section-label section-label-dark" data-notation="03">03 / PAYOFF / GUARANTEE</p>
						<div class="guarantee-number"><strong>30</strong><span>minutes saved<br />each week</span></div>
						<h2 id="guarantee-title">If I cannot support the projection, I refund the ${snapshotPrice}.</h2>
						<p>I use your task frequency, current time, expected new time, setup burden, and ongoing review to make the projection. If the completed intake does not support one practical change projected to save at least 30 minutes per week, I initiate a full refund without you asking. The guarantee covers the opportunity identified, not results after implementation. Refunds return to the original payment method, and bank timing varies.</p>
					</div>

					<div class="faq-block">
						<p class="section-label" data-notation="04">04 / FIRST TEST / FAQ</p>
						<h2>Everything worth knowing before you pay.</h2>
						<div class="faq-list">
							{faqItems.map((item) => (
								<details>
									<summary>{item.question}<span aria-hidden="true">+</span></summary>
									<p>{item.answer}</p>
								</details>
							))}
						</div>
					</div>
				</section>

				<section class="final-cta section-shell" aria-labelledby="final-title">
					<div>
						<p class="section-label section-label-light" data-notation="05">05 / SUBMIT FOR REVIEW</p>
						<h2 id="final-title">Which task are you tired of paying for every week?</h2>
						<p>Describe it once. Get one practical plan by the end of the next business day after you submit the completed intake.</p>
					</div>
					<aside class="checkout-card">
						<span>One-Task AI Plan</span>
						<div><strong>${snapshotPrice}</strong><small>one-time purchase</small></div>
						<ul>
							<li>Personally reviewed one-page PDF</li>
							<li>Due by the end of the next business day after you submit the completed intake</li>
							<li>Full refund if no qualifying 30-minute projection</li>
						</ul>
						<a class="button button-light" href={fallbackCheckoutUrl} data-audit-checkout data-cta-location="final">
							<span class="button-label">Get my one-task plan, ${snapshotPrice}</span>
							<strong aria-hidden="true">&#8594;</strong>
						</a>
						<p>One-time payment through Stripe. No subscription.</p>
					</aside>
				</section>

				<section class="question-section section-shell" aria-labelledby="question-title">
					<div class="question-copy">
						<h2 id="question-title">Questions before you buy?</h2>
						<p>If you are unsure whether your task is a fit, send me a short description. Do not include passwords, files, customer information, or other private data. I will reply by email.</p>
					</div>
					<form id="audit-question-form" class="question-form" action="https://api.web3forms.com/submit" method="POST">
						<input type="hidden" name="access_key" value="0d5ededb-778b-452f-b8f0-72ebb2e4e461" />
						<input type="hidden" name="subject" value="Question about the One-Task AI Plan" />
						<input type="hidden" name="from_name" value="jackmaguire.org AI Audit" />
						<input type="checkbox" name="botcheck" class="botcheck" tabindex="-1" autocomplete="off" />
						<label for="audit-question-name">Name</label>
						<input id="audit-question-name" type="text" name="name" required autocomplete="name" />
						<label for="audit-question-email">Email</label>
						<input id="audit-question-email" type="email" name="email" required autocomplete="email" />
						<label for="audit-question-message">What would you like to ask?</label>
						<textarea id="audit-question-message" name="message" rows="4" required></textarea>
						<button type="submit">Ask Jack</button>
						<p class="question-note">This form is for questions only. To order the plan, use the ${snapshotPrice} checkout above. No newsletter. <a href="/privacy-policy/">Privacy</a></p>
						<p class="question-status" role="status" aria-live="polite"></p>
					</form>
				</section>
			</main>

			<footer class="page-footer">
				<a href="/">Jack Maguire</a>
				<a href="/privacy-policy/">Privacy</a>
				<span>New York City</span>
			</footer>
		</div>

		<script define:vars={{ fallbackCheckoutUrl, snapshotPrice }}>
			const offerId = 'ai_bottleneck_snapshot';
			const offerName = 'One-Task AI Plan';
			const attributionStorageKey = 'jm_ai_audit_attribution_v2';
			const landingSessionKey = 'jm_ai_audit_landing_session';
			const gaClientKey = 'jm_ga4_audit_client';
			const gaSessionKey = 'jm_ga4_audit_session';
			const internalTrafficKey = 'jm_ga_internal';

			function readCookie(name) {
				return document.cookie
					.split('; ')
					.find((cookie) => cookie.startsWith(`${name}=`))
					?.split('=')
					.slice(1)
					.join('=') || '';
			}

			function getFbc() {
				const cookieFbc = readCookie('_fbc');
				if (cookieFbc) return cookieFbc;
				const storedFbc = sessionStorage.getItem('jm_meta_fbc');
				if (storedFbc) return storedFbc;
				const fbclid = new URLSearchParams(window.location.search).get('fbclid');
				if (!fbclid) return '';
				const fbc = `fb.1.${Date.now()}.${fbclid}`;
				sessionStorage.setItem('jm_meta_fbc', fbc);
				return fbc;
			}

			function safeStoredAttribution() {
				try {
					return JSON.parse(sessionStorage.getItem(attributionStorageKey) || '{}');
				} catch {
					return {};
				}
			}

			function getStableGaIdentity() {
				if (window.jmGa4Identity?.getSync) return window.jmGa4Identity.getSync();
				let clientId = sessionStorage.getItem(gaClientKey) || '';
				let sessionId = sessionStorage.getItem(gaSessionKey) || '';
				if (!clientId) {
					const gaMatch = readCookie('_ga').match(/GA\d+\.\d+\.(\d+\.\d+)/);
					clientId = gaMatch?.[1] || `${Math.floor(Math.random() * 1_000_000_000)}.${Math.floor(Date.now() / 1000)}`;
					sessionStorage.setItem(gaClientKey, clientId);
				}
				if (!sessionId) {
					sessionId = String(Math.floor(Date.now() / 1000));
					sessionStorage.setItem(gaSessionKey, sessionId);
				}
				return { clientId, sessionId };
			}

			async function resolveGaIdentity() {
				const identity = window.jmGa4Identity?.resolve
					? await window.jmGa4Identity.resolve()
					: getStableGaIdentity();
				sessionStorage.setItem(gaClientKey, identity.clientId);
				sessionStorage.setItem(gaSessionKey, identity.sessionId);
				return identity;
			}

			function getLandingAttribution() {
				const params = new URLSearchParams(window.location.search);
				const stored = safeStoredAttribution();
				const landingSessionId = sessionStorage.getItem(landingSessionKey) || crypto.randomUUID();
				sessionStorage.setItem(landingSessionKey, landingSessionId);
				const gaIdentity = getStableGaIdentity();
				const next = {
					utm_source: params.get('utm_source') || stored.utm_source || '',
					utm_medium: params.get('utm_medium') || stored.utm_medium || '',
					campaign: params.get('utm_campaign') || stored.campaign || '',
					campaign_id: params.get('utm_id') || stored.campaign_id || '',
					ad_name: params.get('utm_content') || stored.ad_name || '',
					adset_id: params.get('adset_id') || stored.adset_id || '',
					ad_id: params.get('ad_id') || stored.ad_id || '',
					placement: params.get('utm_term') || stored.placement || '',
					site_source_name: params.get('site_source_name') || stored.site_source_name || '',
					landing_session_id: landingSessionId,
					meta_fbclid: params.get('fbclid') || stored.meta_fbclid || '',
					meta_fbp: readCookie('_fbp') || stored.meta_fbp || '',
					meta_fbc: getFbc() || stored.meta_fbc || '',
					ga_client_id: gaIdentity.clientId,
					ga_session_id: gaIdentity.sessionId,
					first_landing_at: stored.first_landing_at || new Date().toISOString(),
				};
				sessionStorage.setItem(attributionStorageKey, JSON.stringify(next));
				return next;
			}

			function encodeClientReference(attribution) {
				const values = [attribution.meta_fbp || '', attribution.meta_fbc || '', attribution.ga_client_id || ''];
				if (!values.some(Boolean)) return '';
				const encoded = btoa(values.join('|')).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/g, '');
				return encoded.length <= 197 ? `m1_${encoded}` : '';
			}

			async function resolveLandingAttribution() {
				const gaIdentity = await resolveGaIdentity();
				const attribution = getLandingAttribution();
				attribution.ga_client_id = gaIdentity.clientId;
				attribution.ga_session_id = gaIdentity.sessionId;
				sessionStorage.setItem(attributionStorageKey, JSON.stringify(attribution));
				return attribution;
			}

			async function trackAuditEvent(name, parameters = {}) {
				const params = new URLSearchParams(window.location.search);
				const debugMode = params.get('ga_debug') === '1';
				const internalTraffic = debugMode || localStorage.getItem(internalTrafficKey) === '1';
				const attribution = await resolveLandingAttribution();
				return fetch('/api/ga4-audit-event/', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({
						event_name: name,
						params: {
							content_group: 'ai_audit',
							campaign: attribution.campaign,
							campaign_id: attribution.campaign_id,
							source: attribution.utm_source,
							medium: attribution.utm_medium,
							content: attribution.ad_name,
							term: attribution.placement,
							ad_name: attribution.ad_name,
							adset_id: attribution.adset_id,
							ad_id: attribution.ad_id,
							placement: attribution.placement,
							site_source_name: attribution.site_source_name,
							landing_session_id: attribution.landing_session_id,
							page_location: window.location.href,
							page_referrer: document.referrer,
							...parameters,
						},
						client_id: attribution.ga_client_id,
						session_id: attribution.ga_session_id,
						debug_mode: debugMode,
						internal_traffic: internalTraffic,
					}),
					keepalive: true,
				}).catch(() => {});
			}

			const landingAttribution = getLandingAttribution();
			if (new URLSearchParams(window.location.search).get('checkout') === 'cancelled') {
				const notice = document.getElementById('checkout-cancelled');
				if (notice) notice.hidden = false;
				const cancelledKey = 'jm_ai_audit_checkout_cancelled';
				if (sessionStorage.getItem(cancelledKey) !== '1') {
					sessionStorage.setItem(cancelledKey, '1');
					trackAuditEvent('ai_audit_checkout_cancelled', { tier: 'snapshot', checkout_path: 'dynamic' });
				}
			}
			if (typeof window.gtag === 'function') {
				window.gtag('event', 'view_item', {
					currency: 'USD',
					value: snapshotPrice,
					items: [{ item_id: offerId, item_name: offerName, price: snapshotPrice, quantity: 1 }],
					campaign: landingAttribution.campaign,
					ad_name: landingAttribution.ad_name,
					placement: landingAttribution.placement,
				});
			}
			if (typeof window.fbq === 'function') {
				window.fbq('track', 'ViewContent', {
					content_ids: [offerId],
					content_name: offerName,
					content_type: 'product',
					value: snapshotPrice,
					currency: 'USD',
				});
			}

			function buildFallbackUrl(attribution) {
				const url = new URL(fallbackCheckoutUrl);
				const reference = encodeClientReference(attribution);
				if (reference) url.searchParams.set('client_reference_id', reference);
				const values = {
					utm_source: attribution.utm_source,
					utm_medium: attribution.utm_medium,
					utm_campaign: attribution.campaign,
					utm_content: attribution.ad_name,
					utm_term: attribution.placement,
				};
				Object.entries(values).forEach(([key, value]) => {
					if (value) url.searchParams.set(key, value);
				});
				return url.toString();
			}

			document.querySelectorAll('[data-audit-checkout]').forEach((link) => {
				link.addEventListener('click', async (event) => {
					if (!(link instanceof HTMLAnchorElement) || link.dataset.loading === 'true') return;
					event.preventDefault();
					link.dataset.loading = 'true';
					link.setAttribute('aria-busy', 'true');
					const label = link.querySelector('.button-label');
					if (label) label.textContent = 'Opening secure checkout...';

					const attribution = await resolveLandingAttribution();
					const ctaLocation = link.dataset.ctaLocation || 'unknown';
					const checkoutAttemptId = crypto.randomUUID();
					if (typeof window.fbq === 'function') {
						window.fbq('track', 'InitiateCheckout', {
							content_ids: [offerId],
							content_name: offerName,
							content_type: 'product',
							value: snapshotPrice,
							currency: 'USD',
						});
					}

					const ctaEvent = trackAuditEvent('ai_audit_cta_clicked', { tier: 'snapshot', value: snapshotPrice, currency: 'USD', cta_location: ctaLocation, checkout_attempt_id: checkoutAttemptId });
					if (typeof window.gtag === 'function') {
						window.gtag('event', 'begin_checkout', {
							tier: 'snapshot',
							value: snapshotPrice,
							currency: 'USD',
							cta_location: ctaLocation,
							checkout_attempt_id: checkoutAttemptId,
							items: [{ item_id: offerId, item_name: offerName, price: snapshotPrice, quantity: 1 }],
						});
					}

					try {
						const response = await fetch('/api/stripe-ai-audit-checkout/', {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({
								tier: 'snapshot',
								...attribution,
								client_reference_id: encodeClientReference(attribution),
							}),
						});
						if (!response.ok) throw new Error('Checkout Session could not be created');
						const result = await response.json();
						if (!result.url || !result.url.startsWith('https://checkout.stripe.com/')) throw new Error('Invalid Checkout URL');
						const checkoutEvent = trackAuditEvent('ai_audit_checkout_started', { tier: 'snapshot', value: snapshotPrice, currency: 'USD', cta_location: ctaLocation, checkout_attempt_id: checkoutAttemptId, checkout_path: 'dynamic' });
						await Promise.allSettled([ctaEvent, checkoutEvent]);
						window.location.assign(result.url);
					} catch {
						const checkoutEvent = trackAuditEvent('ai_audit_checkout_started', { tier: 'snapshot', value: snapshotPrice, currency: 'USD', cta_location: ctaLocation, checkout_attempt_id: checkoutAttemptId, checkout_path: 'payment_link' });
						await Promise.allSettled([ctaEvent, checkoutEvent]);
						window.location.assign(buildFallbackUrl(attribution));
					}
				});
			});
		</script>
		<script>
			const questionForm = document.getElementById('audit-question-form');
			if (questionForm instanceof HTMLFormElement) {
				questionForm.addEventListener('submit', async (event) => {
					event.preventDefault();
					const submitButton = questionForm.querySelector('button[type="submit"]');
					const status = questionForm.querySelector('.question-status');
					if (submitButton instanceof HTMLButtonElement) {
						submitButton.disabled = true;
						submitButton.textContent = 'Sending...';
					}
					if (status instanceof HTMLElement) status.textContent = '';
					try {
						const response = await fetch(questionForm.action, {
							method: 'POST',
							headers: { Accept: 'application/json' },
							body: new FormData(questionForm),
						});
						const result = await response.json();
						if (!response.ok || !result.success) throw new Error('Submission failed');
						questionForm.reset();
						if (status instanceof HTMLElement) status.textContent = 'Thanks. I will reply by email.';
					} catch {
						if (status instanceof HTMLElement) status.textContent = 'That did not send. Email maguirebaseball@gmail.com instead.';
					} finally {
						if (submitButton instanceof HTMLButtonElement) {
							submitButton.disabled = false;
							submitButton.textContent = 'Ask Jack';
						}
					}
				});
			}
		</script>
	</body>
</html>

