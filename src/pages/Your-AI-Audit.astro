	.guarantee-ladder p {
		margin: 0;
		font-size: 0.72rem;
		line-height: 1.5;
	}

	.outcomes {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 14px;
		margin-top: 30px;
	}

	.outcomes p {
		margin: 0;
		padding: 16px;
		border: 1px solid var(--ink);
		font-size: 0.82rem;
		line-height: 1.5;
	}

	.outcomes span {
		display: block;
		margin-bottom: 8px;
		color: var(--blue);
		font-size: 0.67rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.booking {
		display: grid;
		grid-template-columns: 0.75fr 1fr;
		gap: 90px;
		width: 100%;
		max-width: none;
		padding-right: max(24px, calc((100vw - 1180px) / 2));
		padding-left: max(24px, calc((100vw - 1180px) / 2));
		background: var(--ink);
		color: #fff;
	}

	.booking-copy > p {
		margin-top: 25px;
		color: rgba(255, 255, 255, 0.75);
	}

	.booking-copy ul {
		display: grid;
		gap: 12px;
		margin: 34px 0 0;
		padding: 0;
		list-style: none;
	}

	.booking-copy li {
		padding: 10px 0 10px 24px;
		border-bottom: 1px solid rgba(255, 255, 255, 0.22);
		font-size: 0.85rem;
		font-weight: 700;
	}

	.booking-copy li::before {
		content: '✓';
		margin-left: -24px;
		margin-right: 10px;
		color: var(--green);
	}

	.form-shell {
		padding: clamp(24px, 4vw, 44px);
