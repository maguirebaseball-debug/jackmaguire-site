---
import BaseHead from '../components/BaseHead.astro';

const title = 'Your AI Audit | $79 AI Bottleneck Snapshot';
const description = 'Find the first recurring workflow AI should take off your plate. Pay $79, answer eight questions, and receive a one-page AI Bottleneck Snapshot within one business day.';
const fallbackCheckoutUrl = import.meta.env.PUBLIC_AI_SNAPSHOT_CHECKOUT_URL || 'https://buy.stripe.com/14A4gz5SV91NcVp95s53O00';

const faqItems = [
	{
		question: 'What exactly am I buying?',
		answer: 'A one-page PDF diagnosing one recurring workflow. It names the bottleneck, estimates its weekly time cost, recommends one practical fix, shows the expected savings and software cost, and gives you the first setup steps.',
	},
	{
		question: 'Do I need AI or coding experience?',
		answer: 'No. The recommendation is written for a nontechnical owner and limited to tools or workflow changes you can realistically maintain.',
	},
	{
		question: 'What do I need to provide?',
		answer: 'Eight short answers about your business and one recurring task. Rough estimates are fine. You do not need to share passwords, customer records, API keys, or a technical inventory.',
	},
	{
		question: 'How does the refund work?',
		answer: 'If I cannot identify a practical change projected to save at least 30 minutes each week, I automatically refund the full $79. You do not need to implement the recommendation first.',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} ogImage="/your-ai-audit-og-v2.png" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
		<script type="application/ld+json" set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'Service',
			name: 'AI Bottleneck Snapshot',
			description,
			provider: {
				'@type': 'Person',
				'@id': 'https://jackmaguire.org/#jack',
				name: 'Jack Maguire',
				url: 'https://jackmaguire.org/',
			},
			areaServed: 'US',
			offers: {
				'@type': 'Offer',
				name: 'AI Bottleneck Snapshot',
				price: '79',
				priceCurrency: 'USD',
				availability: 'https://schema.org/InStock',
				url: 'https://jackmaguire.org/Your-AI-Audit/',
			},
		})} />
	</head>
	<body>
		<div class="audit-page">
			<header class="topbar">
				<a class="brand" href="/" aria-label="Jack Maguire home">
					<span class="brand-mark" aria-hidden="true">JM</span>
					<span>Your AI Audit</span>
				</a>
				<a class="topbar-link" href="#example">See what you get <span>$79</span></a>
			</header>

			<main>
				<section class="hero" aria-labelledby="hero-title">
					<div class="hero-copy">
						<p class="eyebrow"><span></span> For owner-led service businesses</p>
						<h1 id="hero-title">Find the first workflow AI can save you 30 minutes a week.</h1>
						<p class="hero-note">One useful answer in one business day.</p>
						<p class="hero-subhead">Pay $79, answer eight questions, and get a one-page recommendation for the recurring task worth fixing first. No software shopping, sales call, or AI expertise required.</p>
						<div class="hero-actions">
							<a class="button button-primary" href={fallbackCheckoutUrl} data-audit-checkout data-cta-location="hero">
								<span class="button-label">Get my AI Bottleneck Snapshot</span>
								<strong>$79</strong>
							</a>
							<p><strong>Flat price. No sales call.</strong> Complete eight questions and receive a one-page PDF by email.</p>
						</div>
					</div>

					<aside class="audit-card" aria-label="AI Bottleneck Snapshot deliverable">
						<div class="audit-card-head">
							<span>Your purchase</span>
							<span class="status"><i></i> One-day delivery</span>
						</div>
						<div class="price-lockup">
							<strong>$79</strong>
							<span>one-page<br />PDF diagnosis</span>
						</div>
						<ul>
							<li>Highest-cost recurring bottleneck</li>
							<li>One exact recommendation</li>
							<li>Savings, cost, and setup math</li>
						</ul>
						<div class="audit-card-foot">
							<div><span>Your input</span><strong>8 questions</strong></div>
							<div><span>Calls required</span><strong>None</strong></div>
						</div>
					</aside>
				</section>

				<section id="example" class="example-section section-shell" aria-labelledby="example-title">
					<div class="section-heading">
						<p class="section-label">A readable example</p>
						<h2 id="example-title">The answer fits on one page because the decision should be clear.</h2>
						<p>This example uses an illustrative business and numbers. Your Snapshot uses your workflow, constraints, and estimates.</p>
					</div>

					<article class="snapshot-sheet" aria-label="Illustrative AI Bottleneck Snapshot">
						<header>
							<div>
								<p>AI Bottleneck Snapshot</p>
								<h3>Lead follow-up after consultations</h3>
							</div>
							<span>Illustrative</span>
						</header>
						<div class="snapshot-grid">
							<section>
								<span class="report-number">01</span>
								<p class="report-kicker">Workflow diagnosed</p>
								<h4>A 6-person residential design studio spends four hours a week writing lead follow-ups.</h4>
								<p>12 consultations per week x 20 minutes each = 4 hours of owner time.</p>
							</section>
							<section class="recommendation-cell">
								<span class="report-number">02</span>
								<p class="report-kicker">Recommended fix</p>
								<h4>Use a saved intake-to-draft workflow to turn consultation notes into a review-ready email.</h4>
								<p>Keep final approval with the owner. Replace the blank-page writing step, not the relationship.</p>
							</section>
							<section class="math-cell">
								<span class="report-number">03</span>
								<p class="report-kicker">Projected savings</p>
								<div class="big-math"><strong>3</strong><span>hours saved<br />per week</span></div>
								<p>12 follow-ups x 5 minutes = 1 hour. Estimated tool cost: $20 per month.</p>
							</section>
							<section>
								<span class="report-number">04</span>
								<p class="report-kicker">First action</p>
								<h4>Build one template and test it on a recent consultation before changing the full workflow.</h4>
								<p>The paid report names the setup steps and the assumption to verify first.</p>
							</section>
						</div>
						<footer>
							<span>What you receive</span>
							<strong>Diagnosis, one recommendation, savings math, and a practical first step.</strong>
						</footer>
					</article>
				</section>

				<section class="credibility section-shell" aria-labelledby="credibility-title">
					<figure>
						<img src="/images/about/jack-professional-portrait.jpg" alt="Jack Maguire" loading="lazy" width="640" height="800" />
						<figcaption>Jack Maguire, New York City</figcaption>
					</figure>
					<div class="credibility-copy">
						<p class="section-label">Why Jack</p>
						<h2 id="credibility-title">A practical operator looking for leverage, not impressive software.</h2>
						<p>I am Jack Maguire. For more than 12 years in performance marketing and AI-enabled operations, I have managed more than $30 million in media spend and advised more than 600 business owners.</p>
						<p>I use the same discipline here: find the repeated cost, check the economics, and recommend the smallest useful change. If your workflow does not justify another tool, the report will say so.</p>
						<div class="proof-row" aria-label="Jack Maguire credentials">
							<div><strong>12+</strong><span>years in marketing and operations</span></div>
							<div><strong>$30M+</strong><span>in managed media spend</span></div>
							<div><strong>600+</strong><span>business owners advised</span></div>
						</div>
					</div>
				</section>

				<section class="guarantee-section section-shell" aria-labelledby="guarantee-title">
					<div class="guarantee-card">
						<p class="section-label section-label-dark">One Quick Win Guarantee</p>
						<div class="guarantee-number"><strong>30</strong><span>minutes saved<br />each week</span></div>
						<h2 id="guarantee-title">Or I automatically refund the full $79.</h2>
						<p>The recommendation must show a practical change projected to save at least 30 minutes each week using your current task time, expected new task time, tool cost, and oversight.</p>
					</div>

					<div class="faq-block">
						<p class="section-label">Short FAQ</p>
						<h2>Everything worth knowing before you pay.</h2>
						<div class="faq-list">
							{faqItems.map((item, index) => (
								<details open={index === 0}>
									<summary>{item.question}<span aria-hidden="true">+</span></summary>
									<p>{item.answer}</p>
								</details>
							))}
						</div>
					</div>
				</section>

				<section class="final-cta section-shell" aria-labelledby="final-title">
					<div>
						<p class="section-label section-label-light">Start with one bottleneck</p>
						<h2 id="final-title">Find the first recurring task worth taking off your plate.</h2>
						<p>Pay once, answer eight questions, and receive one specific recommendation with the math behind it within one business day.</p>
					</div>
					<aside class="checkout-card">
						<span>AI Bottleneck Snapshot</span>
						<div><strong>$79</strong><small>one-time purchase</small></div>
						<ul>
							<li>One-page PDF</li>
							<li>No sales call</li>
							<li>Automatic refund if no 30-minute opportunity is found</li>
						</ul>
						<a class="button button-light" href={fallbackCheckoutUrl} data-audit-checkout data-cta-location="final">
							<span class="button-label">Pay $79 and start</span>
							<strong aria-hidden="true">&#8594;</strong>
						</a>
						<p>Secure checkout through Stripe.</p>
					</aside>
				</section>
			</main>

			<footer class="page-footer">
				<a href="/">Jack Maguire</a>
				<a href="/privacy-policy/">Privacy</a>
				<span>New York City</span>
			</footer>
		</div>

		<script define:vars={{ fallbackCheckoutUrl }}>
			const attributionStorageKey = 'jm_ai_audit_attribution_v2';
			const landingSessionKey = 'jm_ai_audit_landing_session';
			const internalTrafficKey = 'jm_ga_internal';

			function readCookie(name) {
				return document.cookie
					.split('; ')
					.find((cookie) => cookie.startsWith(`${name}=`))
					?.split('=')
					.slice(1)
					.join('=') || '';
			}

			function getFbc() {
				const cookieFbc = readCookie('_fbc');
				if (cookieFbc) return cookieFbc;
				const storedFbc = sessionStorage.getItem('jm_meta_fbc');
				if (storedFbc) return storedFbc;
				const fbclid = new URLSearchParams(window.location.search).get('fbclid');
				if (!fbclid) return '';
				const fbc = `fb.1.${Date.now()}.${fbclid}`;
				sessionStorage.setItem('jm_meta_fbc', fbc);
				return fbc;
			}

			function safeStoredAttribution() {
				try {
					return JSON.parse(sessionStorage.getItem(attributionStorageKey) || '{}');
				} catch {
					return {};
				}
			}

			function getLandingAttribution() {
				const params = new URLSearchParams(window.location.search);
				const stored = safeStoredAttribution();
				const landingSessionId = sessionStorage.getItem(landingSessionKey) || crypto.randomUUID();
				sessionStorage.setItem(landingSessionKey, landingSessionId);
				const gaMatch = readCookie('_ga').match(/GA\d+\.\d+\.(\d+\.\d+)/);
				const next = {
					utm_source: params.get('utm_source') || stored.utm_source || '',
					utm_medium: params.get('utm_medium') || stored.utm_medium || '',
					campaign: params.get('utm_campaign') || stored.campaign || '',
					ad_name: params.get('utm_content') || stored.ad_name || '',
					placement: params.get('utm_term') || stored.placement || '',
					landing_session_id: landingSessionId,
					meta_fbclid: params.get('fbclid') || stored.meta_fbclid || '',
					meta_fbp: readCookie('_fbp') || stored.meta_fbp || '',
					meta_fbc: getFbc() || stored.meta_fbc || '',
					ga_client_id: gaMatch?.[1] || stored.ga_client_id || '',
				};
				sessionStorage.setItem(attributionStorageKey, JSON.stringify(next));
				return next;
			}

			function encodeClientReference(attribution) {
				const values = [attribution.meta_fbp || '', attribution.meta_fbc || '', attribution.ga_client_id || ''];
				if (!values.some(Boolean)) return '';
				const encoded = btoa(values.join('|')).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/g, '');
				return encoded.length <= 197 ? `m1_${encoded}` : '';
			}

			function trackAuditEvent(name, parameters = {}) {
				const params = new URLSearchParams(window.location.search);
				const debugMode = params.get('ga_debug') === '1';
				const internalTraffic = debugMode || localStorage.getItem(internalTrafficKey) === '1';
				const attribution = getLandingAttribution();
				const clientId = attribution.ga_client_id || `audit.${crypto.randomUUID()}`;
				const sessionKey = 'jm_ga4_audit_session';
				const sessionId = sessionStorage.getItem(sessionKey) || String(Math.floor(Date.now() / 1000));
				sessionStorage.setItem(sessionKey, sessionId);
				return fetch('/api/ga4-audit-event/', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({
						event_name: name,
						params: {
							content_group: 'ai_audit',
							campaign: attribution.campaign,
							ad_name: attribution.ad_name,
							placement: attribution.placement,
							landing_session_id: attribution.landing_session_id,
							...parameters,
						},
						client_id: clientId,
						session_id: sessionId,
						debug_mode: debugMode,
						internal_traffic: internalTraffic,
					}),
					keepalive: true,
				}).catch(() => {});
			}

			function buildFallbackUrl(attribution) {
				const url = new URL(fallbackCheckoutUrl);
				const reference = encodeClientReference(attribution);
				if (reference) url.searchParams.set('client_reference_id', reference);
				const values = {
					utm_source: attribution.utm_source,
					utm_medium: attribution.utm_medium,
					utm_campaign: attribution.campaign,
					utm_content: attribution.ad_name,
					utm_term: attribution.placement,
				};
				Object.entries(values).forEach(([key, value]) => {
					if (value) url.searchParams.set(key, value);
				});
				return url.toString();
			}

			document.querySelectorAll('[data-audit-checkout]').forEach((link) => {
				link.addEventListener('click', async (event) => {
					if (!(link instanceof HTMLAnchorElement) || link.dataset.loading === 'true') return;
					event.preventDefault();
					link.dataset.loading = 'true';
					link.setAttribute('aria-busy', 'true');
					const label = link.querySelector('.button-label');
					if (label) label.textContent = 'Opening secure checkout...';

					const attribution = getLandingAttribution();
					const ctaLocation = link.dataset.ctaLocation || 'unknown';
					if (typeof window.fbq === 'function') {
						window.fbq('track', 'InitiateCheckout', {
							content_name: 'ai_audit_snapshot',
							content_type: 'product',
							value: 79,
							currency: 'USD',
						});
					}

					await Promise.all([
						trackAuditEvent('ai_audit_cta_clicked', { tier: 'snapshot', value: 79, currency: 'USD', cta_location: ctaLocation }),
						trackAuditEvent('begin_checkout', {
							tier: 'snapshot',
							value: 79,
							currency: 'USD',
							cta_location: ctaLocation,
							items: [{ item_id: 'ai_audit_snapshot', item_name: 'AI Bottleneck Snapshot', price: 79, quantity: 1 }],
						}),
						trackAuditEvent('ai_audit_checkout_started', { tier: 'snapshot', value: 79, currency: 'USD', cta_location: ctaLocation }),
					]);

					try {
						const response = await fetch('/api/stripe-ai-audit-checkout/', {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({
								tier: 'snapshot',
								...attribution,
								client_reference_id: encodeClientReference(attribution),
							}),
						});
						if (!response.ok) throw new Error('Checkout Session could not be created');
						const result = await response.json();
						if (!result.url || !result.url.startsWith('https://checkout.stripe.com/')) throw new Error('Invalid Checkout URL');
						window.location.assign(result.url);
					} catch {
						window.location.assign(buildFallbackUrl(attribution));
					}
				});
			});
		</script>
	</body>
</html>

<style>
	:global(*) { box-sizing: border-box; }
	:global(html) { scroll-behavior: smooth; background: #f4f0e7; }
	:global(body) { margin: 0; background: #f4f0e7; color: #171812; }
	:global(body), :global(button), :global(input), :global(select), :global(textarea) { font-family: var(--font-ui), Arial, sans-serif; }

	.audit-page {
		--ink: #171812;
		--paper: #f4f0e7;
		--paper-light: #fcfaf5;
		--green: #b8ff43;
		--blue: #3156f5;
		--line: rgba(23, 24, 18, 0.2);
		min-height: 100vh;
		overflow: hidden;
		background:
			linear-gradient(rgba(23, 24, 18, 0.035) 1px, transparent 1px),
			linear-gradient(90deg, rgba(23, 24, 18, 0.035) 1px, transparent 1px),
			var(--paper);
		background-size: 36px 36px;
	}

	.audit-page > main { width: 100%; max-width: none; margin: 0; padding: 0; }
	.topbar, .hero, .section-shell, .page-footer { width: min(1180px, calc(100% - 48px)); margin: 0 auto; }

	.topbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		min-height: 82px;
		border-bottom: 1px solid var(--ink);
	}

	.brand { display: inline-flex; align-items: center; gap: 12px; color: var(--ink); font-size: 13px; font-weight: 800; letter-spacing: 0.08em; text-decoration: none; text-transform: uppercase; }
	.brand-mark { display: grid; width: 36px; height: 36px; place-items: center; background: var(--ink); color: white; font-size: 11px; }
	.topbar-link { color: var(--ink); font-size: 12px; font-weight: 800; text-transform: uppercase; }
	.topbar-link span { margin-left: 8px; color: #486700; }

	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1.65fr) minmax(330px, 0.75fr);
		gap: 74px;
		align-items: center;
		min-height: 780px;
		padding: 76px 0;
		border-bottom: 1px solid var(--ink);
	}

	.eyebrow, .section-label { margin: 0 0 24px; color: #3e570b; font-size: 12px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; }
	.eyebrow { display: flex; align-items: center; gap: 10px; color: var(--ink); }
	.eyebrow span { width: 28px; height: 3px; background: var(--blue); }
	.hero h1 { max-width: 820px; margin: 0; font-size: clamp(58px, 6.1vw, 94px); font-weight: 720; letter-spacing: -0.065em; line-height: 0.93; }
	.hero-note { display: inline-block; margin: 34px 0 20px; padding: 8px 12px; background: var(--green); font-size: 20px; font-weight: 700; transform: rotate(-1deg); }
	.hero-subhead { max-width: 720px; margin: 0; font-size: 21px; line-height: 1.5; }
	.hero-actions { display: grid; grid-template-columns: minmax(260px, 330px) minmax(180px, 1fr); gap: 22px; align-items: center; margin-top: 44px; }
	.hero-actions > p { margin: 0; font-size: 14px; line-height: 1.5; }

	.button { display: flex; align-items: center; justify-content: space-between; gap: 18px; min-height: 60px; padding: 17px 20px; border: 1px solid var(--ink); font-size: 13px; font-weight: 850; letter-spacing: 0.025em; line-height: 1.3; text-decoration: none; text-transform: uppercase; transition: transform 140ms ease, box-shadow 140ms ease; }
	.button:hover { transform: translate(-3px, -3px); box-shadow: 5px 5px 0 var(--blue); }
	.button-primary { background: var(--ink); color: white; }
	.button-primary strong { color: var(--green); }
	.button[aria-busy='true'] { opacity: 0.72; pointer-events: none; }

	.audit-card { position: relative; padding: 28px; border: 1px solid var(--ink); background: var(--paper-light); box-shadow: 14px 14px 0 var(--blue); }
	.audit-card::before { position: absolute; top: -14px; right: 18px; width: 84px; height: 24px; background: rgba(184, 255, 67, 0.75); content: ''; transform: rotate(2deg); }
	.audit-card-head, .audit-card-foot { display: flex; justify-content: space-between; gap: 16px; font-size: 10px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; }
	.audit-card-head { padding-bottom: 22px; border-bottom: 1px solid var(--line); }
	.status { display: flex; align-items: center; gap: 7px; }
	.status i { width: 7px; height: 7px; background: #5b7f16; }
	.price-lockup { display: flex; align-items: flex-end; gap: 18px; padding: 28px 0 20px; border-bottom: 1px solid var(--ink); }
	.price-lockup strong { font-size: 76px; letter-spacing: -0.07em; line-height: 0.85; }
	.price-lockup span { font-size: 12px; font-weight: 800; line-height: 1.2; text-transform: uppercase; }
	.audit-card ul { margin: 0; padding: 12px 0; list-style: none; }
	.audit-card li { padding: 13px 0; border-bottom: 1px solid var(--line); font-size: 14px; font-weight: 700; }
	.audit-card li::before { margin-right: 9px; color: var(--blue); content: '\2192'; }
	.audit-card-foot { padding-top: 22px; }
	.audit-card-foot div { display: grid; gap: 7px; }
	.audit-card-foot span { color: #6e6f66; }
	.audit-card-foot strong { font-size: 13px; }

	.section-shell { padding: 104px 0; border-bottom: 1px solid var(--ink); }
	.section-heading { display: grid; grid-template-columns: 0.85fr 1.6fr; gap: 28px 70px; align-items: start; margin-bottom: 52px; }
	.section-heading .section-label { grid-row: 1 / 3; }
	.section-heading h2, .credibility h2, .faq-block > h2, .final-cta h2 { margin: 0; font-size: clamp(40px, 4.6vw, 68px); letter-spacing: -0.05em; line-height: 0.98; }
	.section-heading > p:last-child { max-width: 700px; margin: 0; font-size: 17px; line-height: 1.55; }

	.snapshot-sheet { border: 1px solid var(--ink); background: var(--paper-light); box-shadow: 12px 12px 0 var(--green); }
	.snapshot-sheet > header { display: flex; align-items: flex-start; justify-content: space-between; gap: 30px; padding: 28px 32px; border-bottom: 1px solid var(--ink); }
	.snapshot-sheet header p { margin: 0 0 8px; color: #3e570b; font-size: 11px; font-weight: 850; letter-spacing: 0.11em; text-transform: uppercase; }
	.snapshot-sheet header h3 { margin: 0; font-size: clamp(28px, 3vw, 44px); letter-spacing: -0.035em; }
	.snapshot-sheet header > span { padding: 7px 10px; border: 1px solid var(--ink); font-size: 10px; font-weight: 850; letter-spacing: 0.1em; text-transform: uppercase; }
	.snapshot-grid { display: grid; grid-template-columns: 1fr 1fr; }
	.snapshot-grid section { position: relative; min-height: 290px; padding: 34px; border-right: 1px solid var(--ink); border-bottom: 1px solid var(--ink); }
