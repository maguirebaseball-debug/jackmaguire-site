		padding: 17px;
		border: 1px solid var(--ink);
		background: var(--paper-light);
	}

	.guarantee-ladder article > span {
		color: var(--blue);
		font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
		font-size: 0.72rem;
		font-weight: 800;
	}

	.guarantee-ladder h3 {
		margin: 28px 0 10px;
		font-family: var(--font-heading), Arial, sans-serif;
		font-size: 1.15rem;
		line-height: 1.1;
