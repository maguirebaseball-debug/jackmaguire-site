	/* Editorial audit room: the page should feel reviewed, filed, and ready to act on. */
	.audit-page {
		--paper: #eee9de;
		--paper-light: #fbfaf5;
		--ink: #11120f;
		--blue: #164fd1;
		--green: #d4f34a;
		--muted: #6f706a;
		--line: rgba(17, 18, 15, 0.24);
		font-family: Arial, Helvetica, sans-serif;
		background-color: var(--paper);
		background-image:
			linear-gradient(rgba(17, 18, 15, 0.045) 1px, transparent 1px),
			linear-gradient(90deg, rgba(17, 18, 15, 0.045) 1px, transparent 1px);
		background-size: 32px 32px;
	}

	.audit-page::after {
		position: fixed;
		inset: 0;
		z-index: 20;
		pointer-events: none;
		content: '';
		box-shadow: inset 0 0 0 1px rgba(17, 18, 15, 0.08);
	}

	.topbar { min-height: 76px; border-bottom: 2px solid var(--ink); }
	.brand { font-family: 'Arial Narrow', Arial, sans-serif; font-size: 12px; letter-spacing: 0.13em; }
	.brand-mark { width: 32px; height: 32px; background: var(--blue); font-size: 10px; }
	.topbar-link { font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: 10px; letter-spacing: 0.08em; }
	.topbar-link span { color: var(--blue); }

	.hero {
		position: relative;
		grid-template-columns: minmax(0, 1.42fr) minmax(340px, 0.78fr);
		gap: 86px;
		min-height: 720px;
		padding: 92px 0 104px;
		border-bottom: 2px solid var(--ink);
	}
	.hero::before,
	.hero::after {
		position: absolute;
		z-index: 0;
		font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
		font-size: 10px;
		letter-spacing: 0.08em;
		line-height: 1.5;
		white-space: pre;
	}
	.hero::before {
		top: 38px;
		right: 4%;
		padding: 12px 14px;
		border: 1px solid var(--line);
		background: var(--paper-light);
		color: var(--muted);
		content: 'REVIEW SHEET  /  001\\A TASK: ONE REPEATED COMPUTER WORKFLOW\\A STATUS: READY FOR A HUMAN DECISION';
		transform: rotate(2deg);
	}
	.hero::after {
		right: 31%;
		bottom: 36px;
		width: 54px;
		height: 10px;
		border-top: 3px solid var(--blue);
		border-bottom: 3px solid var(--blue);
		content: '';
		transform: rotate(-8deg);
	}
	.hero-copy, .audit-card { position: relative; z-index: 1; }
	.eyebrow, .section-label, .audit-card-head, .audit-card-foot, .report-kicker,
	.snapshot-sheet header p, .snapshot-sheet header > span, .checkout-card > span,
	.page-footer { font-family: ui-monospace, SFMono-Regular, Consolas, monospace; }
	.eyebrow { margin-bottom: 30px; font-size: 10px; letter-spacing: 0.1em; }
	.eyebrow span { width: 40px; height: 2px; background: var(--blue); }
	.hero h1 { max-width: 790px; font-family: 'Arial Narrow', Arial, sans-serif; font-size: clamp(64px, 7.1vw, 108px); font-weight: 800; letter-spacing: -0.075em; line-height: 0.87; }
	.hero-subhead { max-width: 625px; margin-top: 34px; font-size: 20px; font-weight: 700; line-height: 1.4; }
	.hero-qualifier { max-width: 600px; margin-top: 14px; color: #4e504b; font-size: 14px; line-height: 1.55; }
	.hero-actions { grid-template-columns: minmax(260px, 344px) minmax(180px, 1fr); margin-top: 36px; }
	.hero-actions > p { color: #4e504b; font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: 11px; }

	.button { min-height: 58px; border: 2px solid var(--ink); font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: 11px; letter-spacing: 0.04em; }
	.button:hover { transform: translate(-4px, -4px); box-shadow: 6px 6px 0 var(--blue); }
	.button-primary { background: var(--blue); color: white; }
	.button-primary strong { color: var(--green); }

	.audit-card { padding: 28px; border: 2px solid var(--ink); box-shadow: 16px 16px 0 var(--blue); }
	.audit-card::before { top: -12px; right: 24px; width: 90px; height: 20px; background: var(--green); opacity: 0.9; }
	.audit-card-head { padding-bottom: 20px; font-size: 9px; }
	.status i { background: var(--green); border: 1px solid var(--ink); }
	.price-lockup { padding: 30px 0 22px; }
	.price-lockup strong { font-family: 'Arial Narrow', Arial, sans-serif; font-size: 86px; }
	.price-lockup span, .audit-card li, .audit-card-foot strong { font-family: Arial, Helvetica, sans-serif; }
	.audit-card li::before { color: var(--blue); }

	.section-shell { padding: 112px 0; border-bottom: 2px solid var(--ink); }
	.section-heading { grid-template-columns: 0.7fr 1.6fr; gap: 28px 72px; margin-bottom: 54px; }
	.section-label { position: relative; padding-left: 24px; color: var(--blue); font-size: 10px; letter-spacing: 0.08em; }
	.section-label::before { position: absolute; top: -2px; left: 0; color: var(--blue); content: '['; font-size: 17px; line-height: 1; }
	.section-label::after { position: absolute; top: 1px; left: 9px; width: 7px; height: 7px; background: var(--green); content: ''; }
	.section-label-dark { color: var(--green); }
	.section-heading h2, .credibility h2, .faq-block > h2, .final-cta h2, .diy-section h2 { font-family: 'Arial Narrow', Arial, sans-serif; font-weight: 800; letter-spacing: -0.065em; }
	.section-heading h2, .credibility h2, .faq-block > h2, .final-cta h2 { font-size: clamp(46px, 5.1vw, 76px); line-height: 0.9; }
	.section-heading > p:last-child { color: #4e504b; font-size: 16px; }

	.decision-grid, .process-grid, .task-grid { border-top: 2px solid var(--ink); border-left: 2px solid var(--ink); }
	.decision-grid article, .process-grid article, .task-grid article { border-right: 2px solid var(--ink); border-bottom: 2px solid var(--ink); }
	.decision-grid article { min-height: 248px; padding: 26px; }
	.decision-grid article:nth-child(2), .process-grid article:nth-child(2) { background: #e4e9f6; }
	.decision-grid article:nth-child(3), .math-cell { background: var(--green); }
	.decision-grid article > span, .process-grid article > span { color: var(--blue); font-family: ui-monospace, SFMono-Regular, Consolas, monospace; }
	.process-grid article > span { background: var(--blue); }
	.decision-grid strong, .process-grid strong { font-family: 'Arial Narrow', Arial, sans-serif; font-size: 25px; }
	.decision-grid p, .process-grid p { color: #4e504b; }
	.privacy-strip { border: 2px solid var(--ink); background: var(--green); }

	.diy-copy { border-left: 1px solid rgba(123,127,232,0.34); }
	.diy-copy p { font-size: 18px; }
	.task-chips span { border: 2px solid var(--ink); background: var(--paper-light); font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: 11px; }
	.task-chips span:nth-child(2n) { background: var(--paper-light); }
	.task-chips span:nth-child(3n) { background: var(--green); }
	.not-fit { border-top: 2px solid var(--ink); }

	.snapshot-sheet { border: 2px solid var(--ink); box-shadow: 14px 14px 0 var(--green); }
	.snapshot-sheet > header { padding: 26px 30px; border-bottom: 2px solid var(--ink); }
	.snapshot-sheet header h3 { font-family: 'Arial Narrow', Arial, sans-serif; font-size: clamp(32px, 3.5vw, 52px); font-weight: 800; letter-spacing: -0.06em; }
	.snapshot-sheet header > span { border: 2px solid var(--ink); }
	.snapshot-grid section { min-height: 310px; border-right: 2px solid var(--ink); border-bottom: 2px solid var(--ink); }
	.snapshot-grid section:nth-child(even) { border-right: 0; }
	.report-number { font-family: 'Arial Narrow', Arial, sans-serif; color: rgba(17,18,15,0.18); font-size: 54px; }
	.report-kicker { color: var(--blue); }
	.snapshot-grid h4 { font-family: 'Arial Narrow', Arial, sans-serif; font-size: 26px; font-weight: 800; letter-spacing: -0.045em; }
	.recommendation-cell { background: #e4e9f6; }
	.big-math strong { font-family: 'Arial Narrow', Arial, sans-serif; font-size: 100px; }
	.snapshot-sheet > footer { border-top: 0; }
	.snapshot-sheet footer span { color: var(--blue); }

	.credibility img { border: 2px solid var(--ink); }
	.proof-row { border-top: 2px solid var(--ink); border-bottom: 2px solid var(--ink); }
	.proof-row div { border-right: 2px solid var(--ink); }
	.proof-row strong { font-family: 'Arial Narrow', Arial, sans-serif; }

	.guarantee-card { border: 2px solid var(--ink); box-shadow: 14px 14px 0 var(--green); }
	.guarantee-number strong { font-family: 'Arial Narrow', Arial, sans-serif; }
	.faq-list { border-top: 2px solid var(--ink); }
	.faq-list details { border-bottom: 2px solid var(--ink); }
	.faq-list summary { font-family: 'Arial Narrow', Arial, sans-serif; font-size: 19px; }

	.final-cta { background: var(--blue); }
	.checkout-card { border: 2px solid var(--ink); box-shadow: 14px 14px 0 var(--green); }
	.checkout-card div strong { font-family: 'Arial Narrow', Arial, sans-serif; }
	.button-light { background: var(--ink); }
	.page-footer { border-top: 2px solid var(--ink); }

	@media (max-width: 680px) {
		.hero { padding-top: 72px; }
		.hero::before { top: 18px; right: 0; font-size: 8px; }
		.hero h1 { font-size: clamp(54px, 15vw, 76px); }
		.section-shell { padding: 80px 0; }
		.section-heading h2, .credibility h2, .final-cta h2 { font-size: 49px; }
		.audit-card, .guarantee-card, .checkout-card { box-shadow: 8px 8px 0 var(--blue); }
		.guarantee-card, .checkout-card { box-shadow: 8px 8px 0 var(--green); }
	}

	/* Calm guided-space direction, based on the supplied lavender editorial reference. */
	.audit-page {
		--paper: #f1f0ff;
		--paper-light: rgba(255, 255, 255, 0.82);
		--ink: #171722;
		--blue: #7b7fe8;
