		align-items: flex-end;
		gap: 14px;
		margin: 28px 0 22px;
	}

	.time-number strong {
		font-family: var(--font-heading), Arial, sans-serif;
		font-size: clamp(4.8rem, 8vw, 7rem);
		letter-spacing: -0.08em;
		line-height: 0.72;
	}

	.time-number span {
		font-size: 0.76rem;
		font-weight: 800;
		line-height: 1.35;
		text-transform: uppercase;
	}

	.mini-chart {
		display: flex;
		align-items: flex-end;
		gap: 8px;
		height: 120px;
		padding: 12px 0 0;
		border-top: 1px dashed var(--line);
		border-bottom: 1px solid var(--ink);
	}

	.mini-chart span {
		flex: 1;
		background: var(--green);
		border: 1px solid var(--ink);
		border-bottom: 0;
	}

	.audit-card-foot {
		gap: 20px;
		padding-top: 18px;
	}

	.audit-card-foot div {
		display: flex;
		flex-direction: column;
		gap: 5px;
	}

	.audit-card-foot span {
		color: #696b61;
		font-size: 0.67rem;
		font-weight: 700;
		text-transform: uppercase;
	}

	.audit-card-foot strong {
		font-size: 0.95rem;
	}

	.hero-tier-list {
		display: grid;
		margin: 20px 0;
		border-top: 1px solid var(--ink);
	}

	.hero-tier-list a {
		display: grid;
		grid-template-columns: 34px 1fr auto;
		gap: 12px;
		align-items: center;
		padding: 20px 4px;
		border-bottom: 1px solid var(--ink);
		color: var(--ink);
		text-decoration: none;
		transition: background 160ms ease, padding 160ms ease;
	}

	.hero-tier-list a:hover,
	.hero-tier-list a:focus-visible {
		padding-right: 10px;
		padding-left: 10px;
		background: var(--green);
	}

	.hero-tier-list span {
		color: var(--blue);
		font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
		font-size: 0.68rem;
		font-weight: 800;
	}

	.hero-tier-list strong {
		font-family: var(--font-heading), Arial, sans-serif;
		font-size: 1.1rem;
	}

	.hero-tier-list b {
		font-size: 1.18rem;
	}

	.ticker {
		display: flex;
		justify-content: center;
		border-top: 1px solid var(--ink);
		border-bottom: 1px solid var(--ink);
		background: var(--green);
		overflow: hidden;
	}

	.ticker span {
		position: relative;
		flex: 0 0 auto;
		padding: 16px 34px;
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.ticker span + span::before {
		position: absolute;
		left: 0;
		content: '•';
	}

	.section-pad {
		padding-top: clamp(90px, 11vw, 150px);
		padding-bottom: clamp(90px, 11vw, 150px);
	}

	.section-intro {
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(320px, 0.55fr);
		gap: 70px;
		align-items: end;
		margin-bottom: 70px;
	}

	.section-intro .section-label {
		grid-column: 1 / -1;
		margin-bottom: -40px;
		color: var(--green-dark);
	}

	.section-intro h2,
	.offers h2,
	.solution h2,
	.report h2,
	.roi h2,
	.guarantee h2,
	.booking h2 {
		margin: 0;
		font-size: clamp(2.7rem, 5.3vw, 5.3rem);
		line-height: 0.98;
	}

	.offers {
		border-bottom: 1px solid var(--ink);
	}

	.offers .section-label {
		color: var(--green-dark);
	}

	.tier-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 18px;
	}

	.tier-card {
		display: flex;
		min-height: 760px;
		padding: 25px;
		flex-direction: column;
		border: 1px solid var(--ink);
		background: var(--paper-light);
	}

	.tier-card.featured {
		background: var(--green);
		box-shadow: 10px 10px 0 var(--ink);
		transform: translateY(-10px);
	}

	.tier-card.full {
		background: var(--ink);
		color: #fff;
	}

	.tier-card.full h3 {
		color: #fff;
	}

	.tier-topline {
		display: flex;
		justify-content: space-between;
		gap: 10px;
		font-size: 0.65rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.tier-topline strong {
		color: var(--blue);
	}

	.tier-card.full .tier-topline strong {
		color: var(--green);
	}

	.tier-card h3 {
		min-height: 68px;
		margin: 42px 0 8px;
		font-family: var(--font-heading), Arial, sans-serif;
		font-size: clamp(1.65rem, 2.4vw, 2.25rem);
		line-height: 1.02;
	}

	.tier-price {
		display: flex;
		align-items: flex-start;
		margin: 5px 0 20px;
		font-family: var(--font-heading), Arial, sans-serif;
		font-size: 5.2rem;
		font-weight: 800;
		letter-spacing: -0.08em;
		line-height: 0.9;
	}

	.tier-price span {
		margin: 7px 4px 0 0;
		font-size: 1.25rem;
		letter-spacing: 0;
	}

	.tier-fit {
		min-height: 95px;
		margin: 0;
		font-size: 0.86rem;
		line-height: 1.55;
	}

	.tier-card ul {
		display: grid;
		gap: 10px;
		margin: 26px 0;
		padding: 20px 0 0;
		border-top: 1px solid currentColor;
		list-style: none;
	}

	.tier-card li {
		padding-left: 19px;
		font-size: 0.79rem;
		font-weight: 700;
		line-height: 1.4;
	}

	.tier-card li::before {
		margin-left: -19px;
		margin-right: 9px;
		color: var(--blue);
		content: '✓';
	}

	.tier-card.full li::before {
		color: var(--green);
	}

	.tier-guarantee {
		margin: 0 0 20px;
		padding: 16px;
		border: 1px solid currentColor;
		background: rgba(255, 255, 255, 0.34);
	}

	.tier-card.full .tier-guarantee {
		background: rgba(184, 255, 67, 0.08);
	}

	.tier-guarantee > span {
		display: block;
		margin-bottom: 8px;
		color: var(--blue);
		font-size: 0.65rem;
		font-weight: 800;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.tier-card.full .tier-guarantee > span {
		color: var(--green);
	}

	.tier-guarantee p {
		margin: 0;
		font-size: 0.75rem;
		font-weight: 700;
		line-height: 1.5;
	}

	.tier-turnaround {
		display: flex;
		justify-content: space-between;
		gap: 14px;
		margin-top: auto;
		padding: 14px 0;
		border-top: 1px solid currentColor;
		font-size: 0.68rem;
		text-transform: uppercase;
	}

	.tier-turnaround span {
		opacity: 0.65;
	}

	.tier-button {
		width: 100%;
		margin-top: 12px;
		background: var(--blue);
		border-color: currentColor;
		color: #fff;
	}

	.tier-card.full .tier-button {
		background: var(--green);
		color: var(--ink);
	}

	.tier-credit {
		margin: 15px 0 0;
		font-size: 0.7rem;
		font-weight: 700;
		line-height: 1.45;
	}

	.payment-note {
		max-width: 880px;
		margin: 44px auto 0;
		padding: 18px 20px;
		border: 1px solid var(--ink);
		background: rgba(255, 255, 255, 0.48);
		font-size: 0.78rem;
		line-height: 1.55;
		text-align: center;
	}

	.section-intro > p:last-child,
	.solution-copy > p,
	.report-head > p,
	.roi-copy > p:last-child,
	.guarantee-copy > p,
	.booking-copy > p {
		margin: 0;
		font-size: 1.02rem;
		line-height: 1.72;
	}

	.pain-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		border-top: 1px solid var(--ink);
		border-bottom: 1px solid var(--ink);
	}

	.pain-card {
		min-height: 285px;
		padding: 24px;
	}

	.pain-card + .pain-card {
		border-left: 1px solid var(--ink);
	}

	.pain-card > span,
	.report-row > span {
		color: var(--blue);
		font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
		font-size: 0.72rem;
		font-weight: 800;
	}

	.pain-card h3 {
		margin: 74px 0 14px;
		font-family: var(--font-heading), Arial, sans-serif;
		font-size: 1.3rem;
		line-height: 1.15;
	}

	.pain-card p {
		margin: 0;
		color: #4e5048;
		font-size: 0.88rem;
		line-height: 1.6;
	}

	.problem-close {
		max-width: 800px;
		margin: 54px 0 0 auto;
		padding-left: 28px;
		border-left: 5px solid var(--green);
		font-family: var(--font-heading), Arial, sans-serif;
		font-size: clamp(1.35rem, 2.4vw, 2rem);
		font-weight: 700;
		line-height: 1.35;
	}

	.solution {
		display: grid;
		grid-template-columns: minmax(0, 0.85fr) minmax(430px, 0.8fr);
		gap: clamp(70px, 10vw, 140px);
		align-items: center;
		border-top: 1px solid var(--ink);
	}

	.solution .section-label,
	.report .section-label,
	.guarantee .section-label {
		color: var(--green-dark);
	}

	.solution-copy > p {
		margin-top: 25px;
	}

	.check-list {
		display: grid;
		gap: 12px;
		margin: 32px 0 0;
		padding: 0;
		list-style: none;
	}

	.check-list li {
		display: flex;
		align-items: center;
		gap: 11px;
		font-size: 0.88rem;
		font-weight: 700;
	}

	.check-list span {
		display: grid;
		width: 23px;
		height: 23px;
		place-items: center;
		background: var(--green);
		border: 1px solid var(--ink);
		font-size: 0.76rem;
	}

	.matrix-wrap {
		position: relative;
		padding: 18px 18px 58px 58px;
		border: 1px solid var(--ink);
		background: var(--paper-light);
		box-shadow: 12px 12px 0 var(--ink);
	}

	.matrix-title {
		display: flex;
		justify-content: space-between;
		margin-bottom: 15px;
		font-size: 0.68rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.matrix-title strong {
		color: var(--green-dark);
	}

	.matrix {
		display: grid;
		grid-template-columns: 1fr 1fr;
		grid-template-rows: 1fr 1fr;
		aspect-ratio: 1 / 0.78;
		border: 1px solid var(--ink);
	}

	.quadrant {
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		padding: 16px;
		overflow: hidden;
	}

	.quadrant:nth-child(odd) {
		border-right: 1px solid var(--ink);
	}

	.quadrant:nth-child(-n + 2) {
		border-bottom: 1px solid var(--ink);
	}

	.quadrant span {
		font-size: 0.72rem;
		font-weight: 800;
		text-transform: uppercase;
	}

	.quadrant small {
		font-size: 0.66rem;
		line-height: 1.35;
	}

	.quick {
		background: var(--green);
	}

	.project,
	.filler,
	.avoid {
		color: #76786f;
	}

	.avoid {
		background: rgba(23, 24, 18, 0.05);
	}

	.pulse {
		position: absolute;
		width: 13px;
		height: 13px;
		border: 2px solid var(--ink);
		background: var(--blue);
		box-shadow: 0 0 0 4px rgba(49, 86, 245, 0.17);
	}

	.pulse.one { top: 52%; left: 28%; }
	.pulse.two { top: 37%; left: 55%; }
	.pulse.three { top: 62%; left: 70%; }

	.axis {
		position: absolute;
		font-size: 0.62rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.axis span,
	.axis b {
		position: absolute;
		font-size: 0.55rem;
		font-weight: 700;
	}

	.axis-y {
		bottom: 47%;
		left: 13px;
		transform: rotate(-90deg);
	}

	.axis-y span { right: 74px; }
	.axis-y b { left: 62px; }
	.axis-x {
		bottom: 21px;
		left: 48%;
	}

	.axis-x span { right: 65px; }
	.axis-x b { left: 52px; }

	.process {
		border-top: 1px solid var(--ink);
	}

	.section-intro.compact {
		display: block;
		max-width: 850px;
	}

	.section-intro.compact .section-label {
		margin-bottom: 22px;
	}

	.process-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 18px;
	}

	.process-step {
		min-height: 350px;
		padding: 25px;
		border: 1px solid var(--ink);
		background: var(--paper-light);
	}

	.process-step:nth-child(2) {
		background: var(--ink);
		color: #fff;
		transform: translateY(24px);
	}

	.step-meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.step-meta strong {
		display: grid;
		width: 42px;
		height: 42px;
		place-items: center;
		border: 1px solid currentColor;
		font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
	}

	.step-meta span {
		padding: 6px 9px;
		background: var(--green);
		color: var(--ink);
		font-size: 0.68rem;
		font-weight: 800;
		text-transform: uppercase;
	}

	.process-step h3 {
		margin: 100px 0 14px;
		font-family: var(--font-heading), Arial, sans-serif;
		font-size: 1.55rem;
	}

	.process-step p {
		margin: 0;
		font-size: 0.9rem;
		line-height: 1.65;
	}

	.report {
		border-top: 1px solid var(--ink);
	}

	.report-head {
		display: grid;
		grid-template-columns: 1fr 0.48fr;
		gap: 80px;
		align-items: end;
		margin-bottom: 60px;
	}

	.report-list {
		border-top: 1px solid var(--ink);
	}

	.report-row {
		display: grid;
		grid-template-columns: 70px minmax(220px, 0.55fr) 1fr;
		gap: 30px;
		align-items: center;
		padding: 28px 0;
		border-bottom: 1px solid var(--ink);
	}

	.report-row h3 {
		margin: 0;
		font-family: var(--font-heading), Arial, sans-serif;
		font-size: 1.2rem;
	}

	.report-row p {
		margin: 0;
		font-size: 0.88rem;
		line-height: 1.6;
	}

	.roi {
		display: grid;
		grid-template-columns: minmax(280px, 0.7fr) 1fr;
		gap: 90px;
		align-items: center;
		width: 100%;
		max-width: none;
		padding-right: max(24px, calc((100vw - 1180px) / 2));
		padding-left: max(24px, calc((100vw - 1180px) / 2));
		background: var(--blue);
		color: #fff;
	}

	.section-label.light {
		color: var(--green);
	}

	.roi-copy > p:last-child {
		margin-top: 25px;
		color: rgba(255, 255, 255, 0.78);
	}

	.roi-stats {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		border: 1px solid #fff;
	}

	.roi-stats div {
		display: flex;
		min-height: 220px;
		padding: 24px;
		flex-direction: column;
		justify-content: space-between;
	}

	.roi-stats div + div {
		border-left: 1px solid #fff;
	}

	.roi-stats strong {
		font-family: var(--font-heading), Arial, sans-serif;
		font-size: clamp(2.5rem, 4vw, 4.2rem);
		letter-spacing: -0.06em;
		line-height: 0.95;
	}

	.roi-stats span {
		font-size: 0.7rem;
		font-weight: 800;
		line-height: 1.45;
		text-transform: uppercase;
	}

	.guarantee {
		display: grid;
		grid-template-columns: 280px 1fr;
		gap: 80px;
		align-items: center;
	}

	.guarantee-badge {
		display: grid;
		width: 250px;
		height: 250px;
		place-content: center;
		border: 2px solid var(--ink);
		background: var(--green);
		box-shadow: 14px 14px 0 var(--ink);
		text-align: center;
		transform: rotate(-3deg);
	}

	.guarantee-badge span {
		font-family: var(--font-heading), Arial, sans-serif;
		font-size: 6.4rem;
		font-weight: 800;
		letter-spacing: -0.1em;
		line-height: 0.78;
	}

	.guarantee-badge small {
		margin-top: 12px;
		font-size: 0.9rem;
		font-weight: 800;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	.guarantee-copy > p {
		max-width: 760px;
		margin-top: 24px;
	}

	.guarantee-ladder {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 12px;
		margin-top: 32px;
