---
import BaseHead from '../components/BaseHead.astro';

const title = 'Your AI Audit | Reclaim 5+ Hours Every Week';
const description = 'A personalized AI tools assessment for business owners who want to save at least five hours a week with simple, off-the-shelf software.';
const bookingKey = '0d5ededb-778b-452f-b8f0-72ebb2e4e461';

const painPoints = [
	{
		number: '01',
		title: 'Your inbox eats the morning.',
		copy: 'Messages pile up faster than you can sort, answer, and turn them into next steps.',
	},
	{
		number: '02',
		title: 'Lead follow-up moves too slowly.',
		copy: 'Good prospects wait while you copy details, write replies, and update the same information twice.',
	},
	{
		number: '03',
		title: 'Meetings end without action.',
		copy: 'You have transcripts and notes, but decisions, owners, and deadlines still need to be pulled out by hand.',
	},
	{
		number: '04',
		title: 'Reporting steals the weekend.',
		copy: 'The data exists. You still spend hours cleaning it, organizing it, and rebuilding the same update.',
	},
];

const process = [
	{
		number: '1',
		time: '45 minutes',
		title: 'The discovery call',
		copy: 'Walk me through your workday, where tasks pile up, and what you dread doing. You do not need to prepare anything.',
	},
	{
		number: '2',
		time: 'Done for you',
		title: 'The analysis',
		copy: 'I map each bottleneck to a directory of thousands of AI tools, remove the noise, and select the 3 to 7 options that fit your business.',
	},
	{
		number: '3',
		time: '30 minutes',
		title: 'The review call',
		copy: 'We review your custom report on screen. You will see what each tool does, why it made the cut, and exactly how to deploy it.',
	},
];

const reportSections = [
	{
		number: '01',
		title: 'Executive summary',
		copy: 'A one-page snapshot of your main bottlenecks and the total hours you can reclaim.',
	},
	{
		number: '02',
		title: 'Effort vs. impact matrix',
		copy: 'A clear view of why these tools beat complex, high-effort enterprise software for your current needs.',
	},
	{
		number: '03',
		title: 'Recommended solutions',
		copy: 'Each tool, the pain point it solves, monthly cost, estimated setup time, and expected weekly savings.',
	},
	{
		number: '04',
		title: '4-day quick start plan',
		copy: 'A day-by-day guide that lets you deploy the full stack in four 10-minute sessions.',
	},
	{
		number: '05',
		title: 'Financial impact analysis',
		copy: 'The net monthly return based on time saved, your effective hourly rate, and the actual tool costs.',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} ogImage="/your-ai-audit-og.png" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
		<script type="application/ld+json" set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'Service',
			name: 'Personalized AI Tools Assessment',
			description,
			provider: {
				'@type': 'Person',
				name: 'Jack Maguire',
				url: 'https://jackmaguire.org/',
			},
			areaServed: 'US',
			offers: {
				'@type': 'Offer',
				price: '999',
				priceCurrency: 'USD',
				url: 'https://jackmaguire.org/Your-AI-Audit/#book',
			},
		})} />
	</head>
	<body>
		<div class="audit-page">
			<header class="topbar">
				<a class="brand" href="/" aria-label="Jack Maguire home">
					<span class="brand-mark" aria-hidden="true">JM</span>
					<span>Your AI Audit</span>
				</a>
				<a class="topbar-link" href="#book">Book assessment <span>$999</span></a>
			</header>

			<main>
				<section class="hero" aria-labelledby="hero-title">
					<div class="hero-copy">
						<p class="eyebrow"><span></span> AI tools assessment for owners and operators</p>
						<h1 id="hero-title">Reclaim 5+ hours of your workweek.</h1>
						<p class="hero-note">No coding or AI expertise required.</p>
						<p class="hero-subhead">Get a personalized assessment that prescribes simple, off-the-shelf software for your exact operational bottlenecks.</p>
						<div class="hero-actions">
							<a class="button button-primary" href="#book">Book your assessment <span>$999</span></a>
							<p><strong>100% money-back guarantee.</strong> If I cannot find a way to save you at least five hours a week, you get a full refund.</p>
						</div>
					</div>

					<aside class="audit-card" aria-label="Typical assessment outcome">
						<div class="audit-card-head">
							<span>Typical outcome</span>
							<span class="status"><i></i> Quick wins found</span>
						</div>
						<div class="time-number">
							<strong>6-7</strong>
							<span>hours saved<br />each week</span>
						</div>
						<div class="mini-chart" aria-hidden="true">
							<span style="height: 28%"></span>
							<span style="height: 36%"></span>
							<span style="height: 47%"></span>
							<span style="height: 61%"></span>
							<span style="height: 75%"></span>
							<span style="height: 91%"></span>
						</div>
						<div class="audit-card-foot">
							<div><span>Tool spend</span><strong>$40-$60/mo</strong></div>
							<div><span>Tools selected</span><strong>3-7</strong></div>
						</div>
					</aside>
				</section>

				<section class="ticker" aria-label="Assessment highlights">
					<span>45-minute discovery</span>
					<span>3-7 tools selected</span>
					<span>Zero coding</span>
					<span>4-day rollout</span>
					<span>5-hour guarantee</span>
				</section>

				<section class="problem section-pad" aria-labelledby="problem-title">
					<div class="section-intro">
						<p class="section-label">The problem</p>
						<h2 id="problem-title">You need leverage. You do not have time to become an AI expert.</h2>
						<p>You are running a successful business, but the day-to-day operations are running you. The problem is rarely a lack of software. It is knowing which tool will remove a real bottleneck without creating another system to manage.</p>
					</div>
					<div class="pain-grid">
						{painPoints.map((point) => (
							<article class="pain-card">
								<span>{point.number}</span>
								<h3>{point.title}</h3>
								<p>{point.copy}</p>
							</article>
						))}
					</div>
					<p class="problem-close">You do not need a custom-coded enterprise transformation. You need a few tools that fix the work slowing you down today.</p>
				</section>

				<section class="solution section-pad" aria-labelledby="solution-title">
					<div class="solution-copy">
						<p class="section-label">The solution</p>
						<h2 id="solution-title">High impact. Low effort. Nothing else makes the cut.</h2>
						<p>I act as your AI concierge. I audit your workflows and focus on the top-left quadrant of the effort vs. impact matrix: the quick wins.</p>
						<p>These are off-the-shelf AI and SaaS tools that require no technical skill to maintain, cost an average of $40 to $60 per month in total, and start returning time within days.</p>
						<ul class="check-list">
							<li><span aria-hidden="true">✓</span> Fits your current team and workflow</li>
							<li><span aria-hidden="true">✓</span> Setup measured in minutes, not months</li>
							<li><span aria-hidden="true">✓</span> Clear owner, cost, and weekly payoff</li>
						</ul>
					</div>

					<div class="matrix-wrap">
						<div class="matrix-title"><span>Effort vs. impact</span><strong>Selection zone</strong></div>
						<div class="matrix">
							<div class="quadrant quick"><span>Quick wins</span><small>High impact<br />Low effort</small><i class="pulse one"></i><i class="pulse two"></i><i class="pulse three"></i></div>
							<div class="quadrant project"><span>Major projects</span><small>High impact<br />High effort</small></div>
							<div class="quadrant filler"><span>Fill-ins</span><small>Low impact<br />Low effort</small></div>
							<div class="quadrant avoid"><span>Avoid</span><small>Low impact<br />High effort</small></div>
						</div>
						<div class="axis axis-y">Impact <span>Low</span><b>High</b></div>
						<div class="axis axis-x">Effort <span>Low</span><b>High</b></div>
					</div>
				</section>

				<section class="process section-pad" aria-labelledby="process-title">
					<div class="section-intro compact">
						<p class="section-label">How it works</p>
						<h2 id="process-title">Seventy-five minutes of your time. A complete plan on the other side.</h2>
					</div>
					<div class="process-grid">
						{process.map((step) => (
							<article class="process-step">
								<div class="step-meta"><strong>{step.number}</strong><span>{step.time}</span></div>
								<h3>{step.title}</h3>
								<p>{step.copy}</p>
							</article>
						))}
					</div>
				</section>

				<section class="report section-pad" aria-labelledby="report-title">
					<div class="report-head">
						<div>
							<p class="section-label">Inside your report</p>
							<h2 id="report-title">A roadmap built for Monday morning.</h2>
						</div>
						<p>The deliverable is a clear execution plan, not a technical manual. Every recommendation includes the information you need to make a decision and put it to work.</p>
					</div>
					<div class="report-list">
						{reportSections.map((item) => (
							<article class="report-row">
								<span>{item.number}</span>
								<h3>{item.title}</h3>
								<p>{item.copy}</p>
							</article>
						))}
					</div>
				</section>

				<section class="roi section-pad" aria-labelledby="roi-title">
					<div class="roi-copy">
						<p class="section-label light">The return</p>
						<h2 id="roi-title">The math is simple.</h2>
						<p>Recover six hours a week and you get roughly 26 hours back every month. Your report calculates what those hours are worth at your effective rate, then subtracts the actual software cost.</p>
					</div>
					<div class="roi-stats">
						<div><strong>6-7</strong><span>average weekly<br />hours saved</span></div>
						<div><strong>$40-$60</strong><span>average total<br />monthly tool cost</span></div>
						<div><strong>4 days</strong><span>to complete the<br />quick start plan</span></div>
					</div>
				</section>

				<section class="guarantee section-pad" aria-labelledby="guarantee-title">
					<div class="guarantee-badge" aria-hidden="true"><span>5+</span><small>hours</small></div>
					<div class="guarantee-copy">
						<p class="section-label">The guarantee</p>
						<h2 id="guarantee-title">I find five hours, or you pay nothing.</h2>
						<p>If I cannot identify at least five hours per week of time-saving AI implementations during your assessment, I will refund 100% of your $999 fee.</p>
						<div class="outcomes">
							<p><span>Worst case</span>You spend 45 minutes showing me your workflow.</p>
							<p><span>Best case</span>You get an entire working day back every week.</p>
						</div>
					</div>
				</section>

				<section id="book" class="booking section-pad" aria-labelledby="book-title">
					<div class="booking-copy">
						<p class="section-label light">Ready when you are</p>
						<h2 id="book-title">Reclaim your time.</h2>
						<p>Send your details below. I will reply with available times and the next step for booking your $999 assessment.</p>
						<ul>
							<li>45-minute discovery call</li>
							<li>Custom tool and ROI report</li>
							<li>30-minute review call</li>
							<li>Five-hour money-back guarantee</li>
						</ul>
					</div>

					<div class="form-shell">
						<form id="audit-form" action="https://api.web3forms.com/submit" method="POST">
							<input type="hidden" name="access_key" value={bookingKey} />
							<input type="hidden" name="subject" value="New AI Audit booking request" />
							<input type="hidden" name="from_name" value="Your AI Audit landing page" />
							<input type="checkbox" name="botcheck" class="botcheck" tabindex="-1" autocomplete="off" />

							<div class="form-grid">
								<label>
									<span>Your name</span>
									<input type="text" name="name" required autocomplete="name" />
								</label>
								<label>
									<span>Work email</span>
									<input type="email" name="email" required autocomplete="email" />
								</label>
							</div>

							<label>
								<span>Company or business</span>
								<input type="text" name="company" required autocomplete="organization" />
							</label>

							<label>
								<span>Where do you lose the most time?</span>
								<select name="primary_bottleneck" required>
									<option value="" selected disabled>Select one</option>
									<option>Inbox and communication</option>
									<option>Lead follow-up and sales</option>
									<option>Meetings and project handoffs</option>
									<option>Reporting and analytics</option>
									<option>Something else</option>
								</select>
							</label>

							<label>
								<span>What keeps getting pushed to nights or weekends?</span>
								<textarea name="notes" rows="4" placeholder="A sentence or two is enough."></textarea>
							</label>

							<button class="button button-form" type="submit">Book your assessment <span>$999</span></button>
							<p class="form-note">No preparation required. Your information is only used to respond to this request.</p>
							<p class="form-message" role="status" aria-live="polite" hidden></p>
						</form>
					</div>
				</section>
			</main>

			<footer>
				<a href="/">Jack Maguire</a>
				<span>AI tools assessment</span>
				<span>New York City</span>
			</footer>
		</div>

		<script>
			const form = document.getElementById('audit-form');

			if (form instanceof HTMLFormElement) {
				form.addEventListener('submit', async (event) => {
					event.preventDefault();
					const submitButton = form.querySelector('button[type="submit"]');
					const message = form.querySelector('.form-message');

					if (submitButton instanceof HTMLButtonElement) {
						submitButton.disabled = true;
						submitButton.textContent = 'Sending your request...';
					}

					if (message instanceof HTMLElement) message.hidden = true;

					try {
						const response = await fetch(form.action, {
							method: 'POST',
							headers: { Accept: 'application/json' },
							body: new FormData(form),
						});
						const result = await response.json();
						if (!result.success) throw new Error(result.message || 'Submission failed');

						form.reset();
						if (message instanceof HTMLElement) {
							message.textContent = 'Request received. I will email you with available times and next steps.';
							message.className = 'form-message success';
							message.hidden = false;
						}
						if (submitButton instanceof HTMLButtonElement) submitButton.hidden = true;

						if (typeof window.fbq === 'function') {
							window.fbq('track', 'Lead', { content_name: 'ai_audit_booking_request', value: 999, currency: 'USD' });
						}
					} catch {
						if (message instanceof HTMLElement) {
							message.textContent = 'That did not send. Please try again, or email maguirebaseball@gmail.com.';
							message.className = 'form-message error';
							message.hidden = false;
						}
						if (submitButton instanceof HTMLButtonElement) {
							submitButton.disabled = false;
							submitButton.innerHTML = 'Book your assessment <span>$999</span>';
						}
					}
				});
			}
		</script>
	</body>
</html>

<style>
	:global(*) {
		box-sizing: border-box;
	}

	:global(html) {
		scroll-behavior: smooth;
		background: #f4f0e7;
	}

	:global(body) {
		margin: 0;
		background: #f4f0e7;
		color: #171812;
	}

	:global(body),
	:global(button),
	:global(input),
	:global(select),
	:global(textarea) {
		font-family: var(--font-ui), Arial, sans-serif;
	}

	.audit-page {
		--ink: #171812;
		--paper: #f4f0e7;
		--paper-light: #fcfaf5;
		--green: #b8ff43;
		--green-dark: #5f7f24;
		--blue: #3156f5;
		--line: rgba(23, 24, 18, 0.19);
		min-height: 100vh;
		overflow: hidden;
		background:
			linear-gradient(rgba(23, 24, 18, 0.035) 1px, transparent 1px),
			linear-gradient(90deg, rgba(23, 24, 18, 0.035) 1px, transparent 1px),
			var(--paper);
		background-size: 36px 36px;
	}

	.audit-page > main {
		width: 100%;
		max-width: none;
		margin: 0;
		padding: 0;
	}

	.topbar,
	.hero,
	.section-pad,
	footer {
		width: min(1180px, calc(100% - 48px));
		margin: 0 auto;
	}

	.topbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 24px 0;
		border-bottom: 1px solid var(--ink);
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		color: var(--ink);
		font-size: 0.82rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-decoration: none;
		text-transform: uppercase;
	}

	.brand-mark {
		display: grid;
		width: 36px;
		height: 36px;
		place-items: center;
		background: var(--ink);
		color: var(--paper-light);
		font-size: 0.7rem;
	}

	.topbar-link {
		color: var(--ink);
		font-size: 0.82rem;
		font-weight: 800;
		text-decoration-thickness: 1px;
		text-underline-offset: 4px;
		text-transform: uppercase;
	}

	.topbar-link span {
		color: var(--green-dark);
		margin-left: 6px;
	}

	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1.35fr) minmax(330px, 0.65fr);
		gap: clamp(48px, 7vw, 100px);
		align-items: center;
		min-height: 690px;
		padding: 78px 0 82px;
	}

	.eyebrow,
	.section-label {
		margin: 0 0 22px;
		font-size: 0.76rem;
		font-weight: 800;
		letter-spacing: 0.13em;
		line-height: 1.4;
		text-transform: uppercase;
	}

	.eyebrow {
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.eyebrow span {
		display: block;
		width: 28px;
		height: 3px;
		background: var(--blue);
	}

	.hero h1,
	.section-intro h2,
	.solution h2,
	.report h2,
	.roi h2,
	.guarantee h2,
	.booking h2 {
		font-family: var(--font-heading), Arial, sans-serif;
		font-weight: 800;
		letter-spacing: -0.052em;
	}

	.hero h1 {
		max-width: 790px;
		margin: 0;
		font-size: clamp(4rem, 7.5vw, 7.7rem);
		line-height: 0.88;
	}

	.hero-note {
		width: fit-content;
		margin: 26px 0 0;
		padding: 7px 11px;
		background: var(--green);
		font-size: clamp(1rem, 2vw, 1.2rem);
		font-weight: 800;
		transform: rotate(-1.2deg);
	}

	.hero-subhead {
		max-width: 670px;
		margin: 28px 0 0;
		font-size: clamp(1.05rem, 1.8vw, 1.3rem);
		line-height: 1.55;
	}

	.hero-actions {
		display: flex;
		align-items: center;
		gap: 24px;
		margin-top: 34px;
	}

	.hero-actions p {
		max-width: 330px;
		margin: 0;
		font-size: 0.78rem;
		line-height: 1.5;
	}

	.button {
		display: inline-flex;
		align-items: center;
		justify-content: space-between;
		gap: 28px;
		min-height: 58px;
		padding: 0 20px;
		border: 1px solid var(--ink);
		font-size: 0.88rem;
		font-weight: 800;
		letter-spacing: 0.01em;
		text-decoration: none;
		text-transform: uppercase;
		transition: transform 160ms ease, box-shadow 160ms ease, background 160ms ease;
	}

	.button:hover,
	.button:focus-visible {
		transform: translate(-3px, -3px);
		box-shadow: 6px 6px 0 var(--ink);
	}

	.button-primary {
		min-width: 300px;
		background: var(--ink);
		color: #fff;
	}

	.button-primary span {
		color: var(--green);
	}

	.audit-card {
		position: relative;
		padding: 22px;
		border: 1px solid var(--ink);
		background: var(--paper-light);
		box-shadow: 14px 14px 0 var(--blue);
	}

	.audit-card::before {
		position: absolute;
		top: -12px;
		right: 22px;
		width: 86px;
		height: 25px;
		background: rgba(184, 255, 67, 0.78);
		content: '';
		transform: rotate(2deg);
	}

	.audit-card-head,
	.audit-card-foot {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.audit-card-head {
		padding-bottom: 18px;
		border-bottom: 1px solid var(--line);
		font-size: 0.67rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.status {
		display: inline-flex;
		align-items: center;
		gap: 6px;
	}

	.status i {
		width: 7px;
		height: 7px;
		background: var(--green-dark);
	}

	.time-number {
		display: flex;
		align-items: flex-end;
		gap: 14px;
		margin: 28px 0 22px;
	}

	.time-number strong {
		font-family: var(--font-heading), Arial, sans-serif;
		font-size: clamp(4.8rem, 8vw, 7rem);
		letter-spacing: -0.08em;
		line-height: 0.72;
	}

	.time-number span {
		font-size: 0.76rem;
		font-weight: 800;
		line-height: 1.35;
		text-transform: uppercase;
	}

	.mini-chart {
		display: flex;
		align-items: flex-end;
		gap: 8px;
		height: 120px;
		padding: 12px 0 0;
		border-top: 1px dashed var(--line);
		border-bottom: 1px solid var(--ink);
	}

	.mini-chart span {
		flex: 1;
		background: var(--green);
		border: 1px solid var(--ink);
		border-bottom: 0;
	}

	.audit-card-foot {
		gap: 20px;
		padding-top: 18px;
	}

	.audit-card-foot div {
		display: flex;
		flex-direction: column;
		gap: 5px;
	}

	.audit-card-foot span {
		color: #696b61;
		font-size: 0.67rem;
		font-weight: 700;
		text-transform: uppercase;
	}

	.audit-card-foot strong {
		font-size: 0.95rem;
	}

	.ticker {
		display: flex;
		justify-content: center;
		border-top: 1px solid var(--ink);
		border-bottom: 1px solid var(--ink);
		background: var(--green);
