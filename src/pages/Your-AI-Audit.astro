---
import BaseHead from '../components/BaseHead.astro';

const title = 'Your AI Audit | Start with a $79 AI Bottleneck Snapshot';
const description = 'Find the work AI should take off your plate. Start with a $79, $199, or $499 AI workflow assessment, each backed by a scope-matched money-back guarantee.';

const checkoutConfig = {
	snapshot: import.meta.env.PUBLIC_AI_SNAPSHOT_CHECKOUT_URL,
	mini: import.meta.env.PUBLIC_AI_MINI_AUDIT_CHECKOUT_URL,
	full: import.meta.env.PUBLIC_AI_FULL_AUDIT_CHECKOUT_URL,
};

const email = 'maguirebaseball@gmail.com';

const tiers = [
	{
		key: 'snapshot',
		level: 'Level 1',
		name: 'AI Bottleneck Snapshot',
		price: 79,
		tag: '30 min/week target',
		fit: 'You know work is leaking time, but you do not know which workflow to fix first.',
		turnaround: '1 business day',
		features: [
			'8-question workflow intake',
			'Your highest-cost bottleneck identified',
			'One practical AI quick win',
			'Tool category, next step, and rough payoff',
		],
		guaranteeTitle: 'One Quick Win Guarantee',
		guarantee: 'One practical change projected to save at least 30 minutes each week, or I automatically refund your $79.',
		credit: 'Your full $79 applies to the Mini Audit if you upgrade within 30 days.',
	},
	{
		key: 'mini',
		level: 'Level 2',
		name: 'Quick-Win Mini Audit',
		price: 199,
		tag: '2 hrs/week target',
		fit: 'You have a few messy workflows and want a prioritized answer without commissioning the full audit.',
		turnaround: '2 business days',
		features: [
			'25-minute workflow call',
			'2 to 3 bottlenecks assessed',
			'1 to 2 recommended tools',
			'Short ROI estimate and action plan',
		],
		guaranteeTitle: 'Two-Hour Opportunity Guarantee',
		guarantee: 'Practical changes projected to save at least two hours each week, or I automatically refund your $199.',
		credit: 'Your full $199 applies to the Full AI Audit if you upgrade within 30 days.',
	},
	{
		key: 'full',
		level: 'Level 3',
		name: 'Full AI Audit',
		price: 499,
		tag: '5 hrs/week target',
		fit: 'You want the complete workflow map, implementation roadmap, and financial case.',
		turnaround: 'Delivered after discovery',
		features: [
			'45-minute discovery call',
			'3 to 7 recommended tools',
			'Full effort vs. impact and ROI report',
			'4-day rollout plan and 30-minute review',
		],
		guaranteeTitle: 'Five-Hour Opportunity Guarantee',
		guarantee: 'Practical changes projected to save at least five hours each week, or I automatically refund your $499.',
		credit: 'Any qualifying prior-tier credit is deducted when you upgrade within 30 days.',
	},
].map((tier) => {
	const configuredUrl = checkoutConfig[tier.key as keyof typeof checkoutConfig];
	const fallbackUrl = `mailto:${email}?subject=${encodeURIComponent(`Send me the $${tier.price} ${tier.name} checkout`)}`;
	return {
		...tier,
		checkoutUrl: configuredUrl || fallbackUrl,
		checkoutReady: Boolean(configuredUrl),
	};
});

const painPoints = [
	{
		number: '01',
		title: 'Your inbox eats the morning.',
		copy: 'Messages pile up faster than you can sort, answer, and turn them into next steps.',
	},
	{
		number: '02',
		title: 'Lead follow-up moves too slowly.',
		copy: 'Good prospects wait while you copy details, write replies, and update the same information twice.',
	},
	{
		number: '03',
		title: 'Meetings end without action.',
		copy: 'You have transcripts and notes, but decisions, owners, and deadlines still need to be pulled out by hand.',
	},
	{
		number: '04',
		title: 'Reporting steals the weekend.',
		copy: 'The data exists. You still spend hours cleaning it, organizing it, and rebuilding the same update.',
	},
];

const process = [
	{
		number: '1',
		time: 'Pay online',
		title: 'Choose your depth',
		copy: 'Start at $79, $199, or $499. Payment happens before the work begins, so there is no proposal loop or surprise invoice.',
	},
	{
		number: '2',
		time: 'Low lift',
		title: 'Show me the friction',
		copy: 'Complete the short intake. Mini and Full Audit buyers also get a focused call. You do not need to prepare a deck or learn any AI vocabulary.',
	},
	{
		number: '3',
		time: 'Actionable',
		title: 'Get the next move',
		copy: 'Receive the recommendation, expected payoff, and implementation path included in your tier. Upgrade credit keeps starting small from costing more.',
	},
];

const reportSections = [
	{
		number: '01',
		title: 'Executive summary',
		copy: 'A one-page snapshot of your main bottlenecks and the total hours you can reclaim.',
	},
	{
		number: '02',
		title: 'Effort vs. impact matrix',
		copy: 'A clear view of why these tools beat complex, high-effort enterprise software for your current needs.',
	},
	{
		number: '03',
		title: 'Recommended solutions',
		copy: 'Each tool, the pain point it solves, monthly cost, estimated setup time, and expected weekly savings.',
	},
	{
		number: '04',
		title: '4-day quick start plan',
		copy: 'A day-by-day guide that lets you deploy the full stack in four 10-minute sessions.',
	},
	{
		number: '05',
		title: 'Financial impact analysis',
		copy: 'The net monthly return based on time saved, your effective hourly rate, and the actual tool costs.',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} ogImage="/your-ai-audit-og-v2.png" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
		<script type="application/ld+json" set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'Service',
			name: 'Your AI Audit',
			description,
			provider: {
				'@type': 'Person',
				name: 'Jack Maguire',
				url: 'https://jackmaguire.org/',
			},
			areaServed: 'US',
			offers: tiers.map((tier) => ({
				'@type': 'Offer',
				name: tier.name,
				price: String(tier.price),
				priceCurrency: 'USD',
				url: `https://jackmaguire.org/Your-AI-Audit/#${tier.key}`,
			})),
		})} />
	</head>
	<body>
		<div class="audit-page">
			<header class="topbar">
				<a class="brand" href="/" aria-label="Jack Maguire home">
					<span class="brand-mark" aria-hidden="true">JM</span>
					<span>Your AI Audit</span>
				</a>
				<a class="topbar-link" href="#offers">Compare options <span>From $79</span></a>
			</header>

			<main>
				<section class="hero" aria-labelledby="hero-title">
					<div class="hero-copy">
						<p class="eyebrow"><span></span> Paid AI workflow diagnosis for owners and operators</p>
						<h1 id="hero-title">Find the work AI should take off your plate.</h1>
						<p class="hero-note">Start at $79. Upgrade only if the value is obvious.</p>
						<p class="hero-subhead">Choose the depth you need. I will diagnose the bottleneck, filter out the AI noise, and give you a practical next move using off-the-shelf tools.</p>
						<div class="hero-actions">
							<a class="button button-primary" href="#snapshot">Start with the snapshot <span>$79</span></a>
							<p><strong>Paid before service. Guaranteed by scope.</strong> Start with one quick win at $79, then apply every dollar if you upgrade within 30 days.</p>
						</div>
					</div>

					<aside class="audit-card" aria-label="Three ways to start">
						<div class="audit-card-head">
							<span>Choose your depth</span>
							<span class="status"><i></i> Paid assessments</span>
						</div>
						<div class="hero-tier-list">
							<a href="#snapshot"><span>01</span><strong>Snapshot</strong><b>$79</b></a>
							<a href="#mini"><span>02</span><strong>Mini Audit</strong><b>$199</b></a>
							<a href="#full"><span>03</span><strong>Full Audit</strong><b>$499</b></a>
						</div>
						<div class="audit-card-foot">
							<div><span>Upgrade window</span><strong>30 days</strong></div>
							<div><span>Credit applied</span><strong>100%</strong></div>
						</div>
					</aside>
				</section>

				<section class="ticker" aria-label="Assessment highlights">
					<span>Start at $79</span>
					<span>Pay before service</span>
					<span>Zero coding</span>
					<span>100% upgrade credit</span>
					<span>Every tier guaranteed</span>
				</section>

				<section id="offers" class="offers section-pad" aria-labelledby="offers-title">
					<div class="section-intro">
						<p class="section-label">Choose your starting point</p>
						<h2 id="offers-title">Buy the amount of certainty you need.</h2>
						<p>Start with one bottleneck. Go deeper only when the first answer proves useful. Upgrade credits mean you never pay twice for the same diagnosis.</p>
					</div>
					<div class="tier-grid">
						{tiers.map((tier, index) => (
							<article id={tier.key} class:list={['tier-card', { featured: index === 0, full: tier.key === 'full' }]}>
								<div class="tier-topline"><span>{tier.level}</span><strong>{tier.tag}</strong></div>
								<h3>{tier.name}</h3>
								<p class="tier-price"><span>$</span>{tier.price}</p>
								<p class="tier-fit">{tier.fit}</p>
								<ul>
									{tier.features.map((feature) => <li>{feature}</li>)}
								</ul>
								<div class="tier-guarantee">
									<span>{tier.guaranteeTitle}</span>
									<p>{tier.guarantee}</p>
								</div>
								<div class="tier-turnaround"><span>Turnaround</span><strong>{tier.turnaround}</strong></div>
								<a
									class="button tier-button"
									href={tier.checkoutUrl}
									data-checkout-tier={tier.key}
									data-checkout-value={tier.price}
									data-checkout-ready={String(tier.checkoutReady)}
								>
									{tier.checkoutReady ? `Pay $${tier.price} and start` : `Request $${tier.price} checkout`}
									<span aria-hidden="true">→</span>
								</a>
								<p class="tier-credit">{tier.credit}</p>
							</article>
						))}
					</div>
					<p class="payment-note"><strong>How payment works:</strong> each service is paid in full before the intake or call. If my assessment does not reach that tier's stated savings threshold, I automatically refund the full fee.</p>
				</section>

				<section class="problem section-pad" aria-labelledby="problem-title">
					<div class="section-intro">
						<p class="section-label">The problem</p>
						<h2 id="problem-title">You need leverage. You do not have time to become an AI expert.</h2>
						<p>You are running a successful business, but the day-to-day operations are running you. The problem is rarely a lack of software. It is knowing which tool will remove a real bottleneck without creating another system to manage.</p>
					</div>
					<div class="pain-grid">
						{painPoints.map((point) => (
							<article class="pain-card">
								<span>{point.number}</span>
								<h3>{point.title}</h3>
								<p>{point.copy}</p>
							</article>
						))}
					</div>
					<p class="problem-close">You do not need a custom-coded enterprise transformation. You need a few tools that fix the work slowing you down today.</p>
				</section>

				<section class="solution section-pad" aria-labelledby="solution-title">
					<div class="solution-copy">
						<p class="section-label">The solution</p>
						<h2 id="solution-title">High impact. Low effort. Nothing else makes the cut.</h2>
						<p>I act as your AI concierge. I audit your workflows and focus on the top-left quadrant of the effort vs. impact matrix: the quick wins.</p>
						<p>These are off-the-shelf AI and SaaS tools that require no technical skill to maintain, often total $40 to $60 per month, and can start returning time within days.</p>
						<ul class="check-list">
							<li><span aria-hidden="true">✓</span> Fits your current team and workflow</li>
							<li><span aria-hidden="true">✓</span> Setup measured in minutes, not months</li>
							<li><span aria-hidden="true">✓</span> Clear owner, cost, and weekly payoff</li>
						</ul>
					</div>

					<div class="matrix-wrap">
						<div class="matrix-title"><span>Effort vs. impact</span><strong>Selection zone</strong></div>
						<div class="matrix">
							<div class="quadrant quick"><span>Quick wins</span><small>High impact<br />Low effort</small><i class="pulse one"></i><i class="pulse two"></i><i class="pulse three"></i></div>
							<div class="quadrant project"><span>Major projects</span><small>High impact<br />High effort</small></div>
							<div class="quadrant filler"><span>Fill-ins</span><small>Low impact<br />Low effort</small></div>
							<div class="quadrant avoid"><span>Avoid</span><small>Low impact<br />High effort</small></div>
						</div>
						<div class="axis axis-y">Impact <span>Low</span><b>High</b></div>
						<div class="axis axis-x">Effort <span>Low</span><b>High</b></div>
					</div>
				</section>

				<section class="process section-pad" aria-labelledby="process-title">
					<div class="section-intro compact">
						<p class="section-label">How it works</p>
						<h2 id="process-title">A paid answer, not another sales funnel.</h2>
					</div>
					<div class="process-grid">
						{process.map((step) => (
							<article class="process-step">
								<div class="step-meta"><strong>{step.number}</strong><span>{step.time}</span></div>
								<h3>{step.title}</h3>
								<p>{step.copy}</p>
							</article>
						))}
					</div>
				</section>

				<section class="report section-pad" aria-labelledby="report-title">
					<div class="report-head">
						<div>
							<p class="section-label">Inside the Full AI Audit</p>
							<h2 id="report-title">The complete roadmap, built for Monday morning.</h2>
						</div>
						<p>The $499 Full AI Audit is the complete execution plan. The $79 and $199 offers deliberately stop sooner, so you can buy one useful answer before committing to the full scope.</p>
					</div>
					<div class="report-list">
						{reportSections.map((item) => (
							<article class="report-row">
								<span>{item.number}</span>
								<h3>{item.title}</h3>
								<p>{item.copy}</p>
							</article>
						))}
					</div>
				</section>

				<section class="roi section-pad" aria-labelledby="roi-title">
					<div class="roi-copy">
						<p class="section-label light">The return</p>
						<h2 id="roi-title">The value has to survive the math.</h2>
						<p>Every recommendation shows its work: current weekly task time minus expected weekly task time after implementation equals projected weekly savings. I subtract new oversight time and do not count the same saved minutes twice.</p>
					</div>
					<div class="roi-stats">
						<div><strong>5+</strong><span>full audit weekly<br />savings threshold</span></div>
						<div><strong>$40-$60</strong><span>common total<br />monthly tool cost</span></div>
						<div><strong>4 days</strong><span>to complete the<br />quick start plan</span></div>
					</div>
				</section>

				<section class="guarantee section-pad" aria-labelledby="guarantee-title">
					<div class="guarantee-badge" aria-hidden="true"><span>3</span><small>guarantees</small></div>
					<div class="guarantee-copy">
						<p class="section-label">The guarantees</p>
						<h2 id="guarantee-title">Every tier has to earn its price.</h2>
						<p>I guarantee the savings opportunity identified by the assessment, not results that depend on whether you implement the recommendation. If my analysis does not reach the threshold for your tier, I automatically refund the full fee.</p>
						<div class="guarantee-ladder">
							{tiers.map((tier) => (
								<article>
									<span>${tier.price}</span>
									<h3>{tier.guaranteeTitle}</h3>
									<p>{tier.guarantee}</p>
								</article>
							))}
						</div>
						<div class="outcomes">
							<p><span>What counts</span>A recurring task you currently perform, with baseline time, frequency, tool cost, new oversight time, and projected time after implementation.</p>
							<p><span>What does not count</span>Speculative revenue gains, one-time tasks, overlapping savings, or time that simply moves from you to someone else.</p>
						</div>
					</div>
				</section>

				<section id="start" class="booking section-pad" aria-labelledby="book-title">
					<div class="booking-copy">
						<p class="section-label light">Ready when you are</p>
						<h2 id="book-title">Start small. Keep the upside.</h2>
						<p>The $79 Snapshot is the cleanest first step for most owners. If it exposes a bigger opportunity, every dollar carries forward for 30 days.</p>
						<ul>
							<li>Money collected before service</li>
							<li>No unpaid custom diagnosis</li>
							<li>100% credit on the next tier</li>
							<li>No coding or AI expertise required</li>
						</ul>
					</div>

					<div class="checkout-shell">
						<p class="checkout-kicker">Recommended first purchase</p>
						<div class="checkout-price"><span>$</span><strong>79</strong></div>
						<h3>AI Bottleneck Snapshot</h3>
						<p>One day. One bottleneck. One practical AI quick win projected to save at least 30 minutes a week, or I refund it.</p>
						<a
							class="button button-form"
							href={tiers[0].checkoutUrl}
							data-checkout-tier="snapshot"
							data-checkout-value="79"
							data-checkout-ready={String(tiers[0].checkoutReady)}
						>
							{tiers[0].checkoutReady ? 'Pay $79 and start' : 'Request $79 checkout'} <span>→</span>
						</a>
						<p class="checkout-note">Secure online payment is required before delivery. Need more depth? <a href="#offers">Compare all three options.</a></p>
					</div>
				</section>
			</main>

			<footer>
				<a href="/">Jack Maguire</a>
				<span>AI tools assessment</span>
				<span>New York City</span>
			</footer>
		</div>

		<script>
			document.querySelectorAll('[data-checkout-tier]').forEach((link) => {
				link.addEventListener('click', () => {
					if (!(link instanceof HTMLAnchorElement) || link.dataset.checkoutReady !== 'true') return;
					const value = Number(link.dataset.checkoutValue || 0);
					if (typeof window.fbq === 'function') {
						window.fbq('track', 'InitiateCheckout', {
							content_name: `ai_audit_${link.dataset.checkoutTier}`,
							content_type: 'product',
							value,
							currency: 'USD',
						});
					}
				});
			});
		</script>
	</body>
</html>

<style>
	:global(*) {
		box-sizing: border-box;
	}

	:global(html) {
		scroll-behavior: smooth;
		background: #f4f0e7;
	}

	:global(body) {
		margin: 0;
		background: #f4f0e7;
		color: #171812;
	}

	:global(body),
	:global(button),
	:global(input),
	:global(select),
	:global(textarea) {
		font-family: var(--font-ui), Arial, sans-serif;
	}

	.audit-page {
		--ink: #171812;
		--paper: #f4f0e7;
		--paper-light: #fcfaf5;
		--green: #b8ff43;
		--green-dark: #5f7f24;
		--blue: #3156f5;
		--line: rgba(23, 24, 18, 0.19);
		min-height: 100vh;
		overflow: hidden;
		background:
			linear-gradient(rgba(23, 24, 18, 0.035) 1px, transparent 1px),
			linear-gradient(90deg, rgba(23, 24, 18, 0.035) 1px, transparent 1px),
			var(--paper);
		background-size: 36px 36px;
	}

	.audit-page > main {
		width: 100%;
		max-width: none;
		margin: 0;
		padding: 0;
	}

	.topbar,
	.hero,
	.section-pad,
	footer {
		width: min(1180px, calc(100% - 48px));
		margin: 0 auto;
	}

	.topbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 24px 0;
		border-bottom: 1px solid var(--ink);
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		color: var(--ink);
		font-size: 0.82rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-decoration: none;
		text-transform: uppercase;
	}

	.brand-mark {
		display: grid;
		width: 36px;
		height: 36px;
		place-items: center;
		background: var(--ink);
		color: var(--paper-light);
		font-size: 0.7rem;
	}

	.topbar-link {
		color: var(--ink);
		font-size: 0.82rem;
		font-weight: 800;
		text-decoration-thickness: 1px;
		text-underline-offset: 4px;
		text-transform: uppercase;
	}

	.topbar-link span {
		color: var(--green-dark);
		margin-left: 6px;
	}

	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1.35fr) minmax(330px, 0.65fr);
		gap: clamp(48px, 7vw, 100px);
		align-items: center;
		min-height: 690px;
		padding: 78px 0 82px;
	}

	.eyebrow,
	.section-label {
		margin: 0 0 22px;
		font-size: 0.76rem;
		font-weight: 800;
		letter-spacing: 0.13em;
		line-height: 1.4;
		text-transform: uppercase;
	}

	.eyebrow {
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.eyebrow span {
		display: block;
		width: 28px;
		height: 3px;
		background: var(--blue);
	}

	.hero h1,
	.section-intro h2,
	.solution h2,
	.report h2,
	.roi h2,
	.guarantee h2,
	.booking h2 {
		font-family: var(--font-heading), Arial, sans-serif;
		font-weight: 800;
		letter-spacing: -0.052em;
	}

	.hero h1 {
		max-width: 790px;
		margin: 0;
		font-size: clamp(4rem, 7.5vw, 7.7rem);
		line-height: 0.88;
	}

	.hero-note {
		width: fit-content;
		margin: 26px 0 0;
		padding: 7px 11px;
		background: var(--green);
		font-size: clamp(1rem, 2vw, 1.2rem);
		font-weight: 800;
		transform: rotate(-1.2deg);
	}

	.hero-subhead {
		max-width: 670px;
		margin: 28px 0 0;
		font-size: clamp(1.05rem, 1.8vw, 1.3rem);
		line-height: 1.55;
	}

	.hero-actions {
		display: flex;
		align-items: center;
		gap: 24px;
		margin-top: 34px;
	}

	.hero-actions p {
		max-width: 330px;
		margin: 0;
		font-size: 0.78rem;
		line-height: 1.5;
	}

	.button {
		display: inline-flex;
		align-items: center;
		justify-content: space-between;
		gap: 28px;
		min-height: 58px;
		padding: 0 20px;
		border: 1px solid var(--ink);
		font-size: 0.88rem;
		font-weight: 800;
		letter-spacing: 0.01em;
		text-decoration: none;
		text-transform: uppercase;
		transition: transform 160ms ease, box-shadow 160ms ease, background 160ms ease;
	}

	.button:hover,
	.button:focus-visible {
		transform: translate(-3px, -3px);
		box-shadow: 6px 6px 0 var(--ink);
	}

	.button-primary {
		min-width: 300px;
		background: var(--ink);
		color: #fff;
	}

	.button-primary span {
		color: var(--green);
	}

	.audit-card {
