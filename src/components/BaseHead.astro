---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import { SITE_TITLE } from '../consts';
import { PERSON_ID } from '../consts';
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';

interface Props {
	title: string;
	description: string;
	ogImage?: string;
	articlePublished?: string;
	articleModified?: string;
}

let cleanPathname = Astro.url.pathname;
if (!cleanPathname.endsWith('/') && !cleanPathname.split('/').pop().includes('.')) {
	cleanPathname += '/';
}
const canonicalURL = new URL(cleanPathname, Astro.site);

const { title, description, ogImage = '/og-default.png', articlePublished, articleModified } = Astro.props;
const pageTitle = (Astro.url.pathname.startsWith('/blog/') || articlePublished) && !title.endsWith(' | Jack Maguire')
	? `${title} | Jack Maguire`
	: title;
const ogImageUrl = new URL(ogImage, Astro.site);
const publishedIso = articlePublished ? new Date(articlePublished).toISOString() : undefined;
const modifiedIso = articleModified ? new Date(articleModified).toISOString() : publishedIso;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<ClientRouter />

<Font cssVariable="--font-heading" preload />
<Font cssVariable="--font-ui" preload />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Caveat:wght@500&display=swap" rel="stylesheet">
<title>{pageTitle}</title>
<meta name="title" content={pageTitle} />
<meta name="description" content={description} />
{publishedIso && (
	<script type="application/ld+json" set:html={JSON.stringify({
		'@context': 'https://schema.org',
		'@type': 'BlogPosting',
		headline: title,
		description,
		url: canonicalURL.toString(),
		mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL.toString() },
		author: { '@id': PERSON_ID },
		datePublished: publishedIso,
		dateModified: modifiedIso,
	})} />
)}

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={pageTitle} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={ogImageUrl} />

<!-- Google Analytics -->
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-1697T7D92W"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  window.gtag = window.gtag || function(){window.dataLayer.push(arguments);};
  gtag('js', new Date());
  gtag('config', 'G-1697T7D92W');
</script>

<!-- Meta Pixel -->
<script>
	!function(f,b,e,v,n,t,s)
	{if(f.fbq)return;n=f.fbq=function(){n.callMethod?
	n.callMethod.apply(n,arguments):n.queue.push(arguments)};
	if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
	n.queue=[];t=b.createElement(e);t.async=!0;
	t.src=v;s=b.getElementsByTagName(e)[0];
	s.parentNode.insertBefore(t,s)}(window, document,'script',
	'https://connect.facebook.net/en_US/fbevents.js');
	fbq('init', '1578848813945108');
	fbq('track', 'PageView');
</script>

<script>
	const engagementStorageKey = 'jm_engagement_signal_v2';
	const engagementThresholdMs = 2 * 60 * 1000;
	const metaFbcStorageKey = 'jm_meta_fbc';

	function readCookie(name) {
		return document.cookie
			.split('; ')
			.find((cookie) => cookie.startsWith(`${name}=`))
			?.split('=')
			.slice(1)
			.join('=');
	}

	function getFbc() {
		const cookieFbc = readCookie('_fbc');
		if (cookieFbc) return cookieFbc;

		const storedFbc = sessionStorage.getItem(metaFbcStorageKey);
		if (storedFbc) return storedFbc;

		const fbclid = new URLSearchParams(window.location.search).get('fbclid');
		if (!fbclid) return undefined;

		const fbc = `fb.1.${Date.now()}.${fbclid}`;
		sessionStorage.setItem(metaFbcStorageKey, fbc);
		return fbc;
	}

	function getEngagementState() {
		try {
			return JSON.parse(sessionStorage.getItem(engagementStorageKey) || '{"paths":[],"activeMs":0,"sent":false}');
		} catch {
			return { paths: [], activeMs: 0, sent: false };
		}
	}

	function saveEngagementState(state) {
		sessionStorage.setItem(engagementStorageKey, JSON.stringify(state));
	}

	function recordCurrentPage() {
		const state = getEngagementState();
		const path = `${window.location.pathname}${window.location.search}`;
		state.paths = [...new Set([...state.paths, path])];
		saveEngagementState(state);
	}

	if (!window.__jmEngagementTrackingInitialized) {
		window.__jmEngagementTrackingInitialized = true;
		getFbc();
		recordCurrentPage();

		let activeSince = document.visibilityState === 'visible' ? Date.now() : null;

		const addActiveTime = () => {
			if (activeSince === null) return;
			const latestState = getEngagementState();
			latestState.activeMs += Date.now() - activeSince;
			activeSince = Date.now();
			saveEngagementState(latestState);
		};

		const sendEngagementIfQualified = () => {
			addActiveTime();
			const latestState = getEngagementState();
			if (latestState.sent || latestState.paths.length < 3 || latestState.activeMs < engagementThresholdMs) return;

			latestState.sent = true;
			saveEngagementState(latestState);
			const eventId = crypto.randomUUID();
			fbq('trackCustom', 'EngagedVisitor', { content_name: 'engaged_visitor_3_pages_2_minutes' }, { eventID: eventId });
			fetch('/api/capi-lead/', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({
					eventId,
					eventName: 'engaged_visitor_3_pages_2_minutes',
					eventSourceUrl: window.location.href,
					fbp: readCookie('_fbp'),
					fbc: getFbc(),
				}),
				keepalive: true,
			}).catch(() => {});
		};

		const onVisibilityChange = () => {
			if (document.visibilityState === 'visible') {
				activeSince = Date.now();
			} else {
				addActiveTime();
				activeSince = null;
			}
			sendEngagementIfQualified();
		};

		document.addEventListener('visibilitychange', onVisibilityChange);
		document.addEventListener('astro:page-load', () => {
			recordCurrentPage();
			sendEngagementIfQualified();
		});
		window.addEventListener('pagehide', () => {
			addActiveTime();
			sendEngagementIfQualified();
		});
		window.setInterval(sendEngagementIfQualified, 10_000);
	}
</script>
